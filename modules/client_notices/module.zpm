<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><: Notices appear at the top of your clients' panel: planned maintenance, an outage, something new, or a personal message to one client. :></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/client_notices/assets/notices.css">

    <div class="cn" id="cn">
        <% if IsList %>
        <div class="cn-top">
            <div class="cn-tiles"><@ Tiles @></div>
            <a class="btn btn-primary cn-new" href="./?module=client_notices&amp;show=New"><svg class="cn-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><: New notice :></a>
        </div>
        <div class="cn-list"><@ NoticeList @></div>
        <form id="cn-remove" action="./?module=client_notices&amp;action=Remove" method="post"><@ CSFR_Tag @></form>
        <% endif %>

        <% if IsEdit %>
        <form class="cn-form" id="cn-form" action="./?module=client_notices&amp;show=New&amp;action=Save" method="post">
            <input type="hidden" name="inId" value="<@ FormId @>">
            <div class="cn-main">
                <a href="./?module=client_notices" class="btn btn-default btn-sm cn-back"><svg class="cn-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg><: All notices :></a>
                <h3 class="cn-h"><@ FormTitle @></h3>

                <div class="cn-card">
                    <h4><: What kind :></h4>
                    <div class="cn-types"><@ TypeChoices @></div>
                </div>

                <div class="cn-card">
                    <h4><: Message :></h4>
                    <label class="cn-label" for="inTitle"><: Title :> <small><: optional: without one, the kind's name shows :></small></label>
                    <input class="form-control" type="text" name="inTitle" id="inTitle" maxlength="<@ MaxTitle @>" value="<@ FormTitleValue @>">
                    <label class="cn-label" for="inBody"><: Text :></label>
                    <div class="cn-tools" role="toolbar" aria-label="<: Formatting :>">
                        <button type="button" class="btn btn-default btn-sm" data-do="bold" data-sample="<: text :>" title="<: Bold :>" aria-label="<: Bold :>"><b>B</b></button>
                        <button type="button" class="btn btn-default btn-sm" data-do="link" title="<: Link :>" aria-label="<: Link :>"><svg class="cn-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg></button>
                        <button type="button" class="btn btn-default btn-sm" data-do="list" title="<: List :>" aria-label="<: List :>"><svg class="cn-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 6h.01M4 12h.01M4 18h.01"/></svg></button>
                        <span class="cn-tools-hint"><@ FormatHint @></span>
                    </div>
                    <div class="cn-linkrow" id="cn-linkrow" hidden>
                        <input class="form-control input-sm" type="url" id="cn-linkurl" placeholder="https://" aria-label="<: Web address :>">
                        <button type="button" class="btn btn-primary btn-sm" id="cn-linkadd"><: Add link :></button>
                        <button type="button" class="btn btn-default btn-sm" id="cn-linkno"><: Cancel :></button>
                    </div>
                    <textarea class="form-control" name="inBody" id="inBody" rows="7" maxlength="<@ MaxBody @>" required><@ FormBody @></textarea>
                    <div class="cn-under"><span></span><span class="cn-count" id="cn-count" data-max="<@ MaxBody @>"></span></div>
                </div>

                <div class="cn-card">
                    <h4><: Who sees it :></h4>
                    <@ AudienceChoices @>
                </div>

                <div class="cn-card">
                    <h4><: When :></h4>
                    <div class="cn-when">
                        <label><span><: Show from :></span><input class="form-control" type="datetime-local" name="inStart" value="<@ FormStart @>"><small><: empty: straight away :></small></label>
                        <label><span><: Until :></span><input class="form-control" type="datetime-local" name="inEnd" value="<@ FormEnd @>"><small><: empty: until you remove it :></small></label>
                    </div>
                    <p class="cn-sub"><: Server time: :> <@ ServerTime @></p>
                    <div class="cn-switchrow"><div><label for="inClosable"><: Clients can close it :></label><small><: Off: it stays at the top until it ends or you remove it. Use it for what clients must not miss. :></small></div>
                        <label class="cn-switch"><input type="checkbox" name="inClosable" id="inClosable" value="1"<@ FormClosable @>><span class="cn-toggle"></span></label></div>
                </div>

                <div class="cn-foot">
                    <button class="btn btn-primary" type="submit"><: Save notice :></button>
                    <a class="btn btn-default" href="./?module=client_notices"><: Cancel :></a>
                </div>
            </div>

            <div class="cn-aside">
                <div class="cn-card cn-sticky">
                    <h4><: What they see :></h4>
                    <div class="cn-preview" id="cn-preview"<@ PreviewTexts @>><@ FormPreview @></div>
                    <p class="cn-sub"><: It shows at the top of every page of their panel, above the modules. A notice they closed comes back when you change it. :></p>
                </div>
            </div>
            <@ CSFR_Tag @>
        </form>
        <% endif %>
    </div>
</div>
<script src="modules/client_notices/assets/notices.js"></script>
