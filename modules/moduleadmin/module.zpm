<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/moduleadmin/assets/moduleadmin.css">

    <div class="mo" id="mo">
    <% if IsShowModuleInfo %>
        <@ ModuleInfoCard @>
    <% else %>
        <div class="mo-stats"><@ Summary @></div>

        <div class="mo-card">
            <h4><: Administration :></h4>
            <@ AdminModules @>
        </div>

        <div class="mo-card">
            <h4><: Configure modules :></h4>
            <p class="mo-sub"><: Switch modules on or off, choose the menu each one is in, and which groups may use it. A module that is off is hidden for everyone. :></p>
            <@ ConfigModules @>
        </div>

        <div class="mo-card">
            <h4><: Install a module :></h4>
            <form class="mo-upload" action="./?module=moduleadmin&amp;action=InstallModule" method="post" enctype="multipart/form-data">
                <label class="mo-drop"><svg class="mo-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 15v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-4"/><path d="m16 8-4-4-4 4"/><path d="M12 4v11"/></svg>
                    <span><b><: Choose a Sentora package (.zpp) :></b><small><: The package is checked, then the daemon installs it within 5 minutes. Modules from a repository can also be installed with Repo Browser. :></small></span>
                    <input type="file" name="modulefile" id="modulefile" accept=".zpp" required></label>
                <@ CSFR_Tag @>
                <button class="btn btn-primary" type="submit" name="submit"><: Install :></button>
            </form>
        </div>
    <% endif %>
    </div>
    <script src="modules/moduleadmin/assets/moduleadmin.js"></script>
</div>
