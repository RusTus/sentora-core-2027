<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <div class="zgrid_wrapper">
        <@ Result @>
        <h2><: Configure Widgets :></h2>
        <p class="text-muted"><: Which widgets accounts can put on their dashboard, by group; which are on a new dashboard (Default), and in what order. :></p>
        <@ WidgetTable @>
        <h2 style="margin-top: 26px;"><: Upload a widget :></h2>
        <@ UploadForm @>
    </div>
</div>
