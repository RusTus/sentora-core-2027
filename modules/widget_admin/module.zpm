<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/dashboard/assets/dashboard.css">
    <link rel="stylesheet" href="modules/backupmgr/assets/backup.css">
    <link rel="stylesheet" href="modules/widget_admin/assets/widget_admin.css">
    <div class="wa bk" id="wa">
        <div class="bk-panel">
            <div class="bk-panel-head"><div><h4><: Dashboard widgets :></h4>
                <p><: Which widgets accounts can put on their dashboard, by group; which are on a new dashboard (Default), and in what order. :></p></div></div>
            <@ WidgetTable @>
        </div>
        <div class="bk-panel">
            <div class="bk-panel-head"><div><h4><: Upload a widget :></h4>
                <p><: Add your own widget to the dashboards. The daemon installs it within 5 minutes. :></p></div></div>
            <@ UploadForm @>
        </div>
    </div>
    <script>
    (function () {
        'use strict';
        var root = document.getElementById('wa');
        if (!root) { return; }
        Array.prototype.forEach.call(document.querySelectorAll('form[data-confirm]'), function (f) {
            f.addEventListener('submit', function (e) { if (!window.confirm(f.getAttribute('data-confirm'))) { e.preventDefault(); } });
        });
        // a widget switched off is shown faded until saved
        Array.prototype.forEach.call(root.querySelectorAll('.wa-switch input[type=checkbox]'), function (c) {
            c.addEventListener('change', function () { c.closest('tr').classList.toggle('wa-off', !c.checked); });
        });
        // the chosen file's name in the upload box
        var file = root.querySelector('.wa-drop input[type=file]');
        if (file) {
            file.addEventListener('change', function () {
                var b = root.querySelector('.wa-drop b');
                if (file.files.length) { b.textContent = file.files[0].name; }
            });
        }
    })();
    </script>
</div>
