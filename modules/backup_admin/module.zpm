<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">

        <div class="zmodule_title">
            <@ ModuleName @>
        </div>

        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>

    </div>

    <@ Result @>

    <div class="zgrid_wrapper">
        <h2><: Configure your Backup Settings :></h2>
        <form action="./?module=backup_admin&action=UpdateConfig" method="post">
            <table class="table table-striped">
                <% loop Config %>
                <tr valign="top">
                    <th nowrap="nowrap"><& cleanname &></th>
                    <td><& fieldhtml &></td>
                    <td><& description &></td>
                </tr>
                <% endloop %>
                <tr>
                    <th colspan="3">
                        <button class="button-loader add-row btn btn-primary" type="submit" id="button" name="inSaveSystem"><: Save Changes :></button>
                        <button class="add-row btn btn-default" type="button" onclick="window.location.href='./?module=moduleadmin';return false;"><: Cancel :></button>
                    </th>
                </tr>
            </table>
            <@ CSFR_Tag @>
        </form>
        <h2><: Off-server backup :></h2>
        <p class="text-muted"><: Every night, copies the account backups, a dump of all databases, the configuration and the mailboxes to another machine. Each night is kept as a dated snapshot in which unchanged files take no extra space. :></p>
        <@ OffsiteForm @>
        <@ OffsiteStatus @>
        <h2 id="restore" style="margin-top: 26px;"><: Restore :></h2>
        <p class="text-muted"><: Restore one account or the whole panel from the full backup on the backup machine. :></p>
        <style>.bk-job{color:var(--sn-info, #31708f)}.bk-spin{display:inline-block;width:14px;height:14px;vertical-align:-2px;border:2px solid var(--sn-info-line, #bcdcec);border-top-color:var(--sn-info, #31708f);border-radius:50%;animation:bk-spin .9s linear infinite}@keyframes bk-spin{to{transform:rotate(360deg)}}.bk-restore{border:1px solid var(--sn-line, #ddd);border-radius:6px;padding:4px 16px 12px;margin-top:14px;background:var(--sn-soft, #fafafa)}.bk-danger{border-color:var(--sn-bad-line, #ebccd1);background:var(--sn-bad-soft, #fdf7f7)}</style>
        <@ Restore @>
    </div>

</div>