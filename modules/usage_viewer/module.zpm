<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <link rel="stylesheet" href="modules/usage_viewer/assets/usage.css">
    <div class="uv" id="uv">
        <div class="uv-head"><: Your package :> <b><@ PackageName @></b></div>
        <div class="uv-storage"><@ Storage @></div>
        <div class="uv-grid"><@ Resources @></div>
        <p class="uv-note"><: Disk space and bandwidth are counted by the server every few minutes, so a change can take a little while to show. :></p>
    </div>
</div>
