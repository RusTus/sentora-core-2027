<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><: Your client accounts: make new ones, change their package or details, switch them off, or delete them. :></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/manage_clients/assets/clients.css">

    <div class="mc" id="mc">
        <% if IsList %>
        <div class="mc-tiles"><@ Tiles @></div>
        <% if NoPackage %>
        <div class="mc-box mc-empty"><b><: Make a package first :></b><span><: A client gets its limits (disk space, domains, mailboxes and so on) from a package. :></span>
            <% if PackagesOn %><a class="btn btn-primary" href="./?module=packages"><: Package Manager :></a><% endif %></div>
        <% endif %>
        <div class="mc-box">
            <div class="mc-head">
                <h4><: Clients :></h4>
                <% if HasClients %>
                <div class="mc-filters" role="group" aria-label="<: Show :>">
                    <button type="button" class="mc-filter active" data-f="all"><: All :></button>
                    <button type="button" class="mc-filter" data-f="on"><: Active :></button>
                    <% if HasOff %><button type="button" class="mc-filter" data-f="off"><: Switched off :></button><% endif %>
                </div>
                <label class="mc-find"><svg class="mc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    <input type="search" class="form-control" id="mc-find" placeholder="<: Search name, email or package :>" aria-label="<: Search clients :>"></label>
                <% endif %>
                <% if HasPackage %><a class="btn btn-primary mc-new" href="./?module=manage_clients&amp;show=New"><svg class="mc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><: New client :></a><% endif %>
            </div>
            <% if HasClients %>
            <div class="mc-rows" id="mc-rows"><@ ClientRows @></div>
            <p class="mc-nomatch" id="mc-nomatch" hidden><: No client matches. :></p>
            <% endif %>
            <% if NoClients %>
            <div class="mc-empty"><svg class="mc-ico-xl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 6"/></svg>
                <b><: No clients yet :></b><span><: A client gets its own login to the panel, with the limits of the package you give it. :></span></div>
            <% endif %>
        </div>
        <form id="mc-act" method="post" action="./?module=manage_clients&amp;action=EditClient"><input type="hidden" name="inReturn" value="manage_clients"><@ CSFR_Tag @></form>
        <% endif %>

        <% if IsForm %>
        <a href="./?module=manage_clients" class="btn btn-default btn-sm mc-back"><svg class="mc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg><: All clients :></a>
        <div class="mc-formwrap">
            <% if IsNew %><form class="mc-form" id="mc-form" action="./?module=manage_clients&amp;show=New&amp;action=CreateClient" method="post" autocomplete="off"><% endif %>
            <% if IsEdit %><form class="mc-form" id="mc-form" action="./?module=manage_clients&amp;show=Edit&amp;other=<@ FId @>&amp;action=UpdateClient" method="post" autocomplete="off">
                <input type="hidden" name="inClientID" value="<@ FId @>"><% endif %>
                <h3 class="mc-h"><@ FormTitle @></h3>

                <div class="mc-box">
                    <h4><: Account :></h4>
                    <div class="mc-grid">
                        <% if IsNew %>
                        <label class="mc-field"><span><: User name :></span>
                            <input class="form-control" type="text" name="inNewUserName" id="inNewUserName" value="<@ FUser @>" maxlength="50" pattern="[A-Za-z0-9][A-Za-z0-9-]*" required autocapitalize="none" spellcheck="false">
                            <small><: Letters, digits and hyphens. It is also the name of its folder, and can not be changed later. :></small></label>
                        <% endif %>
                        <label class="mc-field"><span><: Package :></span><select class="form-control" name="<% if IsNew %>inNewPackage<% endif %><% if IsEdit %>inPackage<% endif %>" required><@ PackageOptions @></select>
                            <small><: Its limits: disk space, bandwidth, domains, mailboxes and so on. :></small></label>
                        <label class="mc-field"><span><: Group :></span><select class="form-control" name="<% if IsNew %>inNewGroup<% endif %><% if IsEdit %>inGroup<% endif %>" required><@ GroupOptions @></select>
                            <small><: Which modules it can use. :></small></label>
                    </div>
                    <% if IsEdit %>
                    <div class="mc-switchrow"><div><label for="inEnabled"><: Can log in :></label><small><: Off: the client can not log in to the panel, and its websites and FTP accounts stop working. Nothing is deleted. :></small></div>
                        <label class="mc-switch"><input type="checkbox" name="inEnabled" id="inEnabled" value="1"<@ FEnabledChecked @>><span class="mc-toggle"></span></label></div>
                    <% endif %>
                </div>

                <div class="mc-box">
                    <h4><: Password :></h4>
                    <% if IsEdit %><p class="mc-sub"><: Leave it empty to keep the current password. :></p><% endif %>
                    <div class="mc-pass"><input class="form-control" type="password" name="inNewPassword" id="inPassword" autocomplete="new-password"<% if IsNew %> required<% endif %>>
                        <button type="button" class="btn btn-default mc-show" data-show="<: Show :>" data-hide="<: Hide :>"><: Show :></button>
                        <button type="button" class="btn btn-default mc-gen" data-len="<@ MinPassLength @>"><: Make one :></button></div>
                    <ul class="mc-rules idle" data-len="<@ MinPassLength @>">
                        <li data-rule="len"><: At least :> <@ MinPassLength @> <: characters :></li><li data-rule="lower"><: A lower case letter :></li>
                        <li data-rule="upper"><: A capital :></li><li data-rule="digit"><: A digit :></li>
                    </ul>
                </div>

                <div class="mc-box">
                    <h4><: Contact :></h4>
                    <div class="mc-grid">
                        <label class="mc-field"><span><: Full name :></span><input class="form-control" type="text" name="<% if IsNew %>inNewFullName<% endif %><% if IsEdit %>inFullName<% endif %>" value="<@ FName @>" maxlength="100"></label>
                        <label class="mc-field"><span><: Email address :></span><input class="form-control" type="email" name="<% if IsNew %>inNewEmailAddress<% endif %><% if IsEdit %>inEmailAddress<% endif %>" value="<@ FEmail @>" required maxlength="250">
                            <small><: Where the panel sends its messages and password resets. Each account needs its own. :></small></label>
                        <label class="mc-field"><span><: Phone number :></span><input class="form-control" type="tel" name="<% if IsNew %>inNewPhone<% endif %><% if IsEdit %>inPhone<% endif %>" value="<@ FPhone @>" maxlength="50"></label>
                        <label class="mc-field"><span><: Postal code :></span><input class="form-control" type="text" name="<% if IsNew %>inNewPostCode<% endif %><% if IsEdit %>inPostCode<% endif %>" value="<@ FPost @>" maxlength="10"></label>
                        <label class="mc-field mc-wide"><span><: Postal address :></span><textarea class="form-control" name="<% if IsNew %>inNewAddress<% endif %><% if IsEdit %>inAddress<% endif %>" rows="3"><@ FAddress @></textarea></label>
                    </div>
                </div>

                <% if IsNew %>
                <div class="mc-box">
                    <div class="mc-switchrow mc-first"><div><label for="inSWE"><: Send a welcome email :></label><small><: With the login details, to the email address above. :></small></div>
                        <label class="mc-switch"><input type="checkbox" name="inSWE" id="inSWE" value="1"<@ FSendChecked @>><span class="mc-toggle"></span></label></div>
                    <div class="mc-welcome" id="mc-welcome">
                        <label class="mc-field"><span><: Subject :></span><input class="form-control" type="text" name="inEmailSubject" value="<@ FSubject @>"></label>
                        <label class="mc-field"><span><: Text :></span><textarea class="form-control" name="inEmailBody" rows="8"><@ FBody @></textarea></label>
                        <p class="mc-sub"><: These are filled in: :> <code>{{username}}</code> <code>{{password}}</code> <code>{{fullname}}</code> <code>{{controlpanelurl}}</code></p>
                    </div>
                </div>
                <% endif %>

                <div class="mc-foot">
                    <button class="btn btn-primary" type="submit"><% if IsNew %><: Create client :><% endif %><% if IsEdit %><: Save changes :><% endif %></button>
                    <a class="btn btn-default" href="./?module=manage_clients"><: Cancel :></a>
                </div>
                <@ CSFR_Tag @>
            </form>
            <% if IsEdit %><aside class="mc-box mc-sum"><@ ClientSummary @></aside>
            <form id="mc-act" method="post" action="./?module=manage_clients&amp;action=EditClient"><input type="hidden" name="inReturn" value="manage_clients"><@ CSFR_Tag @></form><% endif %>
        </div>
        <% endif %>

        <% if IsDelete %>
        <form class="mc-box mc-confirm" action="./?module=manage_clients&amp;action=DeleteClient" method="post">
            <h4><svg class="mc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg><: Delete the client :> <code><@ DeleteName @></code>?</h4>
            <@ DeleteDetails @>
            <label class="mc-sure"><input type="checkbox" required> <: I understand that this deletes the client and everything it has. :></label>
            <div class="mc-foot"><input type="hidden" name="inDelete" value="<@ DeleteId @>">
                <button class="btn btn-danger" type="submit"><: Delete client :></button>
                <a class="btn btn-default" href="./?module=manage_clients"><: Cancel :></a></div>
            <@ CSFR_Tag @>
        </form>
        <% endif %>
    </div>
</div>
<script src="modules/manage_clients/assets/clients.js"></script>
