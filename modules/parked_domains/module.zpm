<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/domains/assets/domains.css">

    <div class="dm" id="dm">
        <% if isDeleteDomain %>
        <form class="dm-box dm-confirm" action="./?module=parked_domains&amp;action=DeleteParkedDomain" method="post">
            <h4><svg class="dm-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg><: Delete the parked domain :> <code data-idn="<@ CurrentDomain @>"><@ CurrentDomain @></code>?</h4>
            <@ DeleteDetails @>
            <div class="dm-foot"><input type="hidden" name="inDelete" value="<@ CurrentID @>">
                <button class="btn btn-danger" type="submit"><: Delete :></button>
                <a class="btn btn-default" href="./?module=parked_domains"><: Cancel :></a></div>
            <@ CSFR_Tag @>
        </form>
        <% endif %>

        <div class="dm-tiles"><@ Tiles @></div>

        <div class="dm-box">
            <div class="dm-head"><h4><: Your parked domains :></h4>
                <input type="search" class="form-control dm-find" placeholder="<: Find a domain :>" aria-label="<: Find a domain :>" hidden></div>
            <p class="dm-sub" style="margin: -6px 0 12px;"><: A parked domain has no site of its own: it shows this server's holding page. Park a name you own but do not use yet, so it answers while you decide. :></p>
            <% if ParkedDomainList %>
            <form id="dm-delete" action="./?module=parked_domains&amp;action=ConfirmDeleteParkedDomain" method="post"><@ CSFR_Tag @></form>
            <div class="dm-list"><@ Cards @></div>
            <p class="dm-empty dm-nomatch" hidden><: No domain matches. :></p>
            <% else %>
            <div class="dm-empty"><b><: You have no parked domains :></b><span><: Park one below. To give it a site, add it in Domains instead. :></span></div>
            <% endif %>
        </div>

        <div class="dm-box">
            <h4><: Park a domain :></h4>
            <% if CreateParkedDomain %>
            <form action="./?module=parked_domains&amp;action=CreateParkedDomain" method="post" class="dm-create">
                <label class="dm-label" for="inDomainName"><: Domain name :></label>
                <input class="form-control" name="inDomain" type="text" id="inDomainName" value="<@ PostedDomain @>" placeholder="example.com" autocomplete="off" spellcheck="false" required style="max-width: 460px;">
                <p class="dm-sub"><: Without www. It goes live at the next update of the web server, within an hour. :></p>
                <div class="dm-foot"><@ CSFR_Tag @><button class="btn btn-primary" type="submit" name="CreateParkedDomain" value="1"><: Park domain :></button></div>
            </form>
            <% else %>
            <div class="dm-limit"><: You have as many parked domains as your package allows. Delete one, or ask your host for a bigger package. :></div>
            <% endif %>
        </div>
    </div>
</div>
<script src="modules/domains/assets/punycode.js"></script>
<script src="modules/domains/assets/domains.js"></script>
