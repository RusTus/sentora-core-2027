<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/mysql_users/assets/mysql_users.css">

    <div class="mu" id="mu">
        <@ SecretCard @>

        <% if isDeleteUser %>
        <form class="mu-card mu-confirm" action="./?module=mysql_users&amp;action=ConfirmDeleteUser" method="post">
            <h4><svg class="mu-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg><: Delete the MySQL user :> <code><@ EditCurrentUserName @></code>?</h4>
            <@ DeleteDetails @>
            <div class="mu-foot"><input type="hidden" name="inDelete" value="<@ EditCurrentUserID @>">
                <button class="btn btn-danger" type="submit"><: Delete :></button>
                <a class="btn btn-default" href="./?module=mysql_users"><: Cancel :></a></div>
            <@ CSFR_Tag @>
        </form>
        <% endif %>

        <% if isEditUser %>
        <div class="mu-card mu-edit-head">
            <a href="./?module=mysql_users" class="btn btn-default btn-sm mu-back"><svg class="mu-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg><: All MySQL users :></a>
            <div class="mu-title"><span class="mu-avatar lg" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span>
                <div><small><: MySQL user :></small><div class="mu-name big"><@ EditNameHtml @> <@ EditAccess @></div></div></div>
        </div>

        <div class="mu-cols">
            <div class="mu-card">
                <h4><: Databases it can use :></h4>
                <form action="./?module=mysql_users&amp;show=Edit&amp;other=<@ EditCurrentUserID @>&amp;action=RemoveDB" method="post" class="mu-dblist">
                    <@ UserDatabaseRows @>
                    <input type="hidden" name="inUser" value="<@ EditCurrentUserID @>">
                    <@ CSFR_Tag @>
                </form>
                <% if CanAddDatabase %>
                <form action="./?module=mysql_users&amp;show=Edit&amp;other=<@ EditCurrentUserID @>&amp;action=AddDB" method="post" class="mu-add">
                    <label class="mu-label" for="mu-adddb"><: Give it access to :></label>
                    <div class="mu-inline"><select class="form-control" name="inDatabase" id="mu-adddb" required><option value=""><: Choose a database :></option><@ AddDatabaseOptions @></select>
                        <input type="hidden" name="inUser" value="<@ EditCurrentUserID @>">
                        <button class="btn btn-primary" type="submit"><: Add :></button></div>
                    <@ CSFR_Tag @>
                </form>
                <% else %>
                <p class="mu-sub"><: It can use all your databases. Make more in MySQL Databases. :></p>
                <% endif %>
            </div>

            <div class="mu-card">
                <h4><: New password :></h4>
                <form action="./?module=mysql_users&amp;show=Edit&amp;other=<@ EditCurrentUserID @>&amp;action=ResetPW" method="post" class="mu-pwform">
                    <div class="mu-pass"><input class="form-control" type="password" name="inResetPW" id="inPassword" value="" aria-label="<: New password :>" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{<@ MinPassLength @>,}" autocomplete="new-password" required>
                        <button type="button" class="btn btn-default mu-show" data-show="<: Show :>" data-hide="<: Hide :>"><: Show :></button>
                        <button type="button" class="btn btn-default mu-gen" data-len="<@ MinPassLength @>"><: Make one :></button></div>
                    <ul class="mu-rules">
                        <li data-rule="lower"><: A lower case letter :></li>
                        <li data-rule="upper"><: A capital letter :></li>
                        <li data-rule="digit"><: A digit :></li>
                        <li data-rule="len" data-len="<@ MinPassLength @>"><@ MinPassLength @> <: characters or more :></li>
                    </ul>
                    <p class="mu-sub"><: Applications that log in with this user need the new password too. :></p>
                    <input type="hidden" name="inUser" value="<@ EditCurrentUserID @>">
                    <div class="mu-foot"><button class="btn btn-primary" type="submit"><: Save password :></button></div>
                    <@ CSFR_Tag @>
                </form>
            </div>
        </div>
        <% endif %>

        <% if isCreateUser %>
        <div class="mu-tiles"><@ Summary @></div>

        <div class="mu-card">
            <div class="mu-head"><h4><: Your MySQL users :></h4>
                <input type="search" class="form-control mu-find" placeholder="<: Find a user or database :>" aria-label="<: Find a user or database :>" hidden></div>
            <% if UserList %>
            <form action="./?module=mysql_users&amp;action=EditUser" method="post" class="mu-list">
                <@ UserCards @>
                <@ CSFR_Tag @>
            </form>
            <p class="mu-empty mu-nomatch" hidden><: No user matches. :></p>
            <% else %>
            <div class="mu-empty"><b><: You have no MySQL users yet :></b><span><: Applications log in to their database with a MySQL user: make one below. :></span></div>
            <% endif %>
        </div>

        <div class="mu-card">
            <h4><: Create a MySQL user :></h4>
            <% if DatabaseList %>
            <form action="./?module=mysql_users&amp;action=CreateUser" method="post" class="mu-create">
                <div class="mu-grid">
                    <div>
                        <label class="mu-label" for="inUserName"><: User name :></label>
                        <div class="mu-name-field"><span class="mu-pre"><@ CurrentUserName @>_</span>
                            <input class="form-control" name="inUserName" type="text" id="inUserName" value="<@ PostedUserName @>" maxlength="<@ MaxCharAllowed @>" pattern="[A-Za-z0-9]([A-Za-z0-9_\-]*[A-Za-z0-9_])?" autocomplete="off" spellcheck="false" required></div>
                        <p class="mu-sub mu-hint"><span class="mu-left" data-max="<@ MaxCharAllowed @>"></span> <: Letters, digits, dashes and underscores. :></p>
                    </div>
                    <div>
                        <label class="mu-label" for="inDatabase"><: Database it can use :></label>
                        <select class="form-control" name="inDatabase" id="inDatabase" required>
                            <option value=""><: Choose a database :></option>
                            <% loop DatabaseList %>
                            <option value="<& mysqlid &>"><& mysqlname &></option>
                            <% endloop %>
                        </select>
                        <p class="mu-sub mu-hint"><: More can be added afterwards. :></p>
                    </div>
                </div>
                <span class="mu-label"><: It can connect from :></span>
                <div class="mu-choices">
                    <label class="mu-choice"><input type="radio" name="inAccess" value="1" checked><span><b><: Any address :></b><small><: This server and remote tools :></small></span></label>
                    <label class="mu-choice"><input type="radio" name="inAccess" value="3"><span><b><: This server only :></b><small><: Websites on this server (localhost) :></small></span></label>
                    <label class="mu-choice"><input type="radio" name="inAccess" value="2"><span><b><: One IP address :></b><small><: For example your office :></small></span></label>
                </div>
                <input type="text" class="form-control mu-ip" name="inAccessIP" id="inAccessIP" placeholder="<: IP address, for example 203.0.113.10 :>" aria-label="<: IP address :>" hidden>
                <div class="mu-foot"><@ CSFR_Tag @><button class="btn btn-primary" type="submit"><: Create :></button>
                    <span class="mu-sub"><: A strong password is made for it and shown once you create it. :></span></div>
            </form>
            <% else %>
            <div class="mu-limit"><: Make a database first in MySQL Databases: a MySQL user is always made for a database. :></div>
            <% endif %>
        </div>
        <% endif %>
    </div>
</div>
<script>
(function () {
    'use strict';
    var mu = document.getElementById('mu'); if (!mu) { return; }
    var each = function (sel, fn) { Array.prototype.forEach.call(mu.querySelectorAll(sel), fn); };
    // Copy
    each('.mu-copy', function (b) {
        b.addEventListener('click', function () {
            var text = b.parentNode.querySelector('code').textContent;
            var done = function () { var o = b.textContent; b.textContent = b.getAttribute('data-done'); b.classList.add('done'); setTimeout(function () { b.textContent = o; b.classList.remove('done'); }, 1500); };
            if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(text).then(done, function () {}); return; }
            var ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); done(); } catch (e) {} document.body.removeChild(ta);
        });
    });
    // one IP address: its field
    var ip = mu.querySelector('.mu-ip');
    each('input[name=inAccess]', function (r) { r.addEventListener('change', function () { ip.hidden = r.value !== '2' || !r.checked; ip.required = !ip.hidden; if (!ip.hidden) { ip.focus(); } }); });
    // characters left for the name
    var name = mu.querySelector('#inUserName'), left = mu.querySelector('.mu-left');
    if (name && left) {
        var max = parseInt(left.getAttribute('data-max'), 10) || 0;
        var upd = function () { name.value = name.value.replace(/\s+/g, ''); var n = max - name.value.length; left.textContent = n + ' / ' + max; left.classList.toggle('low', n < 4); };
        name.addEventListener('input', upd); upd();
    }
    // new password: Show, Make one (the browser's secure random numbers) and the rules ticked as you type
    var pw = mu.querySelector('#inPassword');
    if (pw) {
        var show = mu.querySelector('.mu-show'), gen = mu.querySelector('.mu-gen');
        var vis = function (on) { pw.type = on ? 'text' : 'password'; show.textContent = show.getAttribute(on ? 'data-hide' : 'data-show'); };
        var rules = function () {
            var v = pw.value, ok = { lower: /[a-z]/.test(v), upper: /[A-Z]/.test(v), digit: /[0-9]/.test(v), len: v.length >= parseInt(mu.querySelector('[data-rule=len]').getAttribute('data-len'), 10) };
            each('.mu-rules li', function (li) { li.classList.toggle('ok', !!ok[li.getAttribute('data-rule')]); });
        };
        show.addEventListener('click', function () { vis(pw.type === 'password'); });
        gen.addEventListener('click', function () {
            var chars = 'abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789', len = Math.max(16, parseInt(gen.getAttribute('data-len'), 10) || 0), out, buf = new Uint32Array(1), lim = Math.floor(4294967296 / chars.length) * chars.length;
            do { out = ''; while (out.length < len) { window.crypto.getRandomValues(buf); if (buf[0] < lim) { out += chars.charAt(buf[0] % chars.length); } } }
            while (!/[a-z]/.test(out) || !/[A-Z]/.test(out) || !/[0-9]/.test(out));
            pw.value = out; vis(true); rules(); pw.select();
        });
        pw.addEventListener('input', rules); rules();
    }
    // Delete and Remove access ask first only on the confirmation page; the rest shows the loader
    each('form', function (f) { f.addEventListener('submit', function () { if (window.Sentora && Sentora.loader) { Sentora.loader.showLoader(); } }); });
    // with many users, a search
    var users = mu.querySelectorAll('.mu-user'), find = mu.querySelector('.mu-find');
    if (find && users.length > 6) {
        find.hidden = false;
        find.addEventListener('input', function () {
            var q = find.value.trim().toLowerCase(), n = 0;
            Array.prototype.forEach.call(users, function (u) { var on = q === '' || u.getAttribute('data-s').indexOf(q) >= 0; u.hidden = !on; if (on) { n++; } });
            mu.querySelector('.mu-nomatch').hidden = n > 0;
        });
    }
})();
</script>
