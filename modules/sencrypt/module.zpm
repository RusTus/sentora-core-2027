<@ Init @>
<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>

    <@ CheckModReq @>
    <@ Result @>

    <div class="sc" id="sc">
        <nav class="sc-tabs" role="tablist"><@ Tabs @></nav>

        <!-- Your certificates -->
        <section class="sc-pane<@ TabCerts @>" data-pane="certs">
            <div class="sc-stats"><@ CertSummary @></div>
            <% if Admin %>
            <div class="sc-card">
                <div class="sc-card-head">
                    <h4><: Control panel :></h4>
                    <p><: The certificate of the panel's own address, so you and your clients log in over https. :></p>
                </div>
                <div class="sc-scroll">
                    <table class="sc-table">
                        <thead><tr><th><: Domain :></th><th><: Type :></th><th><: Status :></th><th><: Expires :></th><th class="sc-actions"><: Actions :></th></tr></thead>
                        <tbody><@ PanelCertRows @></tbody>
                    </table>
                </div>
            </div>
            <% endif %>
            <div class="sc-card">
                <div class="sc-card-head">
                    <h4><: Your domains :></h4>
                    <p><: Certificates for your domains and subdomains. Changes reach the web server within about 5 minutes. :></p>
                </div>
                <div class="sc-scroll">
                    <table class="sc-table">
                        <thead><tr><th><: Domain :></th><th><: Type :></th><th><: Status :></th><th><: Expires :></th><th class="sc-actions"><: Actions :></th></tr></thead>
                        <tbody><@ CertRows @></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Let's Encrypt -->
        <section class="sc-pane<@ TabLetsEncrypt @>" data-pane="letsencrypt">
            <div class="sc-note">
                <@ IconInfo @>
                <div>
                    <b><: Free certificates that renew by themselves :></b>
                    <: Let's Encrypt checks that the domain is yours by reaching it over the internet, so its DNS must point to this server and the site must answer on port 80. Each certificate lasts 90 days and is renewed 30 days before it ends. :>
                    <a href="https://letsencrypt.org/" target="_blank" rel="noopener noreferrer"><: About Let's Encrypt :></a>
                </div>
            </div>
            <div class="sc-card">
                <div class="sc-card-head">
                    <h4><: Get a certificate :></h4>
                    <p><: Domains without a certificate. Getting one takes up to a minute. :></p>
                </div>
                <div class="sc-scroll">
                    <table class="sc-table">
                        <thead><tr><th><: Domain :></th><th class="sc-actions"><: Actions :></th></tr></thead>
                        <tbody><@ LetsEncryptRows @></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Your own certificate -->
        <section class="sc-pane<@ TabThirdParty @>" data-pane="third-party">
            <div class="sc-choices"><@ Choices @></div>

            <% if isShowSelf %>
            <div class="sc-card">
                <div class="sc-card-head">
                    <h4><: Make a self-signed certificate :></h4>
                    <p><: Valid for a year. Browsers show a warning for it, because no authority vouches for it. :></p>
                </div>
                <form class="sc-form sc-act" action="./?module=sencrypt&amp;ShowPanel=third-party&amp;action=Makenew" method="post">
                    <label><span><: Domain :></span>
                        <select class="form-control" name="inDomain" required>
                            <option value="">-- <: Select a domain :> --</option>
                            <% loop DomainList %><option value="<& domain &>"><& domain &></option><% endloop %>
                        </select></label>
                    <label><span><: Organization :></span><input class="form-control" type="text" name="inCompany" required></label>
                    <label><span><: Email address :></span><input class="form-control" type="email" name="inAddress" required></label>
                    <label><span><: City :></span><input class="form-control" type="text" name="inCity" required></label>
                    <label><span><: State or province :></span><input class="form-control" type="text" name="inName" required></label>
                    <label><span><: Country :></span>
                        <select class="form-control" name="inCountry" required>
                            <option value="">-- <: Select country :> --</option>
                            <@ ListCountry @>
                        </select></label>
                    <div class="sc-form-foot">
                        <button type="submit" class="btn btn-primary" name="inSave"><: Make certificate :></button>
                        <a class="btn btn-default" href="./?module=sencrypt&amp;ShowPanel=third-party"><: Cancel :></a>
                    </div>
                    <@ CSFR_Tag @>
                </form>
            </div>
            <% endif %>

            <% if isShowCSR %>
            <div class="sc-card">
                <div class="sc-card-head">
                    <h4><: Make a Certificate Signing Request :></h4>
                    <p><: The request is e-mailed to the address below; give it to the certificate seller. Its private key stays on the server, and is used when you install the certificate under "Install a signed certificate". :></p>
                </div>
                <form class="sc-form sc-act" action="./?module=sencrypt&amp;ShowPanel=third-party&amp;action=MakeCSR" method="post">
                    <label><span><: Domain :></span>
                        <select class="form-control" name="inDomain" required>
                            <option value="">-- <: Select a domain :> --</option>
                            <% loop DomainList %><option value="<& domain &>"><& domain &></option><% endloop %>
                        </select></label>
                    <label><span><: Organization :></span><input class="form-control" type="text" name="inCompany" required></label>
                    <label><span><: Email address :></span><input class="form-control" type="email" name="inAddress" required></label>
                    <label><span><: City :></span><input class="form-control" type="text" name="inCity" required></label>
                    <label><span><: State or province :></span><input class="form-control" type="text" name="inName" required></label>
                    <label><span><: Country :></span>
                        <select class="form-control" name="inCountry" required>
                            <option value="">-- <: Select country :> --</option>
                            <@ ListCountry @>
                        </select></label>
                    <div class="sc-form-foot">
                        <button type="submit" class="btn btn-primary" name="inSave"><: Make request :></button>
                        <a class="btn btn-default" href="./?module=sencrypt&amp;ShowPanel=third-party"><: Cancel :></a>
                    </div>
                    <@ CSFR_Tag @>
                </form>
            </div>
            <% endif %>

            <% if isBought %>
            <div class="sc-card">
                <div class="sc-card-head">
                    <h4><: Install a signed certificate :></h4>
                    <p><: The files the seller sent. The private key is the one kept from your request; upload a key only for a certificate requested elsewhere. :></p>
                </div>
                <form class="sc-form sc-act" action="./?module=sencrypt&amp;ShowPanel=third-party&amp;action=UploadSSL" method="post" enctype="multipart/form-data">
                    <label><span><: Domain :></span>
                        <select class="form-control" name="inDomain" required>
                            <option value="">-- <: Select a domain :> --</option>
                            <% loop DomainList %><option value="<& domain &>"><& domain &></option><% endloop %>
                        </select></label>
                    <label class="sc-file"><span><: Private key (.key), only for a certificate requested elsewhere :></span><input type="file" name="inkey"></label>
                    <label class="sc-file"><span><: Certificate (.crt or .cer) :></span><input type="file" name="inWCA" required></label>
                    <label class="sc-file"><span><: CA chain, the intermediate certificate (.crt or .cer) :></span><input type="file" name="inICA" required></label>
                    <div class="sc-form-foot">
                        <button type="submit" class="btn btn-primary" name="inCreateSSL"><: Install certificate :></button>
                        <a class="btn btn-default" href="./?module=sencrypt&amp;ShowPanel=third-party"><: Cancel :></a>
                    </div>
                    <@ CSFR_Tag @>
                </form>
            </div>
            <% endif %>
        </section>
    </div>
</div>

<script>
(function () {
    'use strict';
    var root = document.getElementById('sc');
    if (!root) { return; }
    // tabs switch in place (the links still work without scripts)
    Array.prototype.forEach.call(root.querySelectorAll('.sc-tab'), function (a) {
        a.addEventListener('click', function (e) {
            if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) { return; }
            e.preventDefault();
            var tab = a.getAttribute('data-tab');
            Array.prototype.forEach.call(root.querySelectorAll('.sc-tab'), function (t) { t.classList.toggle('on', t === a); t.setAttribute('aria-selected', t === a ? 'true' : 'false'); });
            Array.prototype.forEach.call(root.querySelectorAll('.sc-pane'), function (p) { p.classList.toggle('on', p.getAttribute('data-pane') === tab); });
            try { history.replaceState(null, '', a.getAttribute('href')); } catch (err) { /* ignore */ }
        });
    });
    // confirm what can not be undone, then show the panel's "working" overlay
    Array.prototype.forEach.call(root.querySelectorAll('form.sc-act'), function (f) {
        f.addEventListener('submit', function (e) {
            var q = f.getAttribute('data-confirm');
            if (q && !window.confirm(q)) { e.preventDefault(); return; }
            // (not for a download: the page stays, so the overlay would never go)
            if (f.action.indexOf('action=Download') < 0 && window.Sentora && Sentora.loader && Sentora.loader.showLoader) { Sentora.loader.showLoader(); }
        });
    });
})();
</script>
