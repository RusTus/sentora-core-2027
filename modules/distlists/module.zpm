<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <@ Result @>
    <@ ResultURL @>
    <link rel="stylesheet" href="modules/distlists/assets/distlists.css">

    <div class="dl" id="dl">
        <% if isDeleteDistList %>
        <form class="dl-box dl-confirm" action="./?module=distlists&amp;action=ConfirmDeleteDistList" method="post">
            <h4><svg class="dl-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg><: Delete the list :> <code><@ CurrentDistList @></code>?</h4>
            <@ DeleteDetails @>
            <div class="dl-foot"><input type="hidden" name="inDelete" value="<@ CurrentDistListID @>">
                <button class="btn btn-danger" type="submit"><: Delete :></button>
                <a class="btn btn-default" href="./?module=distlists"><: Cancel :></a></div>
            <@ CSFR_Tag @>
        </form>
        <% endif %>

        <% if isEditDistList %>
        <div class="dl-box dl-edit-head">
            <a href="./?module=distlists" class="btn btn-default btn-sm dl-back"><svg class="dl-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg><: All distribution lists :></a>
            <div class="dl-title"><svg class="dl-ico-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="4"/><path d="M2 21a7 7 0 0 1 14 0"/><path d="M17 11a3 3 0 1 0 0-6M22 21a6 6 0 0 0-4-5.6"/></svg>
                <div><small><: Distribution list :></small><b><@ CurrentDistList @></b></div></div>
        </div>
        <div class="dl-box">
            <h4><: Members :> <span class="dl-n"><@ MemberCount @></span></h4>
            <p class="dl-sub"><: Mail sent to the list is passed on to every member. :></p>
            <form action="./?module=distlists&amp;show=Edit&amp;other=<@ CurrentDistListID @>&amp;action=UpdateDistList" method="post" class="dl-members-form">
                <div class="dl-mlist"><@ MemberRows @></div>
                <div class="dl-add">
                    <label class="dl-label" for="inAddAddress"><: Add a member :></label>
                    <div class="dl-inline"><input class="form-control" type="email" name="inAddAddress" id="inAddAddress" list="dl-mailboxes" placeholder="name@example.com" autocomplete="off" spellcheck="false">
                        <datalist id="dl-mailboxes"><@ MailboxSuggestions @></datalist>
                        <button class="btn btn-primary" type="submit" name="inAdd" value="inAdd"><: Add :></button></div>
                    <p class="dl-sub"><: One of your mailboxes (they are suggested as you type) or any address elsewhere. :></p>
                </div>
                <input type="hidden" name="inDLID" value="<@ CurrentDistListID @>">
                <@ CSFR_Tag @>
            </form>
        </div>
        <% endif %>

        <% if isCreateDistList %>
        <div class="dl-tiles"><@ Tiles @></div>

        <div class="dl-box">
            <div class="dl-head"><div><h4><: Your distribution lists :></h4>
                <p class="dl-sub"><: One address that passes mail on to a group, such as team@ or staff@. :></p></div>
                <input type="search" class="form-control dl-find" placeholder="<: Find a list or member :>" aria-label="<: Find a list or member :>" hidden></div>
            <% if DistList %>
            <form action="./?module=distlists&amp;action=EditDistList" method="post" class="dl-list">
                <@ ListCards @>
                <@ CSFR_Tag @>
            </form>
            <p class="dl-empty dl-nomatch" hidden><: No list matches. :></p>
            <% else %>
            <div class="dl-empty"><b><: You have no distribution lists yet :></b><span><: Make one below, then add its members. :></span></div>
            <% endif %>
        </div>

        <div class="dl-box">
            <h4><: Make a distribution list :></h4>
            <% if QuotaLimit %>
            <form action="./?module=distlists&amp;action=AddDistList" method="post" class="dl-create">
                <label class="dl-label" for="inAddress"><: Address :></label>
                <div class="dl-addrfield"><input class="form-control" type="text" name="inAddress" id="inAddress" value="<@ PostedAddress @>" placeholder="<: team :>" autocomplete="off" spellcheck="false" required>
                    <select class="form-control" name="inDomain" id="inDomain" aria-label="<: Domain :>"><@ DomainOptions @></select></div>
                <div class="dl-foot"><@ CSFR_Tag @><button class="btn btn-primary" type="submit" name="inCreate" value="inCreate"><: Make list :></button>
                    <span class="dl-sub"><: Then open Members to add who receives its mail. :></span></div>
            </form>
            <% else %>
            <div class="dl-limit"><: You have as many distribution lists as your package allows. Delete one, or ask your host for a bigger package. :></div>
            <% endif %>
        </div>
        <% endif %>
    </div>
</div>
<script>
(function () {
    'use strict';
    var dl = document.getElementById('dl'); if (!dl) { return; }
    var cards = dl.querySelectorAll('.dl-card'), find = dl.querySelector('.dl-find');
    if (find && cards.length > 6) {
        find.hidden = false;
        find.addEventListener('input', function () {
            var q = find.value.trim().toLowerCase(), n = 0;
            Array.prototype.forEach.call(cards, function (c) { var on = q === '' || c.getAttribute('data-s').indexOf(q) >= 0; c.hidden = !on; if (on) { n++; } });
            dl.querySelector('.dl-nomatch').hidden = n > 0;
        });
    }
    // Add needs an address; Remove does not
    var add = dl.querySelector('#inAddAddress');
    if (add) { dl.querySelector('.dl-members-form').addEventListener('submit', function (e) { var b = e.submitter; if (b && b.name === 'inAdd' && !add.value.trim()) { e.preventDefault(); add.focus(); } }); }
    Array.prototype.forEach.call(dl.querySelectorAll('form'), function (f) { f.addEventListener('submit', function (e) { if (!e.defaultPrevented && window.Sentora && Sentora.loader) { Sentora.loader.showLoader(); } }); });
})();
</script>
