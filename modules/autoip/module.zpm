<@ InstallDatabase @>
<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/autoip/assets/autoip.css">

    <% if AutoIPSettings %>
    <div class="ai" id="ai">
        <div class="ai-card ai-status"><@ Status @></div>

        <div class="ai-grid">
            <% loop AutoIPSettings %>
            <form class="ai-card ai-form" action="./?module=autoip&amp;action=updateautoip" method="post">
                <h4><: Settings :></h4>
                <label class="ai-switch"><input type="checkbox" name="inEnabled" value="1" <& ischecked &>><span class="ai-toggle" aria-hidden="true"></span>
                    <span><b><: Follow the public IP address :></b><small><: When it changes, the panel's IP address and every DNS record that has the old one are updated, within 5 minutes. :></small></span></label>
                <label class="ai-field"><span><: IP service :></span><input class="form-control" type="url" name="inCommand" value="<& ai_command_vc &>" maxlength="255" required>
                    <small><: A web address that answers with this server's public IP address. If it does not answer, three others are tried. :></small></label>
                <div class="ai-chips"><span><: Pick one: :></span><@ Services @></div>
                <label class="ai-field"><span><: Email alert :></span><input class="form-control" type="text" name="inEmail" value="<& ai_email_vc &>" maxlength="255" placeholder="you@example.com, noc@example.com">
                    <small><: Who is told when the IP address changes. Separate several addresses with commas; leave it empty for none. :></small></label>
                <label class="ai-field"><span><: Script to run after a change :> <small><: (optional) :></small></span><input class="form-control" type="text" name="inScript" value="<& ai_script_vc &>" maxlength="255" placeholder="/usr/local/bin/ip-changed.sh">
                    <small><: The full path of a file owned by root that only root may change. It is run with the new and the old IP address as its two arguments. :></small></label>
                <div class="ai-foot"><@ CSFR_Tag @><button class="btn btn-primary" type="submit" name="inUpdate" value="1"><: Save settings :></button></div>
            </form>
            <% endloop %>

            <aside class="ai-card ai-help">
                <h4><: How it works :></h4>
                <ol>
                    <li><: Every 5 minutes the daemon asks the IP service for this server's public address. :></li>
                    <li><: When it differs from the panel's IP address, the panel's address is changed, and so is every DNS record that has the old address. The DNS zones are written again. :></li>
                    <li><: Then the email alert is sent and the script is run, if you set them. :></li>
                </ol>
                <p class="ai-note"><: Useful on a home or office connection whose address changes now and then. On a server with a fixed address, leave it off. :></p>
            </aside>
        </div>
    </div>
    <script>
    (function () {
        'use strict';
        var input = document.querySelector('#ai input[name="inCommand"]');
        if (!input) { return; }
        Array.prototype.forEach.call(document.querySelectorAll('#ai .ai-chip'), function (b) {
            b.classList.toggle('on', b.getAttribute('data-url') === input.value);
            b.addEventListener('click', function () {
                input.value = b.getAttribute('data-url');
                Array.prototype.forEach.call(document.querySelectorAll('#ai .ai-chip'), function (o) { o.classList.toggle('on', o === b); });
            });
        });
    })();
    </script>
    <% endif %>
</div>
