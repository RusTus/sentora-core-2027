<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <link rel="stylesheet" href="<@ Assets @>tree.css">
    <div class="zgrid_wrapper">
        <@ Result @>
        <% if IsIndex %>
        <h3><: Protected folders :></h3>
        <table class="table table-striped">
            <tr><th><: Folder :></th><th><: Message :></th><th><: Users :></th><th></th></tr>
            <@ ProtectionRows @>
        </table>

        <h3><: Protect a folder :></h3>
        <p class="text-muted"><: Choose a folder of your website: visitors then need a username and password to open it and everything in it. :></p>
        <form method="post" action="./?module=protected_directories&action=CreateProtection" id="pd-form">
            <div class="pd-tree" id="pd-tree" data-url="modules/protected_directories/code/folders.php">
                <div class="pd-loading"><: Loading folders :>...</div>
            </div>
            <div class="pd-chosen" id="pd-chosen">
                <: Selected folder :>: <strong id="pd-chosen-path" class="text-muted"><: none yet: click a folder in the tree :></strong>
                <span id="pd-chosen-note" class="label label-warning" style="display:none"><: already protected :></span>
            </div>
            <input type="hidden" name="inPath" id="pd-path" value="">
            <div class="form-group" style="max-width: 480px; margin-top: 12px;">
                <label for="pd-message"><: Message in the login box :></label>
                <input type="text" class="form-control" name="inMessage" id="pd-message" maxlength="64" placeholder="Protected area">
            </div>
            <button type="submit" class="btn btn-primary" id="pd-submit" disabled><: Protect this folder :></button>
            <@ CSFR_Tag @>
        </form>
        <% endif %>

        <% if IsEdit %>
        <p><a href="./?module=protected_directories" class="btn btn-default btn-sm">&larr; <: All protected folders :></a></p>
        <h3><span class="icon-lock-alt"></span> <@ EditPath @></h3>
        <form method="post" action="./?module=protected_directories&control=Edit&id=<@ EditId @>&action=UpdateMessage" class="form-inline" style="margin-bottom: 18px;">
            <input type="hidden" name="inId" value="<@ EditId @>">
            <label for="pd-msg"><: Message in the login box :>:</label>
            <input type="text" class="form-control" name="inMessage" id="pd-msg" value="<@ EditMessage @>" maxlength="64" style="min-width: 280px;">
            <button type="submit" class="btn btn-default"><: Change message :></button>
            <@ CSFR_Tag @>
        </form>
        <h4><: Users who can open it :></h4>
        <table class="table table-striped">
            <tr><th><: Username :></th><th><: Password :></th><th></th></tr>
            <@ UserRows @>
        </table>
        <form method="post" action="./?module=protected_directories&control=Edit&id=<@ EditId @>&action=AddUser" class="form-inline">
            <input type="hidden" name="inId" value="<@ EditId @>">
            <input type="text" class="form-control" name="inUser" placeholder="<: Username :>" maxlength="32" pattern="[A-Za-z0-9._\-]+" required autocomplete="off">
            <input type="password" class="form-control" name="inPassword" placeholder="<: Password, 8 characters or more :>" minlength="8" maxlength="128" required autocomplete="new-password">
            <button type="submit" class="btn btn-primary"><: Add user :></button>
            <@ CSFR_Tag @>
        </form>
        <% endif %>
    </div>
    <script src="<@ Assets @>tree.js"></script>
</div>
