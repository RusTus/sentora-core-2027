<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><: The web server (Apache): its settings for every website, and the domains that have settings of their own. :></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/apache_admin/assets/apache.css">

    <div class="aa" id="aa">
        <% if IsMain %>
        <div class="aa-tiles"><@ Tiles @></div>
        <div class="aa-cols">
            <@ SettingsForm @>
            <aside class="aa-box"><h4><: Domains with their own settings :></h4><@ OverrideRows @></aside>
        </div>
        <% endif %>

        <% if IsVhost %>
        <a href="./?module=apache_admin" class="btn btn-default btn-sm aa-back"><svg class="aa-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg><: Apache settings :></a>
        <div class="aa-cols">
            <form class="sf" method="post" action="./?module=apache_admin&amp;show=Vhost&amp;id=<@ VhostId @>&amp;action=SaveVhost">
                <div class="aa-vh"><h3><@ VhostTitle @></h3><p><: Settings of this domain only. They are written to Apache by the daemon within 5 minutes; Apache's own check keeps the old configuration when it does not accept the new one. :></p></div>
                <@ VhostFields @>
                <div class="sf-foot"><input type="hidden" name="vh_id_pk" value="<@ VhostId @>"><a class="btn btn-default" href="./?module=apache_admin"><: Cancel :></a>
                    <@ CSFR_Tag @><button class="btn btn-primary" type="submit"><: Save :></button></div>
            </form>
            <div class="aa-side">
                <aside class="aa-box"><h4><: Domain :></h4><@ VhostInfo @></aside>
                <aside class="aa-box aa-help"><@ SymlinksHelp @></aside>
            </div>
        </div>
        <% endif %>
    </div>
</div>
