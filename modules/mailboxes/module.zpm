<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/mailboxes/assets/mailboxes.css">

    <div class="mb" id="mb">
        <% if isDeleteMailbox %>
        <form class="mb-box mb-confirm" action="./?module=mailboxes&amp;action=ConfirmDeleteMailbox" method="post">
            <h4><svg class="mb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg><: Delete the mailbox :> <code><@ EditCurrentMailboxName @></code>?</h4>
            <@ DeleteDetails @>
            <div class="mb-foot"><input type="hidden" name="inDelete" value="<@ EditCurrentMailboxID @>">
                <button class="btn btn-danger" type="submit"><: Delete :></button>
                <a class="btn btn-default" href="./?module=mailboxes"><: Cancel :></a></div>
            <@ CSFR_Tag @>
        </form>
        <% endif %>

        <% if isEditMailbox %>
        <form class="mb-box mb-edit" action="./?module=mailboxes&amp;show=Edit&amp;other=<@ EditCurrentMailboxID @>&amp;action=UpdateMailbox" method="post">
            <a href="./?module=mailboxes" class="btn btn-default btn-sm mb-back"><svg class="mb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg><: All mailboxes :></a>
            <div class="mb-title"><span class="mb-avatar lg" aria-hidden="true">@</span><div><small><: Mailbox :></small><b><@ EditCurrentMailboxName @></b></div></div>
            <div class="mb-switchrow"><div><label for="inEnabled"><: Receiving mail :></label><small><: Off: mail sent to it is refused and it can not be logged in to; the mail in it stays. :></small></div>
                <label class="mb-switch"><input type="checkbox" name="inEnabled" id="inEnabled" value="1"<@ EditOnChecked @>><span class="mb-toggle"></span></label></div>
            <label class="mb-label" for="inPassword"><: New password :> <small><: leave empty to keep the current one :></small></label>
            <div class="mb-pass"><input class="form-control" type="password" name="inPassword" id="inPassword" autocomplete="new-password">
                <button type="button" class="btn btn-default mb-show" data-show="<: Show :>" data-hide="<: Hide :>"><: Show :></button>
                <button type="button" class="btn btn-default mb-gen" data-len="<@ MinPassLength @>"><: Make one :></button></div>
            <ul class="mb-rules" data-len="<@ MinPassLength @>"><li data-rule="lower"><: A lower case letter :></li><li data-rule="upper"><: A capital letter :></li><li data-rule="digit"><: A digit :></li><li data-rule="len"><@ MinPassLength @> <: characters or more :></li></ul>
            <p class="mb-sub"><: The panel keeps no copy: tell the person who uses the mailbox, and update the password in their mail program. :></p>
            <div class="mb-foot"><@ CSFR_Tag @><button class="btn btn-primary" type="submit" name="inSave" value="<@ EditCurrentMailboxID @>"><: Save :></button>
                <a class="btn btn-default" href="./?module=mailboxes"><: Cancel :></a></div>
        </form>
        <% endif %>

        <% if isCreateMailbox %>
        <div class="mb-tiles"><@ Tiles @></div>

        <div class="mb-box">
            <div class="mb-head"><div><h4><: Your mailboxes :></h4>
                <p class="mb-sub"><: Each mailbox has its own address, password and mail. :></p></div>
                <div class="mb-headact"><input type="search" class="form-control mb-find" placeholder="<: Find a mailbox :>" aria-label="<: Find a mailbox :>" hidden>
                <% if WebmailOn %><a class="btn btn-default btn-sm" href="./?module=webmail"><svg class="mb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4z"/><path d="m4 7 8 6 8-6"/></svg><: Webmail :></a><% endif %></div></div>
            <% if MailboxList %>
            <form action="./?module=mailboxes&amp;action=EditMailbox" method="post" class="mb-list">
                <@ MailboxRows @>
                <@ CSFR_Tag @>
            </form>
            <p class="mb-empty mb-nomatch" hidden><: No mailbox matches. :></p>
            <% else %>
            <div class="mb-empty"><b><: You have no mailboxes yet :></b><span><: Make the first one below. :></span></div>
            <% endif %>
        </div>

        <div class="mb-box">
            <h4><: Make a mailbox :></h4>
            <% if QuotaLimit %>
            <% if DomainList %>
            <form action="./?module=mailboxes&amp;action=AddMailbox" method="post" class="mb-create">
                <div class="mb-grid">
                    <div><label class="mb-label" for="inAddress"><: Address :></label>
                        <div class="mb-addrfield"><input class="form-control" type="text" name="inAddress" id="inAddress" value="<@ PostedAddress @>" placeholder="<: name :>" autocomplete="off" spellcheck="false" required>
                            <select class="form-control" name="inDomain" id="inDomain" aria-label="<: Domain :>"><@ DomainOptions @></select></div></div>
                    <div><label class="mb-label" for="inNewPassword"><: Password :></label>
                        <div class="mb-pass"><input class="form-control" type="password" name="inPassword" id="inNewPassword" autocomplete="new-password" required>
                            <button type="button" class="btn btn-default mb-show" data-show="<: Show :>" data-hide="<: Hide :>"><: Show :></button>
                            <button type="button" class="btn btn-default mb-gen" data-len="<@ MinPassLength @>"><: Make one :></button></div>
                        <ul class="mb-rules" data-len="<@ MinPassLength @>"><li data-rule="lower"><: A lower case letter :></li><li data-rule="upper"><: A capital letter :></li><li data-rule="digit"><: A digit :></li><li data-rule="len"><@ MinPassLength @> <: characters or more :></li></ul></div>
                </div>
                <div class="mb-foot"><@ CSFR_Tag @><button class="btn btn-primary" type="submit" name="inCreate" value="inCreate"><: Make mailbox :></button>
                    <span class="mb-sub"><: Note the password: the panel keeps no copy. Mail programs use the full address as the user name. :></span></div>
            </form>
            <% else %>
            <div class="mb-limit"><: Add a domain first in Domains: a mailbox is always at one of your domains. :></div>
            <% endif %>
            <% else %>
            <div class="mb-limit"><: You have as many mailboxes as your package allows. Delete one, or ask your host for a bigger package. :></div>
            <% endif %>
        </div>
        <% endif %>
    </div>
</div>
<script>
(function () {
    'use strict';
    var mb = document.getElementById('mb'); if (!mb) { return; }
    var each = function (root, sel, fn) { Array.prototype.forEach.call(root.querySelectorAll(sel), fn); };
    // password fields: Show, Make one (the browser's secure random numbers) and the rules ticked as you type
    each(mb, '.mb-pass', function (box) {
        var pw = box.querySelector('input'), show = box.querySelector('.mb-show'), gen = box.querySelector('.mb-gen');
        var rules = box.parentNode.querySelector('.mb-rules');
        var vis = function (on) { pw.type = on ? 'text' : 'password'; show.textContent = show.getAttribute(on ? 'data-hide' : 'data-show'); };
        var tick = function () {
            if (!rules) { return; }
            var v = pw.value, ok = { lower: /[a-z]/.test(v), upper: /[A-Z]/.test(v), digit: /[0-9]/.test(v), len: v.length >= parseInt(rules.getAttribute('data-len'), 10) };
            rules.classList.toggle('idle', v === '');
            each(rules, 'li', function (li) { li.classList.toggle('ok', !!ok[li.getAttribute('data-rule')]); });
        };
        show.addEventListener('click', function () { vis(pw.type === 'password'); });
        gen.addEventListener('click', function () {
            var chars = 'abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789', len = Math.max(16, parseInt(gen.getAttribute('data-len'), 10) || 0), out, buf = new Uint32Array(1), lim = Math.floor(4294967296 / chars.length) * chars.length;
            do { out = ''; while (out.length < len) { window.crypto.getRandomValues(buf); if (buf[0] < lim) { out += chars.charAt(buf[0] % chars.length); } } }
            while (!/[a-z]/.test(out) || !/[A-Z]/.test(out) || !/[0-9]/.test(out));
            pw.value = out; vis(true); tick(); pw.select();
        });
        pw.addEventListener('input', tick); tick();
    });
    var rows = mb.querySelectorAll('.mb-row'), find = mb.querySelector('.mb-find');
    if (find && rows.length > 6) {
        find.hidden = false;
        find.addEventListener('input', function () {
            var q = find.value.trim().toLowerCase(), n = 0;
            Array.prototype.forEach.call(rows, function (r) { var on = q === '' || r.getAttribute('data-s').indexOf(q) >= 0; r.hidden = !on; if (on) { n++; } });
            mb.querySelector('.mb-nomatch').hidden = n > 0;
        });
    }
    each(mb, 'form', function (f) { f.addEventListener('submit', function () { if (window.Sentora && Sentora.loader) { Sentora.loader.showLoader(); } }); });
})();
</script>
