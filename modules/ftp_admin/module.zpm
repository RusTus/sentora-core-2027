<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><: The FTP server (ProFTPD): whether it runs, every FTP account on the server, and how clients connect. :></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/ftp_admin/assets/ftpadmin.css">

    <div class="fa" id="fa">
        <div class="fa-tiles"><@ Tiles @></div>
        <div class="fa-cols">
            <div class="fa-box">
                <div class="fa-head"><h4><: All FTP accounts :></h4>
                    <% if HasAccounts %><input type="search" class="form-control fa-find" id="fa-find" placeholder="<: Search account, client or folder :>" aria-label="<: Search FTP accounts :>"><% endif %></div>
                <% if HasAccounts %>
                <div class="fa-table"><table><thead><tr><th><: FTP account :></th><th><: Client :></th><th><: Folder :></th><th><: May :></th><th><: Added :></th></tr></thead>
                    <tbody id="fa-rows"><@ AccountRows @></tbody></table></div>
                <p class="fa-sub fa-nomatch" id="fa-nomatch" hidden><: No FTP account matches. :></p>
                <% endif %>
                <% if NoAccounts %><p class="fa-sub"><: No client has an FTP account yet. They make them in FTP Accounts. :></p><% endif %>
            </div>
            <aside class="fa-side">
                <div class="fa-box">
                    <h4><: How clients connect :></h4>
                    <dl class="fa-dl"><dt><: Server :></dt><dd><code><@ Server @></code></dd><dt><: Port :></dt><dd><code>21</code></dd>
                        <dt><: Encryption :></dt><dd><: Explicit FTP over TLS (FTPS), with the panel's certificate :></dd><dt><: Passive ports :></dt><dd><code>60000-65535</code></dd></dl>
                    <p class="fa-sub"><: Read only and Upload only are applied by the daemon within 5 minutes of a change, as rules in ProFTPD's ftp-access.conf. The FTP logs are in the System Log Viewer. :></p>
                </div>
                <form class="fa-box" action="./?module=ftp_admin&amp;action=UpdateConfig" method="post">
                    <h4><: Settings :></h4>
                    <@ SettingFields @>
                    <button class="btn btn-primary" type="submit" name="inSaveSystem"><: Save settings :></button>
                    <@ CSFR_Tag @>
                </form>
            </aside>
        </div>
    </div>
</div>
<script>
(function () {
    'use strict';
    var find = document.getElementById('fa-find'); if (!find) { return; }
    var rows = document.querySelectorAll('#fa-rows tr');
    find.addEventListener('input', function () {
        var q = find.value.trim().toLowerCase(), n = 0;
        Array.prototype.forEach.call(rows, function (r) { var on = q === '' || r.getAttribute('data-s').indexOf(q) >= 0; r.hidden = !on; if (on) { n++; } });
        document.getElementById('fa-nomatch').hidden = n > 0;
    });
})();
</script>
