<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><: The PHP versions on this server, and which of them domains may choose in Domains and Sub Domains. :></div>
    </div>
    <@ Result @>
    <style>
    .pv { background: var(--sn-soft, #f4f6f9); border-radius: 8px; padding: 18px; margin-top: 10px; color: var(--sn-ink, #1f2933); }
    .pv * { box-sizing: border-box; }
    .pv-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
    .pv-card { background: var(--sn-card, #fff); border-radius: 6px; box-shadow: 0 1px 3px rgba(20,30,40,0.08); padding: 14px 16px; border-top: 3px solid var(--sn-accent, #447fb3); display: flex; flex-direction: column; gap: 8px; }
    .pv-card.is-default { border-top-color: var(--sn-ok, #1e8a4c); }
    .pv-card.is-off { border-top-color: var(--sn-line-strong, #cfd6de); }
    .pv-card.is-off .pv-ver { color: var(--sn-muted, #6b7785); }
    .pv-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .pv-ver { font-size: 20px; font-weight: 700; }
    .pv-tag { font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 9px; background: var(--sn-ok-soft, #e3f4ea); color: var(--sn-ok, #1e8a4c); }
    .pv-card p { margin: 0; font-size: 13px; line-height: 1.45; color: var(--sn-muted, #6b7785); }
    .pv-meta { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; margin-top: auto; font-size: 12px; color: var(--sn-muted, #6b7785); }
    .pv-sup { font-weight: 600; padding: 1px 8px; border-radius: 9px; }
    .pv-sup.ok { background: var(--sn-ok-soft, #e3f4ea); color: var(--sn-ok, #1e8a4c); }
    .pv-sup.warn { background: var(--sn-warn-soft, #fdf1dc); color: var(--sn-warn, #a86b00); }
    .pv-sup.bad { background: var(--sn-bad-soft, #fbe3e2); color: var(--sn-bad, #c62f2b); }
    .pv-svc { display: inline-flex; align-items: center; gap: 5px; }
    .pv-svc i { width: 8px; height: 8px; border-radius: 50%; background: var(--sn-line-strong, #cfd6de); }
    .pv-svc.ok i { background: var(--sn-ok, #1e8a4c); }
    .pv-svc.bad i { background: var(--sn-bad, #c62f2b); }
    .pv-foot { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 14px; padding: 14px 16px; background: var(--sn-card, #fff); border-radius: 6px; box-shadow: 0 1px 3px rgba(20,30,40,0.08); }
    .pv-foot p { flex: 1 1 300px; margin: 0; font-size: 12px; color: var(--sn-muted, #6b7785); line-height: 1.5; }
    .pv-foot code { font-size: 11px; }
    @media (max-width: 640px) { .pv { padding: 12px; } .pv-foot .btn { width: 100%; } }
    .pv-card.is-legacy { border-top-color: var(--sn-warn, #a86b00); }
    .pv-tag.pv-legacy { background: var(--sn-warn-soft, #fdf1dc); color: var(--sn-warn, #a86b00); }
    .pv-legacy-note { color: var(--sn-warn, #a86b00) !important; }
    .pv-sub { font-size: 12px; color: var(--sn-muted, #6b7785); }
    .pv-old { margin-top: 14px; padding: 16px 18px; background: var(--sn-card, #fff); border-radius: 6px; box-shadow: 0 1px 3px rgba(20,30,40,0.08); border-top: 3px solid var(--sn-warn, #a86b00); color: var(--sn-ink, #1f2933); }
    .pv-old.is-clean { border-top-color: var(--sn-ok, #1e8a4c); }
    .pv-old h4 { margin: 0 0 4px; font-size: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; }
    .pv-old-sec { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--sn-line, #e6e9ee); }
    .pv-old-sec p { margin: 6px 0; font-size: 13px; line-height: 1.45; color: var(--sn-muted, #6b7785); }
    .pv-old-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .pv-old-head code { font-size: 11px; }
    .pv-old-rows { display: grid; gap: 6px; margin-top: 8px; }
    .pv-old-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 10px; border: 1px solid var(--sn-line, #e6e9ee); border-radius: 6px; flex-wrap: wrap; }
    .pv-old-why { font-size: 12px; color: var(--sn-warn, #a86b00); }
    .pv-old-why.ok { color: var(--sn-ok, #1e8a4c); }
    .pv-old-fail { color: var(--sn-bad, #c62f2b); font-weight: 600; }
    .pv-old-list { font-family: monospace; font-size: 12px; overflow-wrap: anywhere; }
    </style>
    <form class="pv" action="./?module=php_versions&amp;action=SaveVersions" method="post">
        <div class="pv-cards"><@ VersionCards @></div>
        <div class="pv-foot">
            <% if HasExtra %><p><: A domain can only choose a version that is switched on. Switching one off keeps each domain's choice: they run on the default until it is switched on again. :></p>
            <button class="btn btn-primary" type="submit" name="SaveVersions" value="1"><: Save :></button><% endif %>
            <% if NoExtra %><p><: No extra PHP versions are installed. The installer adds them; on this server, as root: :> <code>sentora-php-install 8.4</code></p><% endif %>
        </div>
        <@ LegacyHint @>
        <@ CSFR_Tag @>
    </form>
    <@ BundleUpdates @>
    <@ OldLogins @>
</div>
<script>
// switching on a version kept only for moving old sites asks first
Array.prototype.forEach.call(document.querySelectorAll('.pv-old button[data-confirm]'), function (b) {
    b.addEventListener('click', function (e) { if (!window.confirm(b.getAttribute('data-confirm'))) { e.preventDefault(); } });
});
Array.prototype.forEach.call(document.querySelectorAll('input[data-confirm]'), function (box) {
    box.addEventListener('change', function () {
        if (box.checked && !window.confirm(box.getAttribute('data-confirm'))) { box.checked = false; }
    });
});
</script>
