<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <@ result @>
    <link rel="stylesheet" href="modules/repo_browser/assets/repo.css">

    <div class="rb" id="rb" data-queued="<: Queued :>" data-installed="<: Installed :>" data-not="<: Not installed :>" data-remove="<@ RemoveConfirm @>" data-update="<: Update available :>" data-pending="<% if UpdatePending %>1<% endif %>"
        data-modules="<: %s modules :>" data-new="<: %s new :>" data-ok="<: Repository appears to be valid. :>" data-bad="<: Repository seems to be invalid or offline. Retry fetches its package list again. :>"
        data-checking="<: Checking your repositories :>" data-newtitle="<: New in your repositories :>" data-uptodate="<: Your module list is up to date with every repository. :>"
        data-waitlist="<: The daemon is reading the repositories' lists again (within 5 minutes): reload the page, then install them from Available. :>"
        data-needlist="<: Click Check all repositories now: the daemon reads their lists again within 5 minutes, then you can install them from Available. :>"
        data-gone="<: No longer offered by its repository: :>" data-installed-already="<: already installed :>">
    <@ ZppyOut @>

    <% if isConfirmDeleteRepo %>
    <form class="rb-confirm danger" action="./?module=repo_browser&amp;action=ConfirmDeleteRepo" method="post">
        <h4><: Remove the repository :> <code><@ CurrentRepo @></code>?</h4>
        <p><: Modules already installed from it stay installed, but they are no longer listed here: manage them in Module Admin. :></p>
        <label class="rb-check"><input type="checkbox" name="inDebugZPPY" value="1"> <: Show the ZPPY client's output :></label>
        <div class="rb-confirm-foot"><input type="hidden" name="inDelete" value="<@ CurrentRepo @>">
            <button class="btn btn-danger" type="submit"><: Remove :></button> <a class="btn btn-default" href="./?module=repo_browser"><: Cancel :></a></div>
        <@ CSFR_Tag @>
    </form>
    <% endif %>

    <% if isConfirmAddRepo %>
    <form class="rb-confirm warn" action="./?module=repo_browser&amp;action=ConfirmAddRepo" method="post">
        <h4><: The repository could not be checked: :> <code><@ CurrentRepo @></code></h4>
        <p><: It does not look like a module repository, or it is offline right now. You can add it anyway and try again later. :></p>
        <label class="rb-check"><input type="checkbox" name="inDebugZPPY" value="1"> <: Show the ZPPY client's output :></label>
        <div class="rb-confirm-foot"><input type="hidden" name="inConfirmAddRepo" value="<@ CurrentRepo @>">
            <button class="btn btn-primary" type="submit"><: Add it anyway :></button> <a class="btn btn-default" href="./?module=repo_browser"><: Cancel :></a></div>
        <@ CSFR_Tag @>
    </form>
    <% endif %>

    <% if isConfirmDeleteModule %>
    <form class="rb-confirm danger" action="./?module=repo_browser&amp;action=ConfirmDeleteModule" method="post">
        <h4><: Remove the module :> <code><@ CurrentModuleName @></code>?</h4>
        <p><: The module is removed from this server, with its files. :></p>
        <label class="rb-check"><input type="checkbox" name="inDebugZPPY" value="1"> <: Show the ZPPY client's output :></label>
        <div class="rb-confirm-foot"><input type="hidden" name="inDelete" value="<@ CurrentModuleFull @>">
            <button class="btn btn-danger" type="submit"><: Remove :></button> <a class="btn btn-default" href="./?module=repo_browser"><: Cancel :></a></div>
        <@ CSFR_Tag @>
    </form>
    <% endif %>

    <% if isConfirmInstallModule %>
    <form class="rb-confirm" action="./?module=repo_browser&amp;action=ConfirmInstallModule" method="post">
        <h4><: Install the module :> <code><@ CurrentModuleName @></code>?</h4>
        <p><: The daemon downloads and installs it within 5 minutes; when the repository has a SHA256SUMS file the download is checked against it first. :></p>
        <label class="rb-check"><input type="checkbox" name="inDebugZPPY" value="1"> <: Show the ZPPY client's output :></label>
        <div class="rb-confirm-foot"><input type="hidden" name="inInstall" value="<@ CurrentModuleFull @>">
            <button class="btn btn-primary" type="submit"><: Install :></button> <a class="btn btn-default" href="./?module=repo_browser"><: Cancel :></a></div>
        <@ CSFR_Tag @>
    </form>
    <% endif %>

    <% if isConfirmUpdateVersionDB %>
    <form class="rb-confirm" action="./?module=repo_browser&amp;action=ConfirmUpdateVersionDB" method="post">
        <h4><: Correct the version number of :> <code><@ CurrentModuleName @></code>?</h4>
        <p><: The panel's database says version :> <b><@ CurrentModuleInstalledVersion @></b>; <: the module's own file says :> <b><@ CurrentModuleVersion @></b>. <: The database is set to the module's number. :></p>
        <div class="rb-confirm-foot"><input type="hidden" name="inUpdate" value="<@ CurrentModuleName @>"><input type="hidden" name="inVersion" value="<@ CurrentModuleVersion @>">
            <button class="btn btn-primary" type="submit"><: Correct it :></button> <a class="btn btn-default" href="./?module=repo_browser"><: Cancel :></a></div>
        <@ CSFR_Tag @>
    </form>
    <% endif %>

    <% if isConfirmUpdateModule %>
    <form class="rb-confirm" action="./?module=repo_browser&amp;action=ConfirmUpdateModule" method="post">
        <h4><: Update the module :> <code><@ CurrentModuleName @></code>?</h4>
        <p><: The daemon installs the repository's newer version within 5 minutes. :></p>
        <label class="rb-check"><input type="checkbox" name="inDebugZPPY" value="1"> <: Show the ZPPY client's output :></label>
        <div class="rb-confirm-foot"><input type="hidden" name="inUpdate" value="<@ CurrentModuleFull @>">
            <button class="btn btn-primary" type="submit"><: Update :></button> <a class="btn btn-default" href="./?module=repo_browser"><: Cancel :></a></div>
        <@ CSFR_Tag @>
    </form>
    <% endif %>

    <% if isMain %>
    <!-- Modules -->
    <div class="rb-card rb-modules">
        <div class="rb-head"><div><h4><: Modules :></h4>
            <p class="rb-sub"><% if TotalPackages %><b><@ totalpackages @></b> <: modules in your repositories. :><% endif %> <: Changes are made by the daemon within 5 minutes. :></p></div>
            <div class="rb-tools">
            <form class="rb-checkall" action="./?module=repo_browser&amp;action=CheckAll" method="post">
                <button class="btn btn-default btn-sm" type="submit" title="<: Ask every repository now for its modules and their latest versions, and have the daemon read the lists again. :>"><: Check all repositories now :></button>
                <@ CSFR_Tag @>
            </form>
            <input type="search" class="form-control rb-find" placeholder="<: Find a module :>" aria-label="<: Find a module :>"></div></div>
        <div class="rb-scan" aria-live="polite" hidden>
            <div class="rb-scan-head"><span class="rb-wait short"></span> <b class="rb-scan-title"></b> <span class="rb-scan-count rb-sub"></span></div>
            <ul class="rb-new"></ul>
            <p class="rb-sub rb-scan-note" hidden></p>
            <p class="rb-sub rb-gone" hidden></p>
        </div>
        <% if ModuleList %>
        <div class="rb-tabs" role="tablist">
            <button type="button" class="rb-tab" role="tab" data-tab="installed"><: Installed :> <span class="rb-count"></span></button>
            <button type="button" class="rb-tab" role="tab" data-tab="update" hidden><: Updates :> <span class="rb-count"></span></button>
            <button type="button" class="rb-tab" role="tab" data-tab="notinstalled"><: Available :> <span class="rb-count"></span></button>
            <span class="rb-checking rb-sub" hidden><span class="rb-wait short"></span> <: Checking for updates :></span>
            <form class="rb-all" action="./?module=repo_browser&amp;action=UpdateAll" method="post" data-ask="<: Update every module in this list? :>" hidden>
                <input type="hidden" name="inUpdateAll" value="">
                <button type="submit" class="btn btn-primary btn-sm"><: Update all :> (<span class="rb-all-n"></span>)</button>
                <@ CSFR_Tag @>
            </form>
        </div>
        <form action="./?module=repo_browser&amp;action=DeleteModule" method="post">
            <div class="rb-list">
            <% loop ModuleList %>
            <div class="rb-row" data-tab="<& installed &>" data-s="<& modulename &> <& reponame &>" hidden>
                <div class="rb-row-main">
                    <div class="rb-row-name"><b><& installedhtml &></b><span class="rb-state"></span></div>
                    <div class="modinfo" item_id="<& reponame &>:::<& modulename &>"><span class="rb-wait wide"></span></div>
                    <div class="update" item_id="<& reponame &>:::<& modulename &>"></div>
                    <& ratehtml &>
                    <div class="rb-review-box" hidden></div>
                </div>
                <div class="rb-row-side">
                    <span class="controls" item_id="M:::<& url &>"></span>
                    <span class="repostats" item_id="<& reponame &>:::<& modulename &>"></span>
                    <span class="rb-repo" title="<: Repository :>: <& reponame &>"><& reponame &></span>
                    <a class="rb-dl" href="<& url &>" title="<: Download the package :>">.zpp &darr;</a>
                </div>
                <div class="rb-row-act"><button class="<& buttoncss &>" type="submit" <& buttonattr &> title="<& title &>" name="in<& buttonaction &>Module" value="<& reponame &>:::<& modulename &>"><& buttonlabel &></button></div>
            </div>
            <% endloop %>
            </div>
            <p class="rb-empty rb-none" data-installed="<: No modules from your repositories are installed yet: see Available. :>" data-update="<: Every installed module is up to date. :>" data-notinstalled="<: Every module in your repositories is installed. :>" data-find="<: No modules match your search. :>" hidden></p>
            <div class="rb-pager" hidden>
                <button type="button" class="btn btn-default btn-sm rb-prev" aria-label="<: Previous page :>">&lsaquo;</button>
                <span class="rb-range"></span> <: of :> <b class="rb-total"></b>
                <button type="button" class="btn btn-default btn-sm rb-next" aria-label="<: Next page :>">&rsaquo;</button>
            </div>
            <@ CSFR_Tag @>
        </form>
        <!-- the ratings' own form: the "Rate it" boxes' fields belong to it (form="rb-rate") -->
        <form id="rb-rate" action="./?module=repo_browser&amp;action=RateModule" method="post"><@ CSFR_Tag @></form>
        <% else %>
        <p class="rb-empty"><: No modules to show yet: add a repository below, then wait a few minutes for its list. :></p>
        <% endif %>
    </div>

    <!-- Repositories -->
    <div class="rb-card">
        <div class="rb-head"><div><h4><: Repositories :></h4>
            <p class="rb-sub"><@ RepoFormatHint @></p></div></div>
        <% if RepoList %>
        <form action="./?module=repo_browser&amp;action=DeleteRepo" method="post">
            <div class="rb-repos">
            <% loop RepoList %>
            <div class="rb-repo-row"><span class="rb-repo-state"><& statushtml &></span><code><& line &></code><span class="rb-repo-act"><& buttonshtml &></span></div>
            <% endloop %>
            </div>
            <@ CSFR_Tag @>
        </form>
        <% else %>
        <p class="rb-empty"><: You have no repositories yet. :></p>
        <% endif %>
        <form class="rb-add" action="./?module=repo_browser&amp;action=AddRepo" method="post">
            <input class="form-control" name="inAddRepo" type="text" id="inAddRepo" placeholder="https://raw.githubusercontent.com/RusTus/sentora-installers-2027/master2027/sentora-repo" autocomplete="off">
            <button class="btn btn-primary" type="submit" name="inSubmit" value=""><: Add repository :></button>
            <@ CSFR_Tag @>
        </form>
    </div>

    <!-- Recent commands -->
    <div class="rb-card">
        <div class="rb-head"><div><h4><: Recent ZPPY commands :></h4>
            <p class="rb-sub"><: Modules are installed and removed by root, not by the panel: each change is queued and the daemon runs it within 5 minutes. Reload the page to see the result. :></p></div>
            <a class="btn btn-default btn-sm" href="./?module=repo_browser"><: Reload :></a></div>
        <div class="rb-scroll"><table class="rb-table"><thead><tr><th><: Queued :></th><th><: Command :></th><th><: Status :></th><th><: Output :></th></tr></thead><tbody><@ QueueRows @></tbody></table></div>
    </div>

    <!-- ZPPY client -->
    <div class="rb-card">
        <div class="rb-head"><div><h4><: ZPPY client :></h4><p class="rb-sub"><: Run a ZPPY command by hand. :></p></div></div>
        <form class="rb-zppy" action="./?module=repo_browser&amp;action=RunZPPYCommand" method="post">
            <span class="rb-prompt">zppy</span><input class="form-control" name="inRunZPPYCommand" type="text" id="inRunZPPYCommand" placeholder="install modulename" autocomplete="off">
            <button class="btn btn-primary" type="submit" name="inSubmit" value=""><: Run :></button>
            <@ CSFR_Tag @>
        </form>
        <dl class="rb-usage">
            <dt>install <i>module</i></dt><dd><: Install a module. :></dd>
            <dt>upgrade <i>module</i></dt><dd><: Update a module. :></dd>
            <dt>remove <i>module</i></dt><dd><: Remove a module. :></dd>
            <dt>update</dt><dd><: Read the module lists of the repositories again. :></dd>
            <dt>repo add <i>address</i></dt><dd><: Add a repository. :></dd>
            <dt>repo remove <i>address</i></dt><dd><: Remove a repository. :></dd>
            <dt>repo list</dt><dd><: List the repositories. :></dd>
            <dt>checkperms</dt><dd><: Check the permissions of the cache files. :></dd>
            <dt>--version</dt><dd><: Show the version. :></dd>
            <dt>--help</dt><dd><: Show the help. :></dd>
        </dl>
    </div>

    <!-- Developer notes -->
    <details class="rb-card rb-notes">
        <summary><: Notes for module developers :></summary>
        <ul>
            <li><: A module with the same folder name as one of the panel's own modules is not listed, and can not be installed over, updated or removed from here. This is by design. :></li>
            <li><: A repository is a web folder holding packages.txt (one module folder name per line), for each module name.zpp (a zip of the module folder) and optionally name.xml, and SHA256SUMS: when it is there, every download is checked against it and a module that does not match is not installed. The Sentora-2027 add-ons are at https://raw.githubusercontent.com/RusTus/sentora-installers-2027/master2027/sentora-repo. :></li>
            <li><@ RepoStatsHint @></li>
            <li><: A module that is not installed yet is described from name.xml in the repository, with the same tags as module.xml: :></li>
        </ul>
<pre class="rb-out">&lt;updateserver&gt;
    &lt;latestversion&gt;100&lt;/latestversion&gt;
    &lt;downloadurl&gt;https://example.com/repo/my_module.zpp&lt;/downloadurl&gt;
    &lt;desc&gt;What the module does.&lt;/desc&gt;
    &lt;updatedesc&gt;What changed in this version.&lt;/updatedesc&gt;
    &lt;ostype&gt;all&lt;/ostype&gt;              (win, lin or all)
    &lt;authorname&gt;Your name&lt;/authorname&gt;
    &lt;authoremail&gt;you@example.com&lt;/authoremail&gt;
    &lt;authorurl&gt;https://example.com&lt;/authorurl&gt;
&lt;/updateserver&gt;</pre>
    </details>
    <% endif %>
    </div>
</div>
<script>
(function ($) {
    'use strict';
    var id = '<@ ZPanelID @>', base = 'modules/repo_browser/code/ajax.php?id=' + encodeURIComponent(id);
    var load = function (sel, param, done) {
        $(sel).each(function () {
            var el = $(this);
            el.load(base + '&' + param + '=' + encodeURIComponent(el.attr('item_id')), function () { if (done) { done(el); } });
        });
    };
    var esc = function (t) { return $('<div>').text(t == null ? '' : String(t)).html(); };
    var rbx = $('#rb'), say = function (k, n) { return (rbx.attr('data-' + k) || '').replace('%s', n); };

    // Each repository is asked as the page is drawn (a few at a time): does it answer, how many
    // modules it has, and which ones are new since the panel last read its list.
    var scan = $('.rb-scan'), newList = scan.find('.rb-new'), gone = [], newCount = 0;
    var repoRows = $('.rb-repo-row .controls').toArray(), scanBusy = 0, scanned = 0, scanTotal = repoRows.length;
    var scanDone = function () {
        scan.find('.rb-wait').remove();
        scan.find('.rb-scan-count').text('');
        if (newCount) {
            scan.find('.rb-scan-title').text(say('newtitle') + ' (' + newCount + ')');
            scan.find('.rb-scan-note').text(say(rbx.attr('data-pending') === '1' ? 'waitlist' : 'needlist')).removeAttr('hidden');
        } else {
            scan.find('.rb-scan-title').text(say('uptodate'));
            scan.addClass('is-ok');
        }
        if (gone.length) { scan.find('.rb-gone').text(say('gone') + ' ' + gone.join(', ')).removeAttr('hidden'); }
    };
    var scanNext = function () {
        if (!repoRows.length) { if (!scanBusy) { scanDone(); } return; }
        var el = $(repoRows.shift()), repo = (el.attr('item_id') || '').replace(/^R:::/, '');
        scanBusy++;
        $.ajax({ url: base + '&scan=' + encodeURIComponent(repo), dataType: 'json', timeout: 60000 }).always(function (r) {
            scanBusy--; scanned++;
            scan.find('.rb-scan-count').text(scanned + ' / ' + scanTotal);
            if (r && r.ok) {
                el.html('<span class="label label-success" title="' + esc(say('ok')) + '">OK</span> <span class="rb-sub">' + esc(say('modules', r.count)) + '</span>'
                    + (r['new'].length ? ' <span class="label label-info">' + esc(say('new', r['new'].length)) + '</span>' : ''));
                $.each(r['new'], function (i, m) {
                    newCount++;
                    newList.append('<li><b>' + esc(m.name) + '</b>' + (m.version ? ' <span class="rb-sub">' + esc(m.version) + '</span>' : '')
                        + (m.installed ? ' <span class="label label-default">' + esc(say('installed-already')) + '</span>' : '')
                        + (m.desc ? '<span class="rb-new-desc">' + esc(m.desc) + '</span>' : '') + '<span class="rb-sub rb-new-repo">' + esc(repo) + '</span></li>');
                });
                $.each(r.gone || [], function (i, m) { gone.push(m); });
            } else {
                el.html('<span class="label label-danger" title="' + esc(say('bad')) + '">FAILED</span>');
                // a repository that can not be reached: offer Retry beside Remove
                el.closest('.rb-repo-row').find('.retry-repo').show();
            }
            scanNext();
        });
    };
    if (scanTotal) {
        scan.removeAttr('hidden').find('.rb-scan-title').text(say('checking'));
        for (var k = 0; k < 3; k++) { scanNext(); }
    }

    // Modules: one tab each for installed, updates and available, a page at a time. A row's
    // details come from the repository, so they are fetched only when the row is first shown.
    var rb = $('#rb'), rows = $('.rb-row'), PAGE = 25, tab = null, page = 0, query = '';
    var fill = function (row) {
        if (row.data('filled')) { return; }
        row.data('filled', true);
        row.find('.modinfo').each(function () { $(this).load(base + '&modinfo=' + encodeURIComponent($(this).attr('item_id'))); });
        row.find('.controls').each(function () { $(this).load(base + '&request=' + encodeURIComponent($(this).attr('item_id'))); });
        row.find('.repostats').each(function () { $(this).load(base + '&repostat=' + encodeURIComponent($(this).attr('item_id'))); });
    };
    var inTab = function (row, t) { return t === 'update' ? row.hasClass('has-update') : row.attr('data-tab') === t; };
    var matches = function (row) { return query === '' || (row.attr('data-s') || '').toLowerCase().indexOf(query) >= 0; };
    var show = function () {
        var list = rows.filter(function () { var r = $(this); return inTab(r, tab) && matches(r); });
        var pages = Math.max(1, Math.ceil(list.length / PAGE));
        if (page >= pages) { page = pages - 1; }
        rows.attr('hidden', true);
        list.slice(page * PAGE, page * PAGE + PAGE).removeAttr('hidden').each(function () { fill($(this)); });
        $('.rb-tab').each(function () {
            var b = $(this), t = b.attr('data-tab');
            b.toggleClass('active', t === tab).attr('aria-selected', t === tab ? 'true' : 'false');
            b.find('.rb-count').text(rows.filter(function () { var r = $(this); return inTab(r, t) && matches(r); }).length);
        });
        var none = $('.rb-none');
        none.text(none.attr(query !== '' ? 'data-find' : 'data-' + tab)).attr('hidden', list.length ? true : null);
        $('.rb-pager').attr('hidden', list.length > PAGE ? null : true);
        $('.rb-range').text(list.length ? (page * PAGE + 1) + '–' + Math.min(list.length, page * PAGE + PAGE) : '0');
        $('.rb-total').text(list.length);
        $('.rb-prev').prop('disabled', page === 0);
        $('.rb-next').prop('disabled', page >= pages - 1);
    };
    var go = function (t) {
        tab = t; page = 0; show();
        try { sessionStorage.setItem('rb-tab', t); } catch (e) {}
    };
    $('.rb-tab').on('click', function () { go($(this).attr('data-tab')); });
    $('.rb-prev').on('click', function () { if (page > 0) { page--; show(); } });
    $('.rb-next').on('click', function () { page++; show(); });
    $('.rb-find').on('input', function () { query = $.trim($(this).val()).toLowerCase(); page = 0; show(); });

    // the repository as a short name; the full address stays in the tooltip
    $('.rb-row .rb-repo').each(function () {
        var t = $(this).text().replace(/^https?:\/\//i, ''), g = t.match(/^raw\.githubusercontent\.com\/([^\/]+\/[^\/]+)/i);
        $(this).text(g ? 'GitHub: ' + g[1] : t);
    });

    // each module's state beside its name
    rows.each(function () {
        var m = $(this), b = m.find('.rb-row-act button').first(), s = m.find('.rb-state');
        if (b.is(':disabled')) { s.text(rb.attr('data-queued')).addClass('label label-warning'); }
        else if (m.attr('data-tab') === 'installed') { s.text(rb.attr('data-installed')).addClass('label label-success'); }
        else { s.text(rb.attr('data-not')).addClass('label label-default'); }
    });

    if (rows.length) {
        var saved = null;
        try { saved = sessionStorage.getItem('rb-tab'); } catch (e) {}
        var installed = rows.filter('[data-tab=installed]');
        go(saved === 'installed' || saved === 'notinstalled' ? saved : (installed.length ? 'installed' : 'notinstalled'));

        // look for updates of every installed module, a few at a time; those with one get the Updates tab
        var queue = installed.toArray(), busy = 0, checking = $('.rb-checking');
        var next = function () {
            if (!queue.length) { if (!busy) { checking.attr('hidden', true); show(); } return; }
            var row = $(queue.shift()), u = row.find('.update');
            busy++;
            u.load(base + '&update=' + encodeURIComponent(u.attr('item_id')), function () {
                busy--;
                if ($.trim(u.html()) !== '') {
                    row.addClass('has-update');
                    $('.rb-tab[data-tab=update]').removeAttr('hidden');
                    row.find('.rb-state').text(rb.attr('data-update')).attr('class', 'rb-state label label-info');
                }
                allBtn();
                next();
            });
        };
        if (queue.length) { checking.removeAttr('hidden'); for (var i = 0; i < 4; i++) { next(); } }

        // "Update all" (on the Updates tab): every module found with an update, queued in one go
        var all = $('.rb-all');
        var allBtn = function () {
            var n = rows.filter('.has-update').length;
            all.find('.rb-all-n').text(n);
            all.attr('hidden', n > 0 && tab === 'update' ? null : true);
        };
        $('.rb-tab').on('click', allBtn);
        all.on('submit', function (e) {
            var list = rows.filter('.has-update').map(function () { return $(this).find('.update').attr('item_id'); }).get();
            if (!list.length || !window.confirm(all.attr('data-ask') + ' (' + list.length + ')')) { e.preventDefault(); e.stopImmediatePropagation(); return false; }
            all.find('[name=inUpdateAll]').val(list.join(','));
        });
    }

    // what other panels' administrators say about a module (loaded when asked)
    $(document).on('click', '.rb-reviews', function () {
        var box = $(this).closest('.rb-row').find('.rb-review-box');
        if (!box.attr('hidden')) { box.attr('hidden', true); return; }
        box.removeAttr('hidden').html('<span class="rb-wait short"></span>').load(base + '&reviews=' + encodeURIComponent($(this).attr('data-module')));
    });

    // removing asks first; the panel's "working" overlay while a form is sent
    $('#rb form').on('submit', function (e) {
        var btn = $(document.activeElement);
        if (btn.hasClass('rb-del') && !window.confirm($('#rb').attr('data-remove'))) { e.preventDefault(); return; }
        if (window.Sentora && Sentora.loader) { Sentora.loader.showLoader(); }
    });
})(jQuery);
</script>
