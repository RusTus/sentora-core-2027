<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/domains/assets/domains.css">

    <div class="dm" id="dm">
        <% if isDeleteDomain %>
        <form class="dm-box dm-confirm" action="./?module=domains&amp;action=DeleteDomain" method="post">
            <h4><svg class="dm-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg><: Delete the domain :> <code data-idn="<@ CurrentDomain @>"><@ CurrentDomain @></code>?</h4>
            <@ DeleteDetails @>
            <div class="dm-foot"><input type="hidden" name="inDelete" value="<@ CurrentID @>">
                <button class="btn btn-danger" type="submit"><: Delete :></button>
                <a class="btn btn-default" href="./?module=domains"><: Cancel :></a></div>
            <@ CSFR_Tag @>
        </form>
        <% endif %>

        <div class="dm-tiles"><@ Tiles @></div>

        <div class="dm-box">
            <div class="dm-head"><h4><: Your domains :></h4>
                <input type="search" class="form-control dm-find" placeholder="<: Find a domain :>" aria-label="<: Find a domain :>" hidden></div>
            <% if DomainList %>
            <form id="dm-delete" action="./?module=domains&amp;action=ConfirmDeleteDomain" method="post"><@ CSFR_Tag @></form>
            <div class="dm-list"><@ Cards @></div>
            <p class="dm-empty dm-nomatch" hidden><: No domain matches. :></p>
            <p class="dm-sub"><: A new domain or a change goes live at the next update of the web server, within an hour. www. works with every domain on its own. :></p>
            <% else %>
            <div class="dm-empty"><b><: You have no domains yet :></b><span><: Add your first one below. :></span></div>
            <% endif %>
        </div>

        <div class="dm-box">
            <h4><: Add a domain :></h4>
            <% if CreateDomain %>
            <form action="./?module=domains&amp;action=CreateDomain" method="post" class="dm-create">
                <div class="dm-fields">
                    <div>
                        <label class="dm-label" for="inDomainName"><: Domain name :></label>
                        <input class="form-control" name="inDomain" type="text" id="inDomainName" data-folder-from="1" value="<@ PostedDomain @>" placeholder="example.com" autocomplete="off" spellcheck="false" required>
                        <p class="dm-sub"><: Without www. A sub-domain such as shop.example.com is added in Sub Domains. :></p>
                    </div>
                    <% if HasPhpVersions %>
                    <div>
                        <label class="dm-label" for="inPhpVersion"><: PHP version :></label>
                        <select class="form-control" name="inPhpVersion" id="inPhpVersion"><@ PhpVersionOptions @></select>
                    </div>
                    <% endif %>
                </div>
                <span class="dm-label"><: Its files :></span>
                <div class="dm-choices">
                    <label class="dm-choice"><input type="radio" name="inAutoHome" value="1" checked><span><b><: A new folder :></b><small><code class="dm-newdir">public_html/…</code></small></span></label>
                    <label class="dm-choice"><input type="radio" name="inAutoHome" value="2"><span><b><: A folder that is already there :></b><small><: For example to move a site to a new name :></small></span></label>
                </div>
                <select class="form-control dm-existing" name="inDestination" aria-label="<: Folder :>" hidden><@ FolderOptions @></select>
                <div class="dm-foot"><@ CSFR_Tag @><button class="btn btn-primary" type="submit" name="CreateDomain" value="1"><: Add domain :></button>
                    <span class="dm-sub"><: Point the domain's name servers or A record at this server so visitors reach it. :></span></div>
            </form>
            <% else %>
            <div class="dm-limit"><: You have as many domains as your package allows. Delete one, or ask your host for a bigger package. :></div>
            <% endif %>
        </div>
    </div>
</div>
<script src="modules/domains/assets/punycode.js"></script>
<script src="modules/domains/assets/domains.js"></script>
