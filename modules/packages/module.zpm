<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><: A package sets a client's limits: how many domains, mailboxes and databases it can have, its disk space and bandwidth, and whether it can use PHP. :></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/packages/assets/packages.css">

    <div class="pk" id="pk">
        <% if IsList %>
        <div class="pk-box">
            <div class="pk-head"><h4><: Your packages :></h4>
                <a class="btn btn-primary pk-new" href="./?module=packages&amp;show=New"><svg class="pk-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><: New package :></a></div>
            <% if HasPackages %><div class="pk-cards"><@ PackageCards @></div><% endif %>
            <% if NoPackages %><div class="pk-empty"><b><: No packages yet :></b><span><: Every client is on a package. Make one before you make clients. :></span></div><% endif %>
        </div>
        <% endif %>

        <% if IsForm %>
        <a href="./?module=packages" class="btn btn-default btn-sm pk-back"><svg class="pk-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg><: All packages :></a>
        <form class="pk-form" id="pk-form" method="post" action="./?module=packages&amp;show=New&amp;action=<% if IsNew %>CreatePackage<% endif %><% if IsEdit %>UpdatePackage<% endif %>">
            <% if IsEdit %><input type="hidden" name="inPackageID" value="<@ FormId @>"><% endif %>
            <div class="pk-main">
                <h3 class="pk-h"><@ FormTitle @></h3>
                <div class="pk-box">
                    <h4><: Package :></h4>
                    <label class="pk-name"><span><: Name :></span><input class="form-control" type="text" name="inPackageName" value="<@ FormName @>" maxlength="30" required>
                        <small><: Clients see it in their panel. At most 30 characters. :></small></label>
                    <div class="pk-switchrow"><div><label for="inEnablePHP"><: PHP :></label><small><: Off: its websites serve plain files only. :></small></div>
                        <label class="pk-switch"><input type="checkbox" name="inEnablePHP" id="inEnablePHP" value="1"<@ FormPHPChecked @>><span class="pk-toggle"></span></label></div>
                </div>
                <div class="pk-box">
                    <h4><: Limits :></h4>
                    <p class="pk-sub"><: 0 means none; tick No limit for no limit. 1 GB is 1000 MB. :></p>
                    <div class="pk-fields"><@ LimitFields @></div>
                </div>
                <div class="pk-foot">
                    <button class="btn btn-primary" type="submit"><% if IsNew %><: Create package :><% endif %><% if IsEdit %><: Save changes :><% endif %></button>
                    <a class="btn btn-default" href="./?module=packages"><: Cancel :></a>
                </div>
            </div>
            <% if IsEdit %><aside class="pk-box pk-side"><h4><: Clients on it :></h4><@ PackageClients @></aside><% endif %>
            <@ CSFR_Tag @>
        </form>
        <% endif %>

        <% if IsDelete %>
        <form class="pk-box pk-confirm" action="./?module=packages&amp;action=DeletePackage" method="post">
            <h4><svg class="pk-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg><: Delete the package :> <code><@ DeleteName @></code>?</h4>
            <@ DeleteDetails @>
            <div class="pk-foot"><input type="hidden" name="inPackageID" value="<@ DeleteId @>">
                <% if CanDelete %><button class="btn btn-danger" type="submit"><: Delete package :></button><% endif %>
                <a class="btn btn-default" href="./?module=packages"><: Cancel :></a></div>
            <@ CSFR_Tag @>
        </form>
        <% endif %>
    </div>
</div>
<script>
(function () {
    'use strict';
    var form = document.getElementById('pk-form'); if (!form) { return; }
    Array.prototype.forEach.call(form.querySelectorAll('.pk-field'), function (f) {
        var unl = f.querySelector('.pk-unl input'), num = f.querySelector('input[type=number]'), unit = f.querySelector('select'), use = f.querySelector('.pk-use');
        var check = function () {
            // "highest use" turns into a warning when the new limit is below it
            if (!use) { return; }
            var v = parseFloat(num.value), lim = unl.checked || isNaN(v) ? Infinity : v * (unit && unit.value === 'GB' ? 1000 : 1);
            use.classList.toggle('over', lim < parseFloat(use.getAttribute('data-use')));
        };
        unl.addEventListener('change', function () {
            num.disabled = unl.checked; if (unit) { unit.disabled = unl.checked; }
            f.classList.toggle('is-unl', unl.checked);
            if (!unl.checked && num.value === '') { num.value = unit ? '1' : '0'; }
            if (!unl.checked) { num.focus(); }
            check();
        });
        num.addEventListener('input', check); if (unit) { unit.addEventListener('change', check); }
        check();
    });
})();
</script>
