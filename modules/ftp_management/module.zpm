<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><: FTP accounts let you, a web designer or a program upload and download your website's files. Each account sees only its own folder. :></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/ftp_management/assets/ftp.css">

    <div class="ft" id="ft">
        <% if IsList %>
        <div class="ft-tiles"><@ Tiles @></div>
        <div class="ft-cols">
            <div class="ft-box">
                <div class="ft-head"><h4><: FTP accounts :></h4>
                    <% if HasAccounts %><input type="search" class="form-control ft-find" id="ft-find" placeholder="<: Search :>" aria-label="<: Search FTP accounts :>" hidden><% endif %>
                    <% if AtLimit %><span class="ft-limit"><: Your package allows no more FTP accounts. :></span><% endif %>
                    <% if QuotaLimit %><a class="btn btn-primary ft-new" href="./?module=ftp_management&amp;show=New"><svg class="ft-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><: New FTP account :></a><% endif %>
                </div>
                <% if HasAccounts %><div class="ft-rows" id="ft-rows"><@ AccountRows @></div><p class="ft-nomatch" id="ft-nomatch" hidden><: No FTP account matches. :></p><% endif %>
                <% if NoAccounts %><div class="ft-empty"><b><: No FTP accounts yet :></b><span><: Make one to upload your website with an FTP program, or give a web designer access to one folder only. :></span></div><% endif %>
            </div>
            <aside class="ft-box ft-side"><h4><: Connect with :></h4><@ Connection @></aside>
        </div>
        <form id="ft-act" method="post" action="./?module=ftp_management&amp;action=EditFTP"><@ CSFR_Tag @></form>
        <% endif %>

        <% if IsForm %>
        <a href="./?module=ftp_management" class="btn btn-default btn-sm ft-back"><svg class="ft-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg><: All FTP accounts :></a>
        <form class="ft-form" id="ft-form" method="post" action="./?module=ftp_management&amp;show=New&amp;action=<% if IsNew %>CreateFTP<% endif %><% if IsEdit %>UpdateFTP<% endif %>">
            <% if IsEdit %><input type="hidden" name="inEditID" value="<@ FormId @>"><% endif %>
            <div class="ft-box">
                <h4><% if IsNew %><: New FTP account :><% endif %><% if IsEdit %><@ FormUser @><% endif %></h4>
                <% if IsNew %>
                <label class="ft-label" for="inFTPUsername"><: Name :></label>
                <div class="ft-user"><span><@ CurrentUserName @>_</span><input class="form-control" type="text" name="inFTPUsername" id="inFTPUsername" value="<@ FormUser @>" maxlength="40" pattern="[A-Za-z0-9_][A-Za-z0-9_-]*" required autocapitalize="none" spellcheck="false"></div>
                <small class="ft-help"><: Letters, digits, underscores and hyphens. :></small>
                <% endif %>
                <label class="ft-label" for="inPassword"><% if IsNew %><: Password :><% endif %><% if IsEdit %><: New password :> <small><: leave empty to keep the current one :></small><% endif %></label>
                <div class="ft-pass"><input class="form-control" type="password" name="inPassword" id="inPassword" autocomplete="new-password"<% if IsNew %> required<% endif %>>
                    <button type="button" class="btn btn-default ft-show" data-show="<: Show :>" data-hide="<: Hide :>"><: Show :></button>
                    <button type="button" class="btn btn-default ft-gen" data-len="<@ MinPassLength @>"><: Make one :></button></div>
                <ul class="ft-rules idle" data-len="<@ MinPassLength @>"><li data-rule="len"><: At least :> <@ MinPassLength @> <: characters :></li><li data-rule="lower"><: A lower case letter :></li><li data-rule="upper"><: A capital :></li><li data-rule="digit"><: A digit :></li></ul>
            </div>
            <div class="ft-box">
                <h4><: What it may do :></h4>
                <div class="ft-choices"><@ AccessChoices @></div>
            </div>
            <div class="ft-box">
                <h4><: Its folder :></h4>
                <p class="ft-sub"><: The account sees this folder and what is in it, nothing above it. :></p>
                <div class="ft-homes"><@ HomeChoices @></div>
            </div>
            <div class="ft-foot"><button class="btn btn-primary" type="submit"><% if IsNew %><: Create FTP account :><% endif %><% if IsEdit %><: Save changes :><% endif %></button>
                <a class="btn btn-default" href="./?module=ftp_management"><: Cancel :></a></div>
            <@ CSFR_Tag @>
        </form>
        <% endif %>

        <% if IsDelete %>
        <form class="ft-box ft-confirm" action="./?module=ftp_management&amp;action=DeleteFTP" method="post">
            <h4><svg class="ft-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg><: Delete the FTP account :> <code><@ DeleteName @></code>?</h4>
            <p><: It can no longer log in. Its folder :> <code><@ DeleteDir @></code> <: and the files in it stay where they are. :></p>
            <div class="ft-foot"><input type="hidden" name="inDelete" value="<@ DeleteId @>">
                <button class="btn btn-danger" type="submit"><: Delete FTP account :></button>
                <a class="btn btn-default" href="./?module=ftp_management"><: Cancel :></a></div>
            <@ CSFR_Tag @>
        </form>
        <% endif %>
    </div>
</div>
<script src="modules/ftp_management/assets/ftp.js"></script>
