<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">

        <div class="zmodule_title">
            <@ ModuleName @>
        </div>

        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>

    </div>

    <@ Result @>

    <% loop AccountSettings %>
    <% endloop %>

    <div class="zform_wrapper">
        <h2><: Enter your account details :></h2>
        <form action="./?module=my_account&action=UpdateAccountSettings" method="post">
            <table class="table table-striped">
                <tr>
                    <th><: Full name :>:</th>
                    <td><input name="inFullname" type="text" id="inFullname" size="40" value="<& fullname &>" /></td>
                </tr>
                <tr>
                    <th><: Email Address :>:</th>
                    <td><input name="inEmail" type="text" id="inEmail" size="40" value="<& email &>" /></td>
                </tr>
                <tr>
                    <th><: Phone Number :>:</th>
                    <td><input name="inPhone" type="text" id="inPhone" size="20" value="<& phone &>" /></td>
                </tr>
                <tr>
                    <th><: Choose Language :>:</th>
                    <td>
                        <select name="inLanguage" id="inLanguage" style="width:65px;">

                            <% loop LangList %>
                            <option value="<& language &>" <& selected &>><& language &></option>"
                            <% endloop %>

                        </select>
                    </td>
                </tr>
                <% loop AccountSettings %>
                <% endloop %>
                <tr>
                    <th><: Postal Address :>:</th>
                    <td><textarea name="inAddress" id="inAddress" cols="45" rows="5"><& address &></textarea></td>
                </tr>
                <tr>
                    <th><: Postal Code :>:</th>
                    <td><input name="inPostalCode" type="text" id="inPostalCode" size="15" value="<& postcode &>" /></td>
                </tr>
                <tr>
                    <th>&nbsp;</th>
                    <td align="right"><@ CSFR_Tag @><button class="button-loader btn btn-primary" id="button" type="submit" ><: Update Account :></button</td>
                </tr>
            </table>
        </form>
    </div>

    <% if AppearanceAvailable %>
    <div class="zform_wrapper">
        <h2><: Appearance :></h2>
        <form action="./?module=my_account&action=SetAppearance" method="post" class="form-inline">
            <table class="table table-striped">
                <tr>
                    <th><: Theme variation :>:</th>
                    <td>
                        <select name="inAppearance" id="inAppearance">
                            <% loop AppearanceList %>
                            <option value="<& value &>" <& selected &>><& label &></option>
                            <% endloop %>
                        </select>
                        <span class="help-block"><: Auto follows your computer's light or dark setting. Only you see this choice. :></span>
                    </td>
                </tr>
                <tr>
                    <th>&nbsp;</th>
                    <td align="right"><@ CSFR_Tag @><button class="button-loader btn btn-primary" type="submit"><: Save :></button></td>
                </tr>
            </table>
        </form>
    </div>
    <% endif %>

    <% if TwoFactorAvailable %>
    <div class="zform_wrapper">
        <h2><: Two-factor login :></h2>
        <% if TwoFactorOff %>
        <p><: Protect your login with a 6-digit code from an authenticator app (Google Authenticator, Microsoft Authenticator, Aegis, 1Password and others). :></p>
        <form action="./?module=my_account&action=TwoFactorBegin" method="post">
            <button class="btn btn-primary" type="submit"><: Set up two-factor login :></button>
            <@ CSFR_Tag @>
        </form>
        <% endif %>
        <% if TwoFactorPending %>
        <p><: Scan this QR code with your authenticator app (Google Authenticator, Microsoft Authenticator, Authy, 1Password and the like): :></p>
        <div style="display: inline-block; padding: 8px; background: #fff; border: 1px solid #ddd; border-radius: 4px; margin-bottom: 10px;"><@ TwoFactorQr @></div>
        <p class="text-muted" style="font-size: 13px;"><: If you cannot scan it, add an account in the app with this key (time based) :>: <code style="font-size: 15px"><@ TwoFactorSecret @></code> &nbsp; <: Setting it up on this phone :>: <a href="<@ TwoFactorUri @>"><: Open in app :></a></p>
        <form action="./?module=my_account&action=TwoFactorConfirm" method="post" class="form-inline">
            <: Then enter the code it shows :>: <input class="form-control" name="inTwoFactorCode" inputmode="numeric" maxlength="7" size="8" autocomplete="off" required>
            <button class="btn btn-primary" type="submit"><: Turn on :></button>
            <@ CSFR_Tag @>
        </form>
        <form action="./?module=my_account&action=TwoFactorDisable" method="post" style="margin-top: 8px">
            <button class="btn btn-default" type="submit"><: Cancel :></button>
            <@ CSFR_Tag @>
        </form>
        <% endif %>
        <% if TwoFactorOn %>
        <p><strong><: Two-factor login is on for your account. :></strong></p>
        <@ TwoFactorCodes @>
        <p><: Recovery codes left :>: <strong><@ TwoFactorRecoveryLeft @></strong> <span class="text-muted"><: (each logs you in once if you lose your phone) :></span></p>
        <form action="./?module=my_account&action=TwoFactorNewCodes" method="post" class="form-inline" style="margin-bottom: 10px;">
            <: To make a new set (the old codes stop working), enter a current code :>: <input class="form-control" name="inTwoFactorCode" inputmode="numeric" maxlength="7" size="8" autocomplete="off" required>
            <button class="btn btn-default" type="submit"><: Make new codes :></button>
            <@ CSFR_Tag @>
        </form>
        <% if TwoFactorForced %>
        <p class="text-muted"><: This server requires two-factor login for every account, so it can not be turned off. If you lose your phone, ask your administrator. :></p>
        <% else %>
        <form action="./?module=my_account&action=TwoFactorDisable" method="post" class="form-inline">
            <: To turn it off, enter a current code :>: <input class="form-control" name="inTwoFactorCode" inputmode="numeric" maxlength="7" size="8" autocomplete="off" required>
            <button class="btn btn-danger" type="submit"><: Turn off :></button>
            <@ CSFR_Tag @>
        </form>
        <% endif %>
        <% endif %>
    </div>
    <% endif %>
</div>
