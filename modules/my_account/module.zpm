<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <@ Result @>
    <link rel="stylesheet" href="modules/my_account/assets/account.css">

    <div class="ma" id="ma">
        <@ AccountCard @>

        <div class="ma-grid">
            <!-- Profile -->
            <% loop AccountSettings %>
            <form class="ma-card ma-profile" action="./?module=my_account&amp;action=UpdateAccountSettings" method="post">
                <h4><svg class="ma-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><: Your details :></h4>
                <div class="ma-fields">
                    <label class="ma-field"><span><: Full name :></span><input class="form-control" name="inFullname" type="text" id="inFullname" value="<& fullname &>" autocomplete="name"></label>
                    <label class="ma-field"><span><: Email address :></span><input class="form-control" name="inEmail" type="email" id="inEmail" value="<& email &>" autocomplete="email" required>
                        <small><: Where the panel sends notices, and password reset links. :></small></label>
                    <label class="ma-field"><span><: Phone number :></span><input class="form-control" name="inPhone" type="tel" id="inPhone" value="<& phone &>" autocomplete="tel"></label>
                    <label class="ma-field"><span><: Language :></span>
                        <select class="form-control" name="inLanguage" id="inLanguage">
                            <@ LanguageOptions @>
                        </select></label>
                    <label class="ma-field ma-wide"><span><: Postal address :></span><textarea class="form-control" name="inAddress" id="inAddress" rows="3" autocomplete="street-address"><& address &></textarea></label>
                    <label class="ma-field"><span><: Postal code :></span><input class="form-control" name="inPostalCode" type="text" id="inPostalCode" value="<& postcode &>" autocomplete="postal-code"></label>
                </div>
                <div class="ma-foot"><@ CSFR_Tag @><button class="btn btn-primary" type="submit"><: Save details :></button>
                    <a class="ma-link" href="./?module=password_assistant"><: Change your password :></a></div>
            </form>
            <% endloop %>

            <div class="ma-side">
                <!-- Support: the client's own reseller's contact -->
                <@ SupportCard @>

                <!-- Support for your clients: an account that can have clients sets what they see -->
                <% if SupportCanSet %>
                <form class="ma-card" action="./?module=my_account&amp;action=SaveSupport" method="post">
                    <h4><svg class="ma-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3zM3 19a2 2 0 0 0 2 2h1v-6H3z"/></svg><: Support for your clients :></h4>
                    <p class="ma-sub"><: Your clients see this on their My Account page, to contact you for help. Leave it empty to show nothing. :></p>
                    <label class="ma-field"><span><: Support email :></span><input class="form-control" name="inSupportEmail" type="email" value="<@ SupportEmail @>" maxlength="255" placeholder="support@example.com"></label>
                    <label class="ma-field"><span><: Support phone (optional) :></span><input class="form-control" name="inSupportPhone" type="tel" value="<@ SupportPhone @>" maxlength="40"></label>
                    <label class="ma-field"><span><: Website (optional) :></span><input class="form-control" name="inSupportWebsite" type="text" inputmode="url" value="<@ SupportWebsite @>" maxlength="255" placeholder="https://www.example.com"></label>
                    <label class="ma-field"><span><: Note (optional) :></span><input class="form-control" name="inSupportNote" type="text" value="<@ SupportNote @>" maxlength="<@ SupportNoteMax @>">
                        <small><: For example your support hours, or a help desk address (https://...). One line. :></small></label>
                    <div class="ma-foot"><@ CSFR_Tag @><button class="btn btn-primary" type="submit"><: Save support contact :></button></div>
                </form>
                <% endif %>

                <!-- Appearance -->
                <% if AppearanceAvailable %>
                <form class="ma-card" action="./?module=my_account&amp;action=SetAppearance" method="post">
                    <h4><svg class="ma-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/></svg><: Appearance :></h4>
                    <div class="ma-looks" role="radiogroup">
                        <% loop AppearanceList %>
                        <label class="ma-look"><input type="radio" name="inAppearance" value="<& value &>" <& checked &>>
                            <span class="ma-preview p-<& preview &>" aria-hidden="true"><i></i><i></i><i></i></span>
                            <b><& label &></b><small><& detail &></small></label>
                        <% endloop %>
                    </div>
                    <p class="ma-note"><: Auto follows your computer's light or dark setting. Only you see this choice. :></p>
                    <div class="ma-foot"><@ CSFR_Tag @><button class="btn btn-primary" type="submit"><: Save appearance :></button></div>
                </form>
                <% endif %>

                <!-- Two-factor login -->
                <% if TwoFactorAvailable %>
                <div class="ma-card ma-2fa">
                    <h4><svg class="ma-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg><: Two-factor login :>
                        <% if TwoFactorOn %><span class="ma-state on"><: On :></span><% endif %>
                        <% if TwoFactorPending %><span class="ma-state wait"><: Being set up :></span><% endif %>
                        <% if TwoFactorOff %><span class="ma-state off"><: Off :></span><% endif %></h4>

                    <% if TwoFactorOff %>
                    <p><: Protect your login with a 6-digit code from an authenticator app (Google Authenticator, Microsoft Authenticator, Aegis, 1Password and others). A stolen password alone is then not enough. :></p>
                    <form action="./?module=my_account&amp;action=TwoFactorBegin" method="post">
                        <button class="btn btn-primary" type="submit"><: Set up two-factor login :></button>
                        <@ CSFR_Tag @>
                    </form>
                    <% endif %>

                    <% if TwoFactorPending %>
                    <ol class="ma-steps">
                        <li><: Scan this code with your authenticator app :>
                            <div class="ma-qr"><@ TwoFactorQr @></div>
                            <span class="ma-sub"><@ TwoFactorKeyHelp @></span>
                            <code class="ma-key"><@ TwoFactorSecret @></code>
                            <a class="ma-link" href="<@ TwoFactorUri @>"><: On this phone: open it in the app :></a></li>
                        <li><: Enter the 6-digit code it shows :>
                            <form class="ma-code" action="./?module=my_account&amp;action=TwoFactorConfirm" method="post">
                                <input class="form-control" name="inTwoFactorCode" inputmode="numeric" maxlength="7" autocomplete="one-time-code" placeholder="123 456" required>
                                <button class="btn btn-primary" type="submit"><: Turn on :></button>
                                <@ CSFR_Tag @>
                            </form></li>
                    </ol>
                    <form action="./?module=my_account&amp;action=TwoFactorDisable" method="post">
                        <button class="btn btn-default btn-sm" type="submit"><: Cancel :></button>
                        <@ CSFR_Tag @>
                    </form>
                    <% endif %>

                    <% if TwoFactorOn %>
                    <@ TwoFactorCodes @>
                    <div class="ma-row"><span><: Recovery codes left :></span><b class="ma-big"><@ TwoFactorRecoveryLeft @></b></div>
                    <p class="ma-sub"><: Each recovery code logs you in once if you lose your phone. :></p>
                    <form class="ma-code" action="./?module=my_account&amp;action=TwoFactorNewCodes" method="post">
                        <label><span><: New recovery codes (the old ones stop working): enter a current code :></span>
                            <span class="ma-code-row"><input class="form-control" name="inTwoFactorCode" inputmode="numeric" maxlength="7" autocomplete="one-time-code" placeholder="123 456" required>
                            <button class="btn btn-default" type="submit"><: Make new codes :></button></span></label>
                        <@ CSFR_Tag @>
                    </form>
                    <% if TwoFactorForced %>
                    <p class="ma-note"><: This server requires two-factor login for every account, so it can not be turned off. If you lose your phone, ask your administrator. :></p>
                    <% else %>
                    <form class="ma-code ma-off" action="./?module=my_account&amp;action=TwoFactorDisable" method="post">
                        <label><span><: To turn it off, enter a current code :></span>
                            <span class="ma-code-row"><input class="form-control" name="inTwoFactorCode" inputmode="numeric" maxlength="7" autocomplete="one-time-code" placeholder="123 456" required>
                            <button class="btn btn-danger" type="submit"><: Turn off :></button></span></label>
                        <@ CSFR_Tag @>
                    </form>
                    <% endif %>
                    <% endif %>
                </div>
                <% endif %>
            </div>
        </div>
    </div>
</div>
