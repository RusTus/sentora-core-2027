# Apache Status: only index.php (which checks the panel login) and the page's
# own scripts, styles, fonts and images may be fetched; config, classes, views
# and language files can not be requested directly.
<FilesMatch "\.(php|json|txt|md|inc)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>
