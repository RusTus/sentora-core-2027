<div class="zmodule_content panel" id="zmodule_header_<@ ModuleName @>">
    <div class="panel-heading">
        <img src="<@ ModuleIcon @>" width="35" height="35" border="0" alt="<@ ModuleName @>">
        <div class="zmodule_title"><@ ModuleName @></div>
        <div class="zmodule_desc" id="zmodule_desc_<@ ModuleName @>"><@ ModuleDesc @></div>
    </div>
    <div class="zgrid_wrapper">
        <% if IsModServerStatus %>
        <p><a href="modules/apache_status/app/index.php" target="_blank" rel="noopener"><: Open in a new window :></a></p>
        <iframe class="sn-autoheight" data-sn-free="html, body, .wrapper, .content-wrapper, .right-side, .main-sidebar" src="modules/apache_status/app/index.php" title="<: Apache Status :>" style="width: 100%; height: 900px; border: 1px solid #ddd;"></iframe>
        <script src="etc/lib/sentora/frame-height.js"></script>
        <% else %>
        <div class="alert alert-warning">
            <h4><: Apache's status page is not answering :></h4>
            <p><: This module reads http://127.0.0.1/server-status (Apache's mod_status, with ExtendedStatus On). It returned HTTP :> <@ StatusCode @>.</p>
            <p><: A 301 or 302 means Apache redirected the request, usually to https. The panel's redirect leaves /server-status alone, so let the daemon rewrite the Apache config (within 5 minutes) and reload this page. :></p>
            <p><: Otherwise check that the status module is enabled with a2enmod status, then restart Apache. :></p>
        </div>
        <% endif %>
    </div>
</div>
