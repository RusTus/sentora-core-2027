# Sentora-2027: every file of the panel belongs in the repository (modules, themes and
# bundled apps included). Only files a running server makes for itself are left out,
# for anyone who works in a copy of an installed panel.

# Operating system and editor files
.DS_Store
Thumbs.db
/nbproject
/.idea
/.vscode
/.vagrant
/log.txt

# Built on each server by the installer
/bin/zsudo

# Written by the installer or the panel on each server (passwords, keys)
/etc/apps/phpmyadmin/config.inc.php
/etc/apps/webmail/config/config.inc.php
/etc/apps/webmail/plugins/managesieve/config.inc.php
/etc/apps/webmail/plugins/password/config.inc.php
/etc/apps/matomo/config/config.ini.php

# Working files of a running panel (the placeholder files stay)
/etc/tmp/*
!/etc/tmp/_delete_me
!/etc/tmp/storage/
/etc/tmp/storage/*
!/etc/tmp/storage/_delete_me
/etc/apps/matomo/tmp/*
/etc/zppy-cache/package-downloads/*
!/etc/zppy-cache/package-downloads/_delete_me

# Add-on modules installed from Repo Browser (they live in the add-on repository)
/modules/PHP-Adminer/
/modules/webalizer_stats/
/modules/visitor_stats/
