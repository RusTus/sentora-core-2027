#!/bin/bash
# sentora-update-check: which of the apps bundled with Sentora are behind their latest
# release, and how many system updates (Ubuntu's or Debian's) are waiting.
#
# Run it by hand, as root:   bash /etc/sentora/panel/bin/sentora-update-check
#
# The bundled apps (phpMyAdmin, Roundcube, Matomo, Tiny File Manager, GoAccess and,
# if installed, Adminer) do not update through apt: they are
# updated by rebuilding the Sentora bundles. Nothing here runs by itself or reports
# anywhere: it only reads public release information from GitHub (no API key, no
# GitHub API rate limit) and prints the result. The report is also saved as
# /var/sentora/logs/update-check.log (System Log Viewer).

PANEL=${SENTORA_PANEL:-/etc/sentora/panel}
GOACCESS=${SENTORA_GOACCESS:-/opt/sentora-goaccess/bin/goaccess}
LOG=${SENTORA_UPDATE_LOG:-/var/sentora/logs/update-check.log}

# --- installed versions --------------------------------------------------------
v_php() { grep -ho "$2" "$1" 2>/dev/null | head -1 | grep -o "[0-9][0-9.]*[0-9]" | head -1; }
commit_of() { grep -o "commit [0-9a-f]\{7,\}" "$1" 2>/dev/null | head -1 | cut -d' ' -f2; }

declare -a ROWS
# name | installed | how to find the latest ("release:owner/repo", "tags:owner/repo" or "head:owner/repo") | bundled commit (optional)
add() { ROWS+=("$1|$2|$3|$4"); }
add "phpMyAdmin" "$(v_php $PANEL/etc/apps/phpmyadmin/libraries/classes/Version.php "VERSION = '[^']*'")" "release:phpmyadmin/phpmyadmin" ""
add "Roundcube" "$(v_php $PANEL/etc/apps/webmail/program/include/iniset.php "RCMAIL_VERSION', '[^']*'")" "release:roundcube/roundcubemail" ""
add "Matomo" "$(v_php $PANEL/etc/apps/matomo/core/Version.php "VERSION = '[^']*'")" "release:matomo-org/matomo" ""
add "Tiny File Manager" "$(grep -o "Tiny File Manager [0-9.]*" $PANEL/modules/file_manager/app/VERSION 2>/dev/null | head -1 | awk '{print $4}')" "release:prasathmani/tinyfilemanager" "$(commit_of $PANEL/modules/file_manager/app/VERSION)"
add "GoAccess" "$($GOACCESS --version 2>/dev/null | head -1 | grep -o '[0-9][0-9.]*[0-9]')" "tags:allinurl/goaccess" ""
if [ -f $PANEL/modules/PHP-Adminer/app/adminer.php ]; then
    add "Adminer (PHP-Adminer)" "$(grep -o '@version [0-9.]*' $PANEL/modules/PHP-Adminer/app/adminer.php | head -1 | awk '{print $2}')" "release:vrana/adminer" ""
fi

# --- latest versions (public GitHub pages, not the API) ---------------------------
latest_release() {
    # GitHub redirects /releases/latest to the newest release's tag
    curl -sI --max-time 20 "https://github.com/$1/releases/latest" | tr -d '\r' \
        | awk 'tolower($1)=="location:" {print $2}' | sed 's|.*/||' | grep -v '^releases$' \
        | sed -E 's/^v//; s/^RELEASE_//; s/_/./g'
}
latest_tag() {
    git ls-remote --tags --refs "https://github.com/$1.git" 2>/dev/null | sed 's|.*refs/tags/||' \
        | grep -E '^v?[0-9]+(\.[0-9]+)+$' | sed 's/^v//' | sort -V | tail -1
}
head_commit() { git ls-remote "https://github.com/$1.git" HEAD 2>/dev/null | cut -c1-7; }
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$2" ]; }

command -v git > /dev/null || { echo "git is needed (apt-get install git)"; exit 1; }
{
echo "Sentora update check, $(date '+%Y-%m-%d %H:%M %Z') on $(hostname -f 2>/dev/null || hostname)"
echo
printf "%-24s %-12s %-12s %s\n" "App" "Installed" "Latest" "Status"
printf "%-24s %-12s %-12s %s\n" "---" "---------" "------" "------"
behind=0
for row in "${ROWS[@]}"; do
    IFS='|' read -r name have how commit <<< "$row"
    kind=${how%%:*}; repo=${how#*:}
    [ -z "$have" ] && { printf "%-24s %-12s %-12s %s\n" "$name" "?" "" "could not read the installed version"; continue; }
    case $kind in
        release) want=$(latest_release "$repo"); [ -z "$want" ] && want=$(latest_tag "$repo") ;;
        tags) want=$(latest_tag "$repo") ;;
        head) want="" ;;
    esac
    status="up to date"
    if [ "$kind" != head ] && [ -z "$want" ]; then
        status="could not reach GitHub"
    elif [ "$kind" != head ] && newer "$have" "$want"; then
        status="UPDATE AVAILABLE (https://github.com/$repo/releases)"; behind=$((behind + 1))
    elif [ -n "$commit" ]; then
        # bundled from a commit: also report changes made on GitHub since then
        head=$(head_commit "$repo")
        if [ -z "$head" ]; then
            status="could not reach GitHub"
        elif [ "${head:0:7}" != "${commit:0:7}" ]; then
            status="newer changes on GitHub (bundled ${commit:0:7}, now ${head:0:7}: https://github.com/$repo/commits)"; behind=$((behind + 1))
        fi
    fi
    printf "%-24s %-12s %-12s %s\n" "$name" "$have" "${want:-commit}" "$status"
done
echo
# The system's own packages (Ubuntu's or Debian's: Apache, PHP, MySQL or MariaDB, Postfix, Dovecot, SOGo...)
OS_NAME=$(. /etc/os-release; echo "${NAME%% *}")
OS_TAG=$(. /etc/os-release; [ "${ID:-}" = debian ] && echo "debian${VERSION_ID:-}" || echo "ubuntu${VERSION_ID:-26.04}")
apt-get -qq update > /dev/null 2>&1
all=$(apt-get -s -o Debug::NoLocking=1 upgrade 2>/dev/null | grep -c '^Inst ')
sec=$(apt-get -s -o Debug::NoLocking=1 upgrade 2>/dev/null | grep '^Inst ' | grep -ci 'security')
echo "${OS_NAME:-System} packages: $all update(s) waiting, $sec of them security updates$( [ "$all" -gt 0 ] && echo " (apt-get upgrade)")."
echo
if [ $behind -gt 0 ]; then
    echo "$behind bundled app(s) behind: they are updated by rebuilding the Sentora bundles"
    echo "(sentora-core-2027.zip, or the add-on .zpp for Adminer) and installing them again."
else
    echo "All bundled apps are at their latest release."
fi
echo
echo "Extra PHP versions (built for Sentora):"
# --- the extra PHP versions (built for Sentora, not updated by apt) -------------------
# Each is compared with the newest release of its branch in PHP's own repository; a newer
# one usually carries security fixes and needs a new sentora-php-<version> archive.
PHP_BEHIND=0
for fpm in /opt/sentora-php/*/sbin/php-fpm; do
    [ -x "$fpm" ] || continue
    branch=$(basename "$(dirname "$(dirname "$fpm")")")
    have=$("$fpm" -v 2> /dev/null | head -1 | grep -o '[0-9]\+\.[0-9]\+\.[0-9]\+' | head -1)
    want=$(git ls-remote --tags --refs https://github.com/php/php-src.git "refs/tags/php-$branch.*" 2> /dev/null \
        | sed 's|.*refs/tags/php-||' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1)
    if [ -z "$want" ]; then
        echo "  PHP $branch: $have (could not check: no access to github.com)"
    elif newer "$have" "$want"; then
        echo "  PHP $branch: $have, PHP $want is out: UPDATE AVAILABLE (rebuild sentora-php-$branch-$OS_TAG-amd64.tar.gz, usually security fixes)"
        PHP_BEHIND=$((PHP_BEHIND + 1))
    else
        echo "  PHP $branch: $have (latest)"
    fi
done
if [ "$PHP_BEHIND" -gt 0 ]; then
    echo "$PHP_BEHIND extra PHP version(s) behind: their security fixes come only from a new build."
fi
} 2>&1 | tee "$LOG"
