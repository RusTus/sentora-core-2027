#!/usr/bin/env php
<?php
/**
 * sentora-file-scan: SpamAV Admin's file scan of the hosted websites (root). Started by the daemon at
 * the night's hour and by the page's Scan now; also from SSH:
 *
 *   sentora-file-scan --changed     the files changed since the last scan
 *   sentora-file-scan --full        every file
 *
 * At low priority (nice 19, idle I/O), one scan at a time. How it works: dryden/sys/filescan.class.php.
 *
 * @package Sentora
 * @license GPL-3.0 https://www.gnu.org/licenses/gpl-3.0.html
 *
 * Written by RusTus, 2026-11-13
 */
if (PHP_SAPI !== 'cli' || !function_exists('posix_geteuid') || posix_geteuid() !== 0) {
    fwrite(STDERR, "Run this as root.\n");
    exit(2);
}
$mode = $argv[1] ?? '';
if (!in_array($mode, array('--changed', '--full'), true)) {
    fwrite(STDERR, "sentora-file-scan --changed | --full\n");
    exit(2);
}
chdir(dirname(__DIR__));
require 'dryden/loader.inc.php';
require 'cnf/db.php';
require 'inc/dbc.inc.php';
$lock = @fopen(sys_filescan::LOCK, 'c');
if ($lock === false || !flock($lock, LOCK_EX | LOCK_NB)) {
    echo "A file scan is already running.\n";
    exit(0);
}
@proc_nice(19);
if (is_executable('/usr/bin/ionice')) {
    exec('/usr/bin/ionice -c 3 -p ' . (int) getmypid() . ' > /dev/null 2>&1');
}
$run = sys_filescan::Scan($mode === '--full', function ($s) { echo date('H:i:s') . '  ' . $s . "\n"; });
echo 'Done: ' . $run['files'] . ' file(s) in ' . $run['accounts'] . ' account(s), ' . $run['found'] . ' found'
    . ($run['skipped_big'] ? ', ' . $run['skipped_big'] . ' too big' : '') . ($run['errors'] ? ', ' . $run['errors'] . ' not scanned' : '')
    . (isset($run['stopped']) ? ' (stopped: ' . $run['stopped'] . ')' : '') . "\n";
