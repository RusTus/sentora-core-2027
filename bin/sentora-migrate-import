sys_symlinks::EnsureColumn();
$SYMON = array();   // domain name => new id: FollowSymLinks switched on for it (--allow-symlinks)
$newCols = $cols('sentora_core', 'x_vhosts');
$VHMAP = array();
foreach ($plan['domains'] as $v) {
    $row = array('vh_acc_fk' => $NEWID, 'vh_name_vc' => strtolower($v['vh_name_vc']), 'vh_directory_vc' => $v['vh_directory_vc'], 'vh_type_in' => (int) $v['vh_type_in'],
        'vh_active_in' => 0, 'vh_obasedir_in' => (int) ($v['vh_obasedir_in'] ?? 1), 'vh_custom_tx' => $v['vh_custom_tx'] ?? null,
        'vh_custom_port_in' => $v['vh_custom_port_in'] ?? null, 'vh_custom_ip_vc' => $v['vh_custom_ip_vc'] ?? null, 'vh_portforward_in' => $v['vh_portforward_in'] ?? null,
        'vh_enabled_in' => (int) ($v['vh_enabled_in'] ?? 1), 'vh_created_ts' => $v['vh_created_ts'] ?: time());
    if (in_array('vh_php_version_vc', $newCols, true)) {
        $row['vh_php_version_vc'] = $PHPV !== '' ? $PHPV : null;
    }
    $row = array_intersect_key($row, array_flip($newCols));
    $zdbh->prepare("INSERT INTO x_vhosts (" . implode(',', array_keys($row)) . ") VALUES (" . implode(',', array_fill(0, count($row), '?')) . ")")->execute(array_values($row));
    $VHMAP[(int) $v['vh_id_pk']] = (int) $zdbh->lastInsertId();
    $mapPut('domain', (int) $v['vh_id_pk'], strtolower($v['vh_name_vc']), $VHMAP[(int) $v['vh_id_pk']], true);
    if ($opt['allow-symlinks'] && isset($customFsl[$v['vh_name_vc']])) {
        $SYMON[$v['vh_name_vc']] = $VHMAP[(int) $v['vh_id_pk']];
    }
    if (trim((string) ($v['vh_ssl_tx'] ?? '')) !== '') {
        warn($v['vh_name_vc'] . ': its SSL settings were not copied (the old certificate files are not here): request a certificate in Sencrypt');
    } elseif (sys_apachecustom::OldSencrypt(array_merge($v, array('vh_ssl_tx' => ''))) !== null) {
        // (the daemon puts it right once the files are here: sys_apachecustom::RepairOldSencrypt)
        warn($v['vh_name_vc'] . ': its certificate was in its Extra directives on port 443 (Sencrypt of Sentora 1.0.x): it moves to its SSL settings if its files came along, else the site runs on http until a certificate is requested in Sencrypt');
    }
}
ui_info(count($VHMAP) . ' added, PHP ' . ($PHPV !== '' ? $PHPV : sys_phpversions::DefaultVersion()));

// --- website files ------------------------------------------------------------------------------------
ui_step('Copying the website files (' . (is_file($filesTar) ? hsize(filesize($filesTar)) . ' packed' : 'none') . ')');
if (is_file($filesTar)) {
    @mkdir($STAGE, 0700, true);
    if (!sh('tar -xzf ' . q($filesTar) . ' -C ' . q($STAGE) . ' --no-same-owner', $o)) {
        warn('the website files did not unpack completely: ' . substr($o, 0, 300));
    }
    $src = $STAGE . '/' . $OLDU . '/public_html/';
    if (is_dir($src)) {
        @mkdir($NEWHOME . '/public_html', 0750, true);
        sh('rsync -a --no-owner --no-group ' . ($opt['overwrite'] ? '' : '--ignore-existing ') . q($src) . ' ' . q($NEWHOME . '/public_html/'), $o) || warn('copying the website files: ' . substr($o, 0, 300));
        // absolute paths to the old account's folder (protected folders' AuthUserFile, site settings)
        if ($OLDHOME !== $NEWHOME) {
            $n = 0;
            $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($NEWHOME . '/public_html', FilesystemIterator::SKIP_DOTS));
            foreach ($it as $f) {
                if ($f->isFile() && !$f->isLink() && in_array($f->getFilename(), array('.htaccess', '.htpasswd', '.user.ini'), true)) {
                    $c = (string) file_get_contents($f->getPathname());
                    if (strpos($c, $OLDHOME . '/') !== false) {
                        file_put_contents($f->getPathname(), $PATHFIX($c));
                        $n++;
                    }
                }
            }
            if ($n) { ui_info("$n .htaccess/.htpasswd file(s): $OLDHOME changed to $NEWHOME"); }
        }
        ui_info('into ' . $NEWHOME . '/public_html');
        foreach (array_merge(laravel_caches($NEWHOME . '/public_html'), shop_caches($NEWHOME . '/public_html')) as $line) {
            ui_info($line);
        }
        if ($opt['allow-symlinks']) {
            // the domains whose folder holds an .htaccess that uses FollowSymLinks
            sh('grep -rliE --include=.htaccess "^[[:space:]]*Options[[:space:]].*FollowSymLinks" ' . q($NEWHOME . '/public_html'), $o);
            foreach (array_filter(explode("\n", $o)) as $file) {
                $rel = substr($file, strlen($NEWHOME . '/public_html'));
                foreach ($plan['domains'] as $v) {
                    $dir = rtrim('/' . ltrim((string) $v['vh_directory_vc'], '/'), '/') . '/';
                    if (strpos($rel, $dir) === 0 && isset($VHMAP[(int) $v['vh_id_pk']])) {
                        $SYMON[$v['vh_name_vc']] = $VHMAP[(int) $v['vh_id_pk']];
                    }
                }
            }
        }
    } else {
        warn('the export has no public_html for ' . $OLDU);
    }
}

if ($SYMON) {
    $set = $zdbh->prepare("UPDATE x_vhosts SET " . sys_symlinks::COLUMN . " = 1 WHERE vh_id_pk = :id");
    foreach ($SYMON as $id) { $set->execute(array(':id' => $id)); }
    ui_info('"Allow FollowSymLinks" switched on for: ' . implode(', ', array_keys($SYMON)));
}
// --- the .htaccess lines this server refuses: shown, and fixed when the administrator agrees --------
ui_step('Checking the websites\' .htaccess files');
$symDirs = array();
foreach ($plan['domains'] as $v) {
    if (isset($SYMON[$v['vh_name_vc']])) { $symDirs[] = $NEWHOME . '/public_html' . rtrim('/' . ltrim((string) $v['vh_directory_vc'], '/'), '/') . '/'; }
}
$HTFOUND = htaccess_scan($NEWHOME . '/public_html', $symDirs);
$HTFIXED = 0;
if (!$HTFOUND) {
    ui_info('no line this server refuses');
} else {
    $n = 0; foreach ($HTFOUND as $r) { $n += count($r['changes']); }
    $fix = $opt['fix-htaccess'];
    if ($fix === null && function_exists('posix_isatty') && posix_isatty(STDIN)) {
        ui_end_step();
        echo "\n  " . c('bold') . c('yellow') . count($HTFOUND) . " .htaccess file(s) have $n line(s) this server refuses" . c('reset') . "\n";
        echo '  ' . c('yellow') . 'Those sites will not work (error 500) until these lines are changed. This can change them for you now;' . c('reset') . "\n";
        echo '  ' . c('yellow') . 'if you say no, you have to change them by hand (the list is shown again at the end).' . c('reset') . "\n\n";
        echo '  ' . c('dim') . 'The change keeps each site working the same: links within the site and its URL rewriting still work, and' . c('reset') . "\n";
        echo '  ' . c('dim') . 'PHP settings move to a .user.ini beside the file. Each original line stays as a comment, and each file is' . c('reset') . "\n";
        echo '  ' . c('dim') . 'kept as .htaccess.before-migrate.' . c('reset') . "\n\n";
        htaccess_show($HTFOUND, $HOSTED);
        echo "\n  " . c('bold') . c('cyan') . 'Fix these .htaccess files now?' . c('reset') . "\n";
        echo '  (y) fix them, (n) leave them as they are > ';
        $a = strtolower(trim((string) fgets(STDIN)));
        $fix = ($a !== '' && $a[0] === 'y');
        echo "\n";
        ui_step($fix ? 'Fixing the websites\' .htaccess files' : 'The websites\' .htaccess files, left as they are');
        $UI['total']++;
    }
    if ($fix) {
        foreach ($HTFOUND as $p => $r) {
            if (!is_file($p . '.before-migrate')) { @copy($p, $p . '.before-migrate'); }
            file_put_contents($p, $r['text']);
            if ($r['userini']) { sys_htaccessfix::MergeUserIni(dirname($p), $r['userini']); }
            $HTFIXED++;
        }
        ui_info("$HTFIXED .htaccess file(s) fixed ($n line(s)); each kept as .htaccess.before-migrate");
        $HTFOUND = array();
    } else {
        warn(count($HTFOUND) . " .htaccess file(s) left as they are: those sites will not work (error 500) until the lines are changed by hand, or by running the move again with --fix-htaccess (listed at the end)");
    }
}

// --- DNS ----------------------------------------------------------------------------------------------
ui_step('DNS records');
$n = 0;
$touched = array();
foreach ($old("SELECT * FROM `$O`.x_dns WHERE dn_acc_fk = :a AND dn_deleted_ts IS NULL", array(':a' => $OLDID)) as $d) {
    if (!isset($VHMAP[(int) $d['dn_vhost_fk']])) { continue; }
    $target = $d['dn_target_vc'];
    if (!$opt['keep-ip'] && $OLDIP !== '' && $target === $OLDIP && $NEWIP !== '') { $target = $NEWIP; }
    $zdbh->prepare("INSERT INTO x_dns (dn_acc_fk, dn_name_vc, dn_vhost_fk, dn_type_vc, dn_host_vc, dn_ttl_in, dn_target_vc, dn_texttarget_tx, dn_priority_in, dn_weight_in, dn_port_in, dn_created_ts)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?)")->execute(array($NEWID, strtolower($d['dn_name_vc']), $VHMAP[(int) $d['dn_vhost_fk']], $d['dn_type_vc'], $d['dn_host_vc'], $d['dn_ttl_in'], $target,
        $d['dn_texttarget_tx'], $d['dn_priority_in'], $d['dn_weight_in'], $d['dn_port_in'], $d['dn_created_ts'] ?: time()));
    $touched[$VHMAP[(int) $d['dn_vhost_fk']]] = true;
    $n++;
}
if ($touched) {
    $list = array_filter(explode(',', (string) ctrl_options::GetSystemOption('dns_hasupdates')));
    $list = array_unique(array_merge($list, array_map('strval', array_keys($touched))));
    $zdbh->prepare("UPDATE x_settings SET so_value_tx = :v WHERE so_name_vc = 'dns_hasupdates'")->execute(array(':v' => implode(',', $list)));
}
ui_info("$n added");

// --- MySQL databases and users ---------------------------------------------------------------------
ui_step('Loading the MySQL databases (' . count($plan['dbs']) . ')');
$DBMAP = array();
foreach ($plan['dbs'] as $d) {
    $name = $d['my_name_vc'];
    $zdbh->exec("CREATE DATABASE `" . str_replace('`', '', $name) . "` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci");
    if (($r = load_dump($EXP . '/db/sites/' . $name . '.sql.gz', $name)) !== true) {
        warn("the database $name did not load completely: " . substr((string) $r, 0, 300));
    }
    $zdbh->prepare("INSERT INTO x_mysql_databases (my_acc_fk, my_name_vc, my_usedspace_bi, my_created_ts) VALUES (?,?,0,?)")->execute(array($NEWID, $name, $d['my_created_ts'] ?: time()));
    $DBMAP[(int) $d['my_id_pk']] = (int) $zdbh->lastInsertId();
    ui_info($name);
}
ui_step('MySQL users and their permissions');
// PHP 7.1 can not log in with MySQL 8.4's default method (caching_sha2_password: "The server
// requested authentication method unknown to the client"). For sites on an old PHP the users get
// mysql_native_password, which MySQL 8.4 has but keeps off until mysql_native_password = ON in its
// settings: switched on here (MySQL restarts once). MySQL only listens on this server.
$NATIVE = false;
$isMysql = stripos((string) $zdbh->query("SELECT VERSION()")->fetchColumn(), 'mariadb') === false;
if ($isMysql && $PHPV !== '' && version_compare($PHPV, '7.4', '<') && $plan['users']) {
    $NATIVE = true;
    $active = $zdbh->query("SELECT PLUGIN_STATUS FROM information_schema.PLUGINS WHERE PLUGIN_NAME = 'mysql_native_password'")->fetchColumn();
    if ($active !== 'ACTIVE') {
        $cnf = '/etc/mysql/mysql.conf.d/mysqld.cnf';
        $c = (string) @file_get_contents($cnf);
        if ($c !== '' && !preg_match('/^\s*mysql[_-]native[_-]password\s*=/mi', $c)) {
            @copy($cnf, $cnf . '.before-migrate');
            file_put_contents($cnf, preg_replace('/^\[mysqld\]\s*$/m', "[mysqld]\n# PHP $PHPV (moved sites) logs in with it: MySQL 8.4 keeps it off by default\nmysql_native_password = ON", $c, 1));
        }
        ui_info("PHP $PHPV needs MySQL's older login method: switching it on (MySQL restarts)");
        if (!sh('systemctl restart mysql', $o)) {
            warn('MySQL did not restart: ' . substr($o, 0, 200) . " (see $cnf)");
        }
        // the panel's own connection went with the restart
        include 'cnf/db.php';
        $zdbh = new db_driver("mysql:host=$host;dbname=$dbname", $user, $pass);
        $GLOBALS['zdbh'] = $zdbh;
        if ($zdbh->query("SELECT PLUGIN_STATUS FROM information_schema.PLUGINS WHERE PLUGIN_NAME = 'mysql_native_password'")->fetchColumn() !== 'ACTIVE') {
            warn("MySQL's older login method could not be switched on: sites on PHP $PHPV will not reach their databases (add mysql_native_password = ON under [mysqld] in $cnf and restart MySQL)");
            $NATIVE = false;
        }
    }
}
$MUMAP = array();
$newpass = array();
foreach ($plan['users'] as $u) {
    $name = $u['mu_name_vc'];
    $host = $u['mu_access_vc'] ?: 'localhost';
    $pass = (string) $u['mu_pass_vc'];
    // old panels kept the password as it was typed; a hash (or nothing) can not be used again
    if ($pass === '' || preg_match('/^\*[0-9A-F]{40}$/', $pass)) {
        $pass = fs_director::GenerateRandomPassword(16, 4);
        $newpass[] = "$name: $pass";
    }
    try {
        $zdbh->prepare("CREATE USER :u@:h IDENTIFIED " . ($NATIVE ? 'WITH mysql_native_password ' : '') . "BY :p")->execute(array(':u' => $name, ':h' => $host, ':p' => $pass));
        $zdbh->prepare("GRANT USAGE ON *.* TO :u@:h")->execute(array(':u' => $name, ':h' => $host));
    } catch (Exception $e) {
        warn("MySQL user $name was not made: " . $e->getMessage());
        continue;
    }
    $zdbh->prepare("INSERT INTO x_mysql_users (mu_acc_fk, mu_name_vc, mu_database_fk, mu_pass_vc, mu_access_vc, mu_created_ts) VALUES (?,?,?,?,?,?)")
        ->execute(array($NEWID, $name, $DBMAP[(int) $u['mu_database_fk']] ?? 0, ctrl_secret::Encrypt($pass), $host, $u['mu_created_ts'] ?: time()));
    $MUMAP[(int) $u['mu_id_pk']] = array((int) $zdbh->lastInsertId(), $name, $host);
}
$g = 0;
foreach ($old("SELECT * FROM `$O`.x_mysql_dbmap WHERE mm_acc_fk = :a", array(':a' => $OLDID)) as $m) {
    if (!isset($MUMAP[(int) $m['mm_user_fk']], $DBMAP[(int) $m['mm_database_fk']])) { continue; }
    list($uid, $name, $host) = $MUMAP[(int) $m['mm_user_fk']];
    $db = $old("SELECT my_name_vc FROM x_mysql_databases WHERE my_id_pk = :i", array(':i' => $DBMAP[(int) $m['mm_database_fk']]))[0]['my_name_vc'];
    $zdbh->exec("GRANT ALL PRIVILEGES ON `" . str_replace('`', '', $db) . "`.* TO " . $zdbh->quote($name) . "@" . $zdbh->quote($host));
    $zdbh->prepare("INSERT INTO x_mysql_dbmap (mm_acc_fk, mm_user_fk, mm_database_fk) VALUES (?,?,?)")->execute(array($NEWID, $uid, $DBMAP[(int) $m['mm_database_fk']]));
    $g++;
}
$zdbh->exec("FLUSH PRIVILEGES");
ui_info(count($MUMAP) . " added, $g database permission(s)");

// --- FTP ------------------------------------------------------------------------------------------------
ui_step('FTP accounts');
$owner = posix_getpwnam('web' . $NEWID);
$n = 0;
foreach ($plan['ftp'] as $f) {
    $pass = (string) $f['ft_password_vc'];
    if ($pass === '' || strncmp($pass, '$', 1) === 0) {
        $pass = fs_director::GenerateRandomPassword(12, 3);
        $newpass[] = 'FTP ' . $f['ft_user_vc'] . ": $pass";
    }
    $salt = substr(strtr(base64_encode(random_bytes(12)), '+', '.'), 0, 16);
    $hash = crypt($pass, '$6$rounds=50000$' . $salt . '$');
    $dir = $f['ft_directory_vc'];
    $zdbh->prepare("INSERT INTO x_ftpaccounts (ft_acc_fk, ft_user_vc, ft_directory_vc, ft_access_vc, ft_password_vc, ft_passenc_tx, ft_created_ts) VALUES (?,?,?,?,?,?,?)")
        ->execute(array($NEWID, $f['ft_user_vc'], $dir, $f['ft_access_vc'], $hash, ctrl_secret::Encrypt($pass), $f['ft_created_ts'] ?: time()));
    $zdbh->prepare("INSERT INTO `$FTPDB`.ftpquotalimits (name, quota_type, per_session, limit_type, bytes_in_avail, bytes_out_avail, bytes_xfer_avail, files_in_avail, files_out_avail, files_xfer_avail)
        VALUES (?, 'user', 'true', 'hard', 0, 0, 0, 0, 0, 0)")->execute(array($f['ft_user_vc']));
    $zdbh->prepare("INSERT INTO `$FTPDB`.ftpuser (userid, passwd, uid, gid, homedir, shell, count, accessed, modified) VALUES (?,?,?,?,?, '/sbin/nologin', 0, now(), now())")
        ->execute(array($f['ft_user_vc'], $hash, $owner ? $owner['uid'] : 33, $owner ? $owner['gid'] : 33, $HOSTED . $NEWU . $dir));
    $n++;
}
ui_info("$n added");

// --- cron jobs and protected folders -----------------------------------------------------------------
ui_step('Cron jobs and protected folders');
$n = 0;
foreach ($old("SELECT * FROM `$O`.x_cronjobs WHERE ct_acc_fk = :a AND ct_deleted_ts IS NULL", array(':a' => $OLDID)) as $c) {
    if ($taken("SELECT COUNT(*) FROM x_cronjobs WHERE ct_acc_fk = :a AND ct_fullpath_vc = :p AND ct_timing_vc = :t AND ct_deleted_ts IS NULL",
        array(':a' => $NEWID, ':p' => $PATHFIX($c['ct_fullpath_vc']), ':t' => $c['ct_timing_vc']))) { continue; }   // (moved before)
    $zdbh->prepare("INSERT INTO x_cronjobs (ct_acc_fk, ct_script_vc, ct_timing_vc, ct_fullpath_vc, ct_description_tx, ct_created_ts) VALUES (?,?,?,?,?,?)")
        ->execute(array($NEWID, $c['ct_script_vc'], $c['ct_timing_vc'], $PATHFIX($c['ct_fullpath_vc']), $c['ct_description_tx'], $c['ct_created_ts'] ?: time()));
    $n++;
}
ui_info("$n cron job(s)");
$n = 0;
foreach ($old("SELECT * FROM `$O`.x_htaccess WHERE ht_acc_fk = :a AND ht_deleted_ts IS NULL", array(':a' => $OLDID)) as $h) {
    if ($taken("SELECT COUNT(*) FROM x_htaccess WHERE ht_acc_fk = :a AND ht_dir_vc = :d AND ht_deleted_ts IS NULL", array(':a' => $NEWID, ':d' => $PATHFIX($h['ht_dir_vc'])))) { continue; }
    $zdbh->prepare("INSERT INTO x_htaccess (ht_acc_fk, ht_user_vc, ht_dir_vc, ht_created_ts) VALUES (?,?,?,?)")
        ->execute(array($NEWID, $h['ht_user_vc'], $PATHFIX($h['ht_dir_vc']), $h['ht_created_ts'] ?: time()));
    $n++;
}
$HTF = array();
foreach ($old("SELECT * FROM `$O`.x_htpasswd_file WHERE x_htpasswd_sentora_user_id = :a AND x_htpasswd_file_deleted IS NULL", array(':a' => $OLDID)) as $h) {
    if ($taken("SELECT COUNT(*) FROM x_htpasswd_file WHERE x_htpasswd_sentora_user_id = :a AND x_htpasswd_file_target = :t AND x_htpasswd_file_deleted IS NULL",
        array(':a' => $NEWID, ':t' => $PATHFIX($h['x_htpasswd_file_target'])))) { continue; }
    $zdbh->prepare("INSERT INTO x_htpasswd_file (x_htpasswd_file_target, x_htpasswd_file_message, x_htpasswd_file_created, x_htpasswd_sentora_user_id) VALUES (?,?,?,?)")
        ->execute(array($PATHFIX($h['x_htpasswd_file_target']), $h['x_htpasswd_file_message'], $h['x_htpasswd_file_created'] ?: time(), $NEWID));
    $HTF[(int) $h['x_htpasswd_file_id']] = (int) $zdbh->lastInsertId();
    $n++;
}
$HTU = array();
foreach ($old("SELECT * FROM `$O`.x_htpasswd_user WHERE x_htpasswd_sentora_user_id = :a AND x_htpasswd_user_deleted IS NULL", array(':a' => $OLDID)) as $h) {
    $zdbh->prepare("INSERT INTO x_htpasswd_user (x_htpasswd_user_username, x_htpasswd_user_password, x_htpasswd_user_created, x_htpasswd_sentora_user_id) VALUES (?,?,?,?)")
        ->execute(array($h['x_htpasswd_user_username'], $h['x_htpasswd_user_password'], $h['x_htpasswd_user_created'] ?: time(), $NEWID));
    $HTU[(int) $h['x_htpasswd_user_id']] = (int) $zdbh->lastInsertId();
}
foreach ($old("SELECT * FROM `$O`.x_htpasswd_mapper") as $m) {
    if (isset($HTF[(int) $m['x_htpasswd_file_id']], $HTU[(int) $m['x_htpasswd_user_id']])) {
        $zdbh->prepare("INSERT INTO x_htpasswd_mapper (x_htpasswd_file_id, x_htpasswd_user_id) VALUES (?,?)")->execute(array($HTF[(int) $m['x_htpasswd_file_id']], $HTU[(int) $m['x_htpasswd_user_id']]));
    }
}
ui_info("$n protected folder(s)");

// --- mail -----------------------------------------------------------------------------------------------
ui_step('Mailboxes, aliases, forwarders and lists');
$domains = array_map(function ($v) { return strtolower($v['vh_name_vc']); }, $plan['domains']);
$nm = 0;
if ($plan['mail'] || $counts['x_aliases'] || $counts['x_forwarders'] || $counts['x_distlists']) {
    foreach ($plan['mail'] as $m) {
        $zdbh->prepare("INSERT INTO x_mailboxes (mb_acc_fk, mb_address_vc, mb_enabled_in, mb_created_ts) VALUES (?,?,?,?)")
            ->execute(array($NEWID, $m['mb_address_vc'], $m['mb_enabled_in'], $m['mb_created_ts'] ?: time()));
        $nm++;
    }
    foreach (array('x_aliases' => array('al', 'al_address_vc, al_destination_vc'), 'x_forwarders' => array('fw', 'fw_address_vc, fw_destination_vc, fw_keepmessage_in')) as $t => $p) {
        foreach ($old("SELECT * FROM `$O`.$t WHERE {$p[0]}_acc_fk = :a AND {$p[0]}_deleted_ts IS NULL", array(':a' => $OLDID)) as $r) {
            if ($taken("SELECT COUNT(*) FROM $t WHERE {$p[0]}_address_vc = :x AND {$p[0]}_deleted_ts IS NULL", array(':x' => $r[$p[0] . '_address_vc']))) { continue; }
            $fields = array_map('trim', explode(',', $p[1]));
            $vals = array_map(function ($f) use ($r) { return $r[$f]; }, $fields);
            $zdbh->prepare("INSERT INTO $t ({$p[0]}_acc_fk, " . implode(',', $fields) . ", {$p[0]}_created_ts) VALUES (?," . implode(',', array_fill(0, count($fields), '?')) . ",?)")
                ->execute(array_merge(array($NEWID), $vals, array($r[$p[0] . '_created_ts'] ?: time())));
        }
    }
    foreach ($old("SELECT * FROM `$O`.x_distlists WHERE dl_acc_fk = :a AND dl_deleted_ts IS NULL", array(':a' => $OLDID)) as $d) {
        if ($taken("SELECT COUNT(*) FROM x_distlists WHERE dl_address_vc = :x AND dl_deleted_ts IS NULL", array(':x' => $d['dl_address_vc']))) { continue; }
        $zdbh->prepare("INSERT INTO x_distlists (dl_acc_fk, dl_address_vc, dl_created_ts) VALUES (?,?,?)")->execute(array($NEWID, $d['dl_address_vc'], $d['dl_created_ts'] ?: time()));
        $nid = (int) $zdbh->lastInsertId();
        foreach ($old("SELECT * FROM `$O`.x_distlistusers WHERE du_distlist_fk = :d AND du_deleted_ts IS NULL", array(':d' => $d['dl_id_pk'])) as $u) {
            $zdbh->prepare("INSERT INTO x_distlistusers (du_distlist_fk, du_address_vc, du_created_ts) VALUES (?,?,?)")->execute(array($nid, $u['du_address_vc'], $u['du_created_ts'] ?: time()));
        }
    }
    // the mail server's own tables, for the moved domains only (passwords as they are: the mail
    // server reads the old {PLAIN-MD5} ones too)
    if ($HAVE_MAILDB && $domains) {
        $in = implode(',', array_map(array($zdbh, 'quote'), $domains));
        foreach (array('domain' => 'domain', 'mailbox' => 'domain', 'alias' => 'domain') as $t => $col) {
            $have = $cols('sentora_postfix', $t);
            $from = array_values(array_intersect($cols($TMPDB . '_mail', $t), $have));
            if (!$from) { continue; }
            $list = '`' . implode('`,`', $from) . '`';
            $zdbh->exec("INSERT IGNORE INTO sentora_postfix.`$t` ($list) SELECT $list FROM `{$TMPDB}_mail`.`$t` WHERE LOWER(`$col`) IN ($in)");
        }
    }
    // the mail itself
    foreach ($domains as $d) {
        $tar = $EXP . '/mail/' . $d . '.tar.gz';
        if (is_file($tar)) {
            sh('tar -xzf ' . q($tar) . ' -C /var/sentora/vmail --no-same-owner --skip-old-files', $o) || warn("the mail of $d did not unpack completely: " . substr($o, 0, 200));
            sh('chown -R vmail:mail ' . q('/var/sentora/vmail/' . $d));
        }
    }
}
ui_info("$nm mailbox(es)" . ($nm ? ' with their mail and passwords' : ''));

// webmail data: Roundcube's user and what hangs on it (new IDs here); a mailbox that already used
// webmail here keeps what it has
if ($rcOld && $RCHAVE) {
    $mailHost = (string) $zdbh->query("SELECT mail_host FROM `$RCNEW`.users ORDER BY user_id LIMIT 1")->fetchColumn() ?: 'localhost';
    $copy = function ($table, $row, $skip) use ($cols, $RCNEW) {
        static $colCache = array();
        if (!isset($colCache[$table])) { $colCache[$table] = $cols($RCNEW, $table); }
        $row = array_diff_key(array_intersect_key($row, array_flip($colCache[$table])), array_flip($skip));
        if (!$row) { return 0; }
        $GLOBALS['zdbh']->prepare("INSERT INTO `$RCNEW`.`$table` (`" . implode('`,`', array_keys($row)) . "`) VALUES (" . implode(',', array_fill(0, count($row), '?')) . ")")->execute(array_values($row));
        return (int) $GLOBALS['zdbh']->lastInsertId();
    };
    $rcDone = array(); $rcKept = array();
    foreach ($rcOld as $addr => $ouid) {
        if ($taken("SELECT COUNT(*) FROM `$RCNEW`.users WHERE LOWER(username) = :u", array(':u' => $addr))) { $rcKept[] = $addr; continue; }
        try {
            $u = $old("SELECT * FROM `{$TMPDB}_rc`.users WHERE user_id = :i", array(':i' => $ouid))[0];
            $u['mail_host'] = $mailHost;
            $nuid = $copy('users', $u, array('user_id'));
            foreach ($old("SELECT * FROM `{$TMPDB}_rc`.identities WHERE user_id = :i AND del = 0", array(':i' => $ouid)) as $r) { $r['user_id'] = $nuid; $copy('identities', $r, array('identity_id')); }
            $cmap = array(); $gmap = array();
            foreach ($old("SELECT * FROM `{$TMPDB}_rc`.contacts WHERE user_id = :i AND del = 0", array(':i' => $ouid)) as $r) { $r['user_id'] = $nuid; $cmap[(int) $r['contact_id']] = $copy('contacts', $r, array('contact_id')); }
            foreach ($old("SELECT * FROM `{$TMPDB}_rc`.contactgroups WHERE user_id = :i AND del = 0", array(':i' => $ouid)) as $r) { $r['user_id'] = $nuid; $gmap[(int) $r['contactgroup_id']] = $copy('contactgroups', $r, array('contactgroup_id')); }
            if ($gmap) {
                foreach ($old("SELECT * FROM `{$TMPDB}_rc`.contactgroupmembers WHERE contactgroup_id IN (" . implode(',', array_map('intval', array_keys($gmap))) . ")") as $r) {
                    if (isset($cmap[(int) $r['contact_id']])) { $r['contactgroup_id'] = $gmap[(int) $r['contactgroup_id']]; $r['contact_id'] = $cmap[(int) $r['contact_id']]; $copy('contactgroupmembers', $r, array()); }
                }
            }
            foreach (array('responses' => 'response_id', 'collected_addresses' => 'address_id') as $t => $pk) {
                if ($cols($TMPDB . '_rc', $t) && $cols($RCNEW, $t)) {
                    foreach ($old("SELECT * FROM `{$TMPDB}_rc`.`$t` WHERE user_id = :i", array(':i' => $ouid)) as $r) { $r['user_id'] = $nuid; try { $copy($t, $r, array($pk)); } catch (Exception $e) { } }
                }
            }
            $rcDone[] = $addr;
        } catch (Exception $e) {
            warn("webmail data of $addr not moved: " . $e->getMessage());
        }
    }
    $rcDone && ui_info('webmail data (address books, identities, settings): ' . implode(', ', $rcDone));
    $rcKept && warn('webmail data not moved for ' . implode(', ', $rcKept) . ': these mailboxes have used webmail here already (theirs is kept)');
}

// mail filters: each mailbox's old Sieve scripts into its folder here (<domain>/.home/<user>/sieve), the
// active one linked as dovecot.sieve; a mailbox that has filters here already keeps them
if ($sieveOld) {
    $stg = $STAGE . '-sieve';
    @mkdir($stg, 0700, true);
    sh('tar -xzf ' . q($SIEVETAR) . ' -C ' . q($stg) . ' --no-same-owner', $o) || warn('the mail filters did not unpack completely: ' . substr($o, 0, 200));
    $parent = rtrim(dirname($sieveBase), '/');
    $sDone = array(); $sKept = array();
    foreach ($sieveOld as $addr => $p) {
        list($local, $dom) = explode('@', $addr, 2);
        $home = '/var/sentora/vmail/' . $dom . '/.home/' . $local;
        if (is_dir($home . '/sieve') && glob($home . '/sieve/*.sieve') || file_exists($home . '/dovecot.sieve')) { $sKept[] = $addr; continue; }
        @mkdir($home . '/sieve', 0700, true);
        $oldDir = $stg . substr($p['dir'], strlen($parent));
        $oldAct = $stg . substr($p['active'], strlen($parent));
        foreach (glob($oldDir . '/*.sieve') ?: array() as $f) {
            if (is_file($f) && !is_link($f)) { copy($f, $home . '/sieve/' . basename($f)); }
        }
        $active = '';
        if (is_link($oldAct)) {
            $t = basename((string) readlink($oldAct));
            if (is_file($home . '/sieve/' . $t)) { $active = $t; }
        } elseif (is_file($oldAct)) {
            copy($oldAct, $home . '/sieve/migrated.sieve');
            $active = 'migrated.sieve';
        }
        if ($active !== '') {
            @symlink('sieve/' . $active, $home . '/dovecot.sieve');
        }
        sh('chown -R vmail:mail ' . q('/var/sentora/vmail/' . $dom . '/.home'), $o) || warn("the mail filters of $addr could not be given to the mail user (vmail): " . substr($o, 0, 120));
        $sDone[] = $addr;
    }
    $sDone && ui_info('mail filters and out-of-office replies: ' . implode(', ', $sDone));
    $sKept && warn('mail filters not moved for ' . implode(', ', $sKept) . ': these mailboxes have filters here already (theirs are kept)');
}

// the account's own FAQ entries
if ($FAQS) {
    $nf = 0;
    foreach ($FAQS as $f) {
        if ($taken("SELECT COUNT(*) FROM x_faqs WHERE fq_acc_fk = :a AND fq_question_tx = :q AND fq_deleted_ts IS NULL", array(':a' => $NEWID, ':q' => $f['fq_question_tx']))) { continue; }
        $zdbh->prepare("INSERT INTO x_faqs (fq_acc_fk, fq_question_tx, fq_answer_tx, fq_global_in, fq_created_ts) VALUES (?,?,?,?,?)")
            ->execute(array($NEWID, $f['fq_question_tx'], $f['fq_answer_tx'], (int) $f['fq_global_in'], $f['fq_created_ts'] ?: time()));
        $nf++;
    }
    ui_info("$nf FAQ entr" . ($nf === 1 ? 'y' : 'ies') . ' (written on the old panel)');
}

// --- let the daemon build it all ------------------------------------------------------------------
$zdbh->exec("UPDATE x_settings SET so_value_tx = 'true' WHERE so_name_vc = 'apache_changed'");
ui_step('Running the Sentora daemon (websites, PHP pool, DNS, FTP, cron, permissions)');
getenv('SENTORA_MIGRATE_NO_DAEMON') || sh('php -q ' . q($rootPath . 'bin/daemon.php') . ' > /var/sentora/logs/daemon-last-run.log', $o) || warn('the daemon run reported problems (see /var/sentora/logs/daemon-last-run.log)');
if (posix_getpwnam('web' . $NEWID) && is_dir($NEWHOME)) {
    sys_accountphp::SetPermissions('web' . $NEWID, rtrim($NEWHOME, '/'));
}
cleanup();

// --- what to check ------------------------------------------------------------------------------------
ui_done();
echo "\n";
if ($WARN) {
    ui_bar('bg_warn', "  $OLDU is moved into $NEWU, with $WARN warning(s) (above, and in the log)");
} else {
    ui_bar('bg_ok', "  $OLDU is moved into $NEWU");
}
ui_logline("Done: $OLDU is in $NEWU, with $WARN warning(s)");
echo "\n";
if ($CREATED_PW) {
    echo '  ' . c('bold') . c('yellow') . 'New panel logins' . c('reset') . c('dim') . '  (accounts made here; give each client theirs, they can change it in the panel; also in ' . $pwFile . ')' . c('reset') . "\n";
    foreach ($CREATED_PW as $u => $pw) { printf("     %-20s %s\n", $u, $pw); ui_logline("panel login made: $u (password shown on screen and in $pwFile)"); }
    echo "\n";
}
if ($newpass) {
    echo '  ' . c('bold') . c('yellow') . 'New passwords' . c('reset') . c('dim') . "  (these had none that could be used again: change the sites' settings to match)" . c('reset') . "\n";
    foreach ($newpass as $p) { echo "     $p\n"; ui_logline('new password: ' . preg_replace('/:.*/', ': (shown on screen)', $p)); }
    echo "\n";
}
// (still there: they were not fixed above)
if ($HTFOUND) {
    echo '  ' . c('bold') . c('yellow') . 'Error 500 ahead' . c('reset') . c('dim') . '  these sites will not work until their .htaccess lines are changed. Run the move again with' . c('reset') . "\n";
    echo '     ' . c('dim') . '--fix-htaccess to change them for you, or change them by hand (Apache Admin > the domain: "A moved site gives error 500?"):' . c('reset') . "\n";
    foreach (array_keys($HTFOUND) as $p) { echo '     ' . substr($p, strlen($HOSTED)) . "\n"; ui_logline('.htaccess left: ' . $p); }
    echo "\n";
}
if ($SYMON) {
    echo '  ' . c('bold') . c('yellow') . 'FollowSymLinks on' . c('reset') . c('dim') . '  for: ' . implode(', ', array_keys($SYMON)) . c('reset') . "\n";
    echo "     Once each site's .htaccess uses \"Options +SymLinksIfOwnerMatch\", switch it off in Apache Admin > the domain.\n\n";
}
echo '  ' . c('bold') . 'Next' . c('reset') . "\n";
echo "     1. Point the domains' DNS to this server ($NEWIP), then open each site.\n";
if ($PHPV !== '' && sys_phpversions::IsMigrationOnly($PHPV)) {
    echo "     2. Move each site to PHP 8 once it runs (the domain's PHP choice): PHP $PHPV gets no security fixes.\n";
}
echo '     ' . c('dim') . "This server's panel databases from before: $PRE    Log: $LOG" . c('reset') . "\n\n";
exit($WARN ? 3 : 0);
