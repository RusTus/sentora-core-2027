    sh('tar -xzf ' . q($filesTar) . ' -C ' . q($htStage) . ' --no-same-owner --wildcards ' . q('*/.htaccess') . ' ' . q('.htaccess'), $o);
    $HTFOUND = htaccess_scan($htStage . '/' . $OLDU . '/public_html');
    $HTBASE = $htStage . '/' . $OLDU . '/';
}

