// --- Laravel sites: the caches that hold the old server's settings ----------------------------------
/**
 * Clear the caches of the Laravel (and Lumen) apps under a folder that were made on the old server,
 * so each app reads its .env again and compiles its templates here. Only caches Laravel rebuilds by
 * itself are removed, and nothing of the app is run:
 *   - the cached settings (bootstrap/cache/config.php; storage/framework/config.php in Laravel 5.0),
 *     which hold the old server's settings and paths, and win over .env. Kept when the app has no
 *     .env (an app deployed with its settings cached and .env removed would lose them). Not kept as
 *     a copy: it holds the database password.
 *   - the compiled templates (storage/framework/views/*.php; app/storage/views in Laravel 4).
 * An app is a folder with both artisan and bootstrap/app.php; vendor/ and node_modules/ are skipped,
 * and symbolic links are not followed.
 *
 * @param string $root The folder (an account's public_html).
 * @return string[] One line per app, for the output.
 */
function laravel_caches($root)
{
    $out = array();
    sh('find ' . q($root) . ' -maxdepth 6 \( -name vendor -o -name node_modules \) -prune -o -type f -name artisan -print', $o);
    foreach (array_filter(explode("\n", (string) $o)) as $artisan) {
        $app = dirname($artisan);
        if (!is_file($app . '/bootstrap/app.php') || is_link($app . '/bootstrap') || is_link($app . '/storage')) {
            continue;
        }
        $rel = ltrim(substr($app, strlen($root)), '/');
        $rel = $rel === '' ? 'public_html' : $rel;
        $did = array();
        $kept = '';
        foreach (array('bootstrap/cache/config.php', 'storage/framework/config.php') as $c) {
            if (is_file($app . '/' . $c) && !is_link($app . '/' . $c)) {
                if (is_file($app . '/.env')) {
                    @unlink($app . '/' . $c) && $did[] = 'cached settings';
                } else {
                    $kept = '; its cached settings kept (it has no .env, so they may be its only settings)';
                }
            }
        }
        $n = 0;
        foreach (array('storage/framework/views', 'app/storage/views') as $v) {
            if (is_dir($app . '/' . $v) && !is_link($app . '/' . $v)) {
                foreach (glob($app . '/' . $v . '/*.php') ?: array() as $f) {
                    if (is_file($f) && !is_link($f) && @unlink($f)) { $n++; }
                }
            }
        }
        if ($n) { $did[] = "$n compiled template(s)"; }
        $out[] = 'Laravel app ' . $rel . ': ' . ($did ? 'cleared ' . implode(' and ', $did) . ' (rebuilt on its next page)' : 'no old caches') . $kept;
    }
    return $out;
}

// --- Magento and OpenCart: the cache files made on the old server --------------------------------------
/**
 * Empty a cache folder: what is in it goes (not the folder; symbolic links are removed, never followed).
 *
 * @param string $dir The folder.
 * @param string $only Optional. A glob of the names to remove (default: everything).
 * @param string[] $keep Optional. Names to keep (such as index.html).
 * @return int How many entries were removed.
 */
function empty_cache_dir($dir, $only = '*', array $keep = array())
{
    if (!is_dir($dir) || is_link($dir)) {
        return 0;
    }
    $n = 0;
    foreach (glob(rtrim($dir, '/') . '/' . $only, GLOB_NOSORT) ?: array() as $e) {
        if (in_array(basename($e), $keep, true) || in_array(basename($e), array('.', '..'), true)) {
            continue;
        }
        if (sh('rm -rf -- ' . q($e))) {
            $n++;
        }
    }
    return $n;
}

/**
 * Clear the caches of the Magento (1 and 2) and OpenCart shops under a folder, made on the old server: they
 * hold its state and are rebuilt by the shop on its next page. Only cache files: never Magento 2's generated/
 * or pub/static (in production mode the shop can not rebuild them by itself), and nothing of the shop is run.
 * vendor/ and node_modules/ are skipped.
 *
 * @param string $root The folder (an account's public_html).
 * @return string[] One line per shop, for the output.
 */
function shop_caches($root)
{
    $out = array();
    sh('find ' . q($root) . ' -maxdepth 6 \( -name vendor -o -name node_modules \) -prune -o -type f \( -path "*/bin/magento" -o -path "*/app/Mage.php" -o -path "*/system/startup.php" \) -print', $o);
    foreach (array_filter(explode("\n", (string) $o)) as $marker) {
        $rel = function ($app) use ($root) { $r = ltrim(substr($app, strlen($root)), '/'); return $r === '' ? 'public_html' : $r; };
        if (substr($marker, -strlen('/bin/magento')) === '/bin/magento') {
            $app = dirname(dirname($marker));
            if (!is_file($app . '/app/etc/env.php') || is_link($app . '/var')) {
                continue;
            }
            $n = empty_cache_dir($app . '/var/cache') + empty_cache_dir($app . '/var/page_cache');
            $env = (string) @file_get_contents($app . '/app/etc/env.php');
            $redis = stripos($env, 'redis') !== false ? '; it also keeps cache in Redis, which is not cleared here (bin/magento cache:flush there)' : '';
            $out[] = 'Magento 2 shop ' . $rel($app) . ': ' . ($n ? "cleared its cache ($n entr" . ($n === 1 ? 'y' : 'ies') . '), rebuilt on its next page' : 'no old cache files') . $redis;
        } elseif (substr($marker, -strlen('/app/Mage.php')) === '/app/Mage.php') {
            $app = dirname(dirname($marker));
            if (is_link($app . '/var')) {
                continue;
            }
            $n = empty_cache_dir($app . '/var/cache') + empty_cache_dir($app . '/var/full_page_cache');
            $out[] = 'Magento 1 shop ' . $rel($app) . ': ' . ($n ? "cleared its cache ($n entr" . ($n === 1 ? 'y' : 'ies') . '), rebuilt on its next page' : 'no old cache files');
        } else {
            $app = dirname(dirname($marker));
            if (!is_file($app . '/config.php') || !is_dir($app . '/catalog')) {
                continue;
            }
            // its cache folder: system/storage/cache (OpenCart 2.2 and later) or system/cache
            $n = 0;
            foreach (array('system/storage/cache', 'system/cache') as $c) {
                $n += empty_cache_dir($app . '/' . $c, 'cache.*', array('index.html'));
            }
            $out[] = 'OpenCart shop ' . $rel($app) . ': ' . ($n ? "cleared $n cache file(s), rebuilt on its next page" : 'no old cache files');
        }
    }
    return $out;
}

// --- the websites' .htaccess files: the lines this server refuses with error 500 ---------------------
/**
 * Each .htaccess under a folder that has lines this server refuses (sys_htaccessfix).
 *
 * @param string $root The folder (an account's public_html, or an unpacked copy of it).
 * @param string[] $symDirs Folders (with a trailing /) of domains with "Allow FollowSymLinks" on.
 * @return array<string, array> path => sys_htaccessfix::Fix() result.
 */
function htaccess_scan($root, array $symDirs = array())
{
    $found = array();
    if (!is_dir($root)) { return $found; }
    $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::LEAVES_ONLY, RecursiveIteratorIterator::CATCH_GET_CHILD);
    foreach ($it as $f) {
        if ($f->getFilename() !== '.htaccess' || $f->isLink() || !$f->isFile()) { continue; }
        $p = $f->getPathname();
        $sym = false;
        foreach ($symDirs as $d) { if (strpos($p, $d) === 0) { $sym = true; } }
        $r = sys_htaccessfix::Fix((string) file_get_contents($p), $sym);
        if ($r['changes']) { $found[$p] = $r; }
    }
    ksort($found);
    return $found;
}
/**
 * Show what would change in each file.
 *
 * @param array<string, array> $found From htaccess_scan().
 * @param string $base Cut from the start of each path shown.
 * @return void
 */
function htaccess_show(array $found, $base)
{
    foreach ($found as $p => $r) {
        echo '     ' . c('bold') . substr($p, strlen($base)) . c('reset') . "\n";
        foreach ($r['changes'] as $ch) {
            printf("        %s%-4s%s %s\n%s             -> %s%s  %s(%s)%s\n", c('dim'), $ch['line'], c('reset'), $ch['from'], '', c('green'), $ch['to'], c('dim'), $ch['why'], c('reset'));
        }
    }
}
