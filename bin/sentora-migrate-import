#!/usr/bin/php
<?php
/**
 * sentora-migrate-import (run as root on the Sentora-2027 server): take accounts of an old
 * Sentora server (1.0.x or 2.0.x) over from a folder made there by sentora-migrate-export.
 *
 *   sentora-migrate-import <export folder>                                  what it holds
 *   sentora-migrate-import <export folder> <old account> [<new account>]       what would be done (nothing changes)
 *   sentora-migrate-import <export folder> <old account> [<new account>] --yes do it
 *   sentora-migrate-import <export folder> --all [--yes]                       every account in the export, one after another
 *     (without <new account>, the account of the same name here: clients keep their names)
 *     --php <version>   the domains' PHP version. Default: 7.1, the version for moving old sites (it is
 *                       switched on in PHP Versions if it is off); --php default for the server's own PHP 8
 *     --keep-ip         leave DNS records that point to the old server's IP address as they are
 *     --overwrite       replace website files that are already there (default: keep them)
 *     --allow-symlinks  switch "Allow FollowSymLinks" on (Apache Admin) for the domains that need it: their
 *                       custom Apache settings or an .htaccess in their folder use FollowSymLinks. Off by
 *                       default: such lines are then switched off, and those sites give error 500 until
 *                       their .htaccess uses "Options +SymLinksIfOwnerMatch" (they are listed)
 *     --fix-htaccess    change the sites' .htaccess lines this server refuses with error 500 without
 *                       asking (Options FollowSymLinks/All/ExecCGI/Includes, php_value/php_flag, which
 *                       move to a .user.ini); each changed file is kept as .htaccess.before-migrate
 *     --no-fix-htaccess only list them (the default when there is no keyboard to ask on)
 *
 * An account moved under its own name that is not here yet is made from the old one, matched by NAME,
 * not by the old panel's IDs: its owner (the old reseller, made first when missing; the old zadmin is
 * this server's administrator), its package (with the old limits) and its group (with the modules that
 * exist here) are looked up by name and made when missing; it gets the old contact details and a new
 * panel password, shown at the end and saved in /root/sentora-migrate-passwords-<date>.txt (root only).
 * What each old account, package, group and domain became is recorded in x_migrate_map (old server, kind,
 * old ID and name, new ID, made or matched), and looked up first by a later run: an account renamed here
 * after its move is still found. Moved under another name, the new account must exist first (Admin >
 * Manage Clients). Moved for it: its domains,
 * sub-domains and parked domains, their website files, DNS records, MySQL databases and users (with
 * their passwords, so the sites' settings keep working), FTP accounts, cron jobs, protected folders,
 * mailboxes (with their mail, webmail address books, identities and settings, and Sieve filters and
 * out-of-office replies), aliases, forwarders and distribution lists, and the account's own FAQ entries. Never moved: the old
 * panel itself (its modules, custom ones included, and add-ons, settings, themes and translations). A name that is already
 * taken on this server is skipped and reported. Laravel apps (Snipe-IT and the like) get their old
 * caches cleared (cached settings, when the app has a .env, and compiled templates), so they read
 * their .env again here. Before anything is changed, the panel's databases
 * are saved in /var/sentora/backups/pre-migrate-<date>/. Log: /var/sentora/logs/migrate-import.log
 *
 * @package Sentora
 * @license GPL-3.0 https://www.gnu.org/licenses/gpl-3.0.html
 *
 * Written by RusTus, 2026-11-09
 */
$rootPath = str_replace('/bin', '/', str_replace("\\", '/', dirname(__FILE__)));
chdir($rootPath);
require_once 'dryden/loader.inc.php';
require_once 'cnf/db.php';
require_once 'inc/dbc.inc.php';
if (!runtime_controller::IsCLI()) {
    exit(1);
}
if (!function_exists('posix_geteuid') || posix_geteuid() !== 0) {
    fwrite(STDERR, "Run this as root.\n");
    exit(1);
}

/** @var array<int, string> $args The positional arguments. */
$args = array();
$opt = array('yes' => false, 'php' => '7.1', 'keep-ip' => false, 'overwrite' => false, 'allow-symlinks' => false, 'fix-htaccess' => null, 'all' => false);
for ($i = 1; $i < $argc; $i++) {
    $a = $argv[$i];
    if ($a === '--yes') { $opt['yes'] = true; }
    elseif ($a === '--keep-ip') { $opt['keep-ip'] = true; }
    elseif ($a === '--overwrite') { $opt['overwrite'] = true; }
    elseif ($a === '--allow-symlinks') { $opt['allow-symlinks'] = true; }
    elseif ($a === '--fix-htaccess') { $opt['fix-htaccess'] = true; }
    elseif ($a === '--no-fix-htaccess') { $opt['fix-htaccess'] = false; }
    elseif ($a === '--all') { $opt['all'] = true; }
    elseif ($a === '--php') { $opt['php'] = (string) ($argv[++$i] ?? ''); }
    elseif ($a === '-h' || $a === '--help') { $args = array(); break; }
    elseif (strncmp($a, '--', 2) === 0) { fwrite(STDERR, "Unknown option $a\n"); exit(2); }
    else { $args[] = $a; }
}
if (!$args) {
    // the description at the top of this file, up to its first blank comment line
    foreach (array_slice(file(__FILE__), 3) as $l) {
        if (trim($l) === '*') {
            break;
        }
        echo preg_replace('/^ \* ?/', '', rtrim($l)), "\n";
    }
    exit(2);
}

$LOG = '/var/sentora/logs/migrate-import.log';
@touch($LOG);
@chmod($LOG, 0640);
$WARN = 0;

// --- the screen: the installer's look --------------------------------------------------------------
// A title bar, then one line per finished step ([ OK ], [ !! ] or [FAIL], with its time) and a
// progress bar below while a step runs (it keeps moving while a long command works). The details
// go to the log; plain lines when the output is not a terminal.
$UI = array('tty' => function_exists('posix_isatty') && posix_isatty(STDOUT) && getenv('TERM') && getenv('TERM') !== 'dumb',
    'step' => 0, 'total' => 1, 'title' => '', 'start' => time(), 'stepstart' => 0, 'stepwarn' => false, 'drawn' => false, 'spin' => 0,
    'notes' => array());   // the running step's details: shown under its line when it ends
$UI['utf8'] = (bool) preg_match('/utf-?8/i', (string) (getenv('LC_ALL') ?: getenv('LC_CTYPE') ?: getenv('LANG')));
function c($name)
{
    global $UI;
    static $codes = array('reset' => "\e[0m", 'bold' => "\e[1m", 'dim' => "\e[2m", 'green' => "\e[32m", 'yellow' => "\e[33m", 'red' => "\e[31m",
        'cyan' => "\e[36m", 'white' => "\e[97m", 'bg_title' => "\e[44m", 'bg_ok' => "\e[42m", 'bg_warn' => "\e[43m", 'bg_fail' => "\e[41m");
    return $UI['tty'] ? $codes[$name] : '';
}
function ui_cols() { $c = (int) @exec('tput cols 2> /dev/null'); return $c >= 40 ? $c : 80; }
function ui_logline($s) { global $LOG; @file_put_contents($LOG, date('Y-m-d H:i:s') . '  ' . $s . "\n", FILE_APPEND); }
function ui_clear() { global $UI; if ($UI['tty'] && $UI['drawn']) { echo "\r\e[K"; $UI['drawn'] = false; } }
// "Ubuntu 26.04" or "Debian 13": the system this runs on
function ui_os()
{
    $o = @parse_ini_file('/etc/os-release') ?: array();
    return strtok((string) ($o['NAME'] ?? 'Linux'), ' ') . (isset($o['VERSION_ID']) ? ' ' . $o['VERSION_ID'] : '');
}
function ui_bar($bg, $text) { echo c($bg) . c('bold') . c('white') . str_pad($text, ui_cols()) . c('reset') . "\n"; }
function ui_banner($sub)
{
    global $UI;
    $ver = trim((string) @file_get_contents(dirname(__DIR__) . '/VERSION'));
    // a clean screen to start on, like "clear" (on a terminal only: the screen and its scrollback)
    echo $UI['tty'] && !getenv('SENTORA_MIGRATE_CHILD') ? "\e[H\e[2J\e[3J" : '', "\n";
    ui_bar('bg_title', '  Sentora-' . ($ver !== '' ? preg_replace('/[^A-Za-z0-9._-]/', '', $ver) : '2027') . ' for ' . ui_os() . '  -  Moving accounts from an old server');
    if ($sub !== '') { echo c('dim') . '  ' . $sub . c('reset') . "\n"; }
    echo "\n";
}
function ui_draw()
{
    global $UI;
    if (!$UI['tty'] || $UI['title'] === '') { return; }
    $cols = ui_cols();
    $width = max(10, min(30, intdiv($cols, 4)));
    $pct = min(99, intdiv(($UI['step'] - 1) * 100, max(1, $UI['total'])));
    $filled = intdiv($pct * $width, 100);
    $el = time() - $UI['stepstart'];
    $times = sprintf('%d:%02d', intdiv($el, 60), $el % 60);
    $room = $cols - $width - 16 - strlen((string) $UI['step']) - strlen((string) $UI['total']) - strlen($times) - 4;
    $title = strlen($UI['title']) > $room ? substr($UI['title'], 0, max(0, $room - 3)) . '...' : $UI['title'];
    $spin = array('|', '/', '-', '\\');
    $full = $UI['utf8'] ? "\u{2588}" : '#';
    $empty = $UI['utf8'] ? "\u{2591}" : '.';
    echo "\r\e[K " . c('green') . str_repeat($full, $filled) . c('dim') . str_repeat($empty, $width - $filled) . c('reset')
        . sprintf(' %3d%%  %d/%d  ', $pct, $UI['step'], $UI['total']) . c('cyan') . $spin[$UI['spin']++ % 4] . c('reset') . ' '
        . str_pad($title, max(0, $room)) . ' ' . c('dim') . $times . c('reset');
    $UI['drawn'] = true;
}
// a line under the running step (the progress bar is drawn again below it)
function ui_line($s) { ui_clear(); echo $s, "\n"; ui_draw(); }
function ui_note($line) { global $UI; if ($UI['title'] !== '') { $UI['notes'][] = $line; } else { ui_line($line); } }
function ui_info($s) { ui_logline($s); ui_note('         ' . c('dim') . $s . c('reset')); }
function ui_end_step($fail = false)
{
    global $UI;
    ui_clear();
    if ($UI['title'] === '') { return; }
    $took = time() - $UI['stepstart'];
    list($mark, $color) = $fail ? array('[FAIL]', c('red') . c('bold')) : ($UI['stepwarn'] ? array('[ !! ]', c('yellow')) : array('[ OK ]', c('green')));
    printf("  %s%s%s %s %s(%d:%02d)%s\n", $color, $mark, c('reset'), $UI['title'], c('dim'), intdiv($took, 60), $took % 60, c('reset'));
    foreach ($UI['notes'] as $n) { echo $n, "\n"; }
    $UI['notes'] = array();
    ui_logline(($fail ? 'FAILED: ' : 'done: ') . $UI['title']);
    $UI['title'] = '';
}
function ui_step($title)
{
    global $UI;
    ui_end_step();
    $UI['step']++;
    $UI['total'] = max($UI['total'], $UI['step']);
    $UI['title'] = $title;
    $UI['stepstart'] = time();
    $UI['stepwarn'] = false;
    ui_logline('-- ' . $title);
    if ($UI['tty']) { ui_draw(); } else { printf("-- [%d/%d] %s\n", $UI['step'], $UI['total'], $title); }
}
function ui_done()
{
    global $UI;
    ui_end_step();
    if ($UI['tty']) {
        $width = max(10, min(30, intdiv(ui_cols(), 4)));
        $t = time() - $UI['start'];
        printf(" %s%s%s 100%%  %sall %d steps done in %d:%02d%s\n", c('green'), str_repeat($UI['utf8'] ? "\u{2588}" : '#', $width), c('reset'), c('bold'), $UI['step'], intdiv($t, 60), $t % 60, c('reset'));
    }
}
// say: the log, and a line under the running step
function say($s) { ui_logline($s); ui_note($s === '' ? '' : '         ' . $s); }
function warn($s) { global $WARN, $UI; $WARN++; $UI['stepwarn'] = true; ui_logline('WARNING: ' . $s); ui_note('         ' . c('yellow') . $s . c('reset')); }
function stop($s)
{
    global $LOG;
    ui_logline('STOPPED: ' . $s);
    ui_end_step(true);
    echo "\n";
    ui_bar('bg_fail', '  Stopped: nothing more was changed');
    echo "\n  " . $s . "\n  " . c('dim') . 'Log: ' . $LOG . c('reset') . "\n\n";
    cleanup();
    exit(1);
}
// a command: its output to the log; the progress bar keeps moving while it runs
function sh($cmd, &$out = null)
{
    $p = proc_open(array('/bin/sh', '-c', $cmd . ' 2>&1'), array(1 => array('pipe', 'w')), $pipes);
    if (!is_resource($p)) { $out = 'could not start: ' . $cmd; return false; }
    stream_set_blocking($pipes[1], false);
    $buf = '';
    $last = microtime(true);
    while (true) {
        $chunk = fread($pipes[1], 65536);
        if ($chunk !== false && $chunk !== '') { $buf .= $chunk; if (strlen($buf) > 1048576) { $buf = substr($buf, -524288); } }
        $st = proc_get_status($p);
        if (!$st['running']) { break; }
        if (microtime(true) - $last >= 0.25) { ui_draw(); $last = microtime(true); }
        usleep(50000);
    }
    $buf .= (string) stream_get_contents($pipes[1]);
    fclose($pipes[1]);
    $rc = $st['exitcode'];
    proc_close($p);
    $out = rtrim($buf);
    if ($out !== '') { ui_logline('   ' . str_replace("\n", "\n   ", substr($out, 0, 4000))); }
    return $rc === 0;
}
function q($s) { return escapeshellarg((string) $s); }
function hsize($bytes) { $u = array('B', 'KB', 'MB', 'GB', 'TB'); $i = 0; $b = (float) $bytes; while ($b >= 1024 && $i < 4) { $b /= 1024; $i++; } return ($i ? round($b, $b < 10 ? 1 : 0) : (int) $b) . ' ' . $u[$i]; }

// --- the export folder ------------------------------------------------------------------------------
$EXP = rtrim(realpath($args[0]) ?: '', '/');
if ($EXP === '' || !is_dir($EXP)) {
    $near = glob(dirname($args[0] === '' ? '.' : $args[0]) . '/sentora-export-*', GLOB_ONLYDIR) ?: array();
    fwrite(STDERR, "$args[0] was not found on this server: copy the export folder here first (the export prints the scp command).\n"
        . ($near ? "Export folders here: " . implode(', ', array_map('basename', $near)) . "\n" : ''));
    exit(1);
}
if (!is_file($EXP . '/manifest.txt')) {
    fwrite(STDERR, "$args[0] is not a complete folder made by sentora-migrate-export (it has no manifest.txt): copy it again.\n");
    exit(1);
}
$M = array('accounts' => array());
foreach (file($EXP . '/manifest.txt', FILE_IGNORE_NEW_LINES) as $l) {
    if (strpos($l, 'account=') === 0) {
        $M['accounts'][] = substr($l, 8);
    } elseif (strpos($l, '=') !== false) {
        list($k, $v) = explode('=', $l, 2);
        $M[$k] = $v;
    }
}
if (($M['format'] ?? '') !== 'sentora-migrate-1') {
    fwrite(STDERR, "This export's format is not one this panel reads (format=" . ($M['format'] ?? '?') . ").\n");
    exit(1);
}
// --- every account in the export, one after another (--all) ---------------------------------------
// Each account is moved by this same command (so each gets the same checks, matching by name and
// x_migrate_map), after the copy's checksums are checked once; an account whose reseller is not here yet
// gets it made first, and that reseller's own run then adds its websites. One that fails does not stop the
// others. The daemon runs once at the end.
if ($opt['all']) {
    $names = array();
    foreach ($M['accounts'] as $a) {
        if (preg_match('/^([A-Za-z0-9_-]{1,64}) /', $a, $m)) {
            $names[] = $m[1];
        }
    }
    $APPLY = $opt['yes'];
    ui_banner(($APPLY ? 'Moving every account' : 'What moving every account would do (nothing changes until --yes)') . ' from ' . $M['server'] . ' (Sentora ' . $M['sentora'] . '): ' . count($names));
    if (!$names) {
        echo "  The export lists no accounts.\n\n";
        exit(1);
    }
    $UI['total'] = 1;
    ui_step('Checking the copy against its checksums (once, for every account)');
    if (is_file($EXP . '/SHA256SUMS')) {
        if (!sh('cd ' . q($EXP) . ' && sha256sum --quiet -c SHA256SUMS', $o)) {
            ui_end_step(true);
            echo "\n  The export does not match its checksums (copied incompletely?): " . substr($o, 0, 300) . "\n\n";
            exit(1);
        }
    } else {
        warn('the export has no checksums (SHA256SUMS): not checked');
    }
    ui_info(implode(', ', $names));
    ui_end_step();
    $pass = array();
    foreach (array('php' => '--php', 'keep-ip' => '--keep-ip', 'overwrite' => '--overwrite', 'allow-symlinks' => '--allow-symlinks') as $k => $flag) {
        if ($k === 'php') { $pass[] = '--php ' . q($opt['php']); }
        elseif ($opt[$k]) { $pass[] = $flag; }
    }
    if ($opt['fix-htaccess'] !== null) { $pass[] = $opt['fix-htaccess'] ? '--fix-htaccess' : '--no-fix-htaccess'; }
    if ($APPLY) { $pass[] = '--yes'; }
    $start = time();
    $result = array();
    foreach ($names as $n => $u) {
        echo "\n" . c('bold') . c('cyan') . '  ==== ' . ($n + 1) . '/' . count($names) . ": $u " . str_repeat('=', 40) . c('reset') . "\n";
        $env = 'SENTORA_MIGRATE_CHILD=1 SENTORA_MIGRATE_NO_DAEMON=1 SENTORA_MIGRATE_CHECKED=' . q($EXP);
        // on this same terminal (passthru() gave it a pipe, so it showed plain lines instead of the
        // progress bar, and looked stuck during a long step)
        $proc = proc_open("$env php -q " . q(__FILE__) . ' ' . q($EXP) . ' ' . q($u) . ' ' . implode(' ', $pass), array(0 => STDIN, 1 => STDOUT, 2 => STDERR), $pipes);
        $rc = is_resource($proc) ? proc_close($proc) : 1;
        $result[$u] = $rc;
    }
    if ($APPLY) {
        echo "\n";
        $UI['total'] = 1; $UI['step'] = 0;
        ui_step('Running the Sentora daemon once (websites, PHP pools, DNS, FTP, cron, permissions)');
        sh('php -q ' . q($rootPath . 'bin/daemon.php') . ' > /var/sentora/logs/daemon-last-run.log', $o) || warn('the daemon run reported problems (see /var/sentora/logs/daemon-last-run.log)');
        ui_end_step();
    }
    echo "\n";
    $bad = count(array_filter($result, function ($rc) { return $rc !== 0 && $rc !== 3; }));
    $warned = count(array_filter($result, function ($rc) { return $rc === 3; }));
    ui_bar($bad ? 'bg_fail' : ($warned ? 'bg_warn' : ($APPLY ? 'bg_ok' : 'bg_title')),
        '  ' . ($APPLY ? 'Moved' : 'Dry run') . ': ' . count($result) . ' account(s), ' . ($bad ? "$bad stopped, " : '') . ($warned ? "$warned with warnings" : 'no warnings'));
    echo "\n";
    foreach ($result as $u => $rc) {
        printf("     %-20s %s\n", $u, $rc === 0 ? c('green') . 'OK' . c('reset') : ($rc === 3 ? c('yellow') . ($APPLY ? 'done, with warnings (above)' : 'OK, with warnings (above)') . c('reset') : c('red') . 'stopped (above): nothing of it changed after that point' . c('reset')));
    }
    if ($APPLY) {
        $pw = array();
        foreach (glob('/root/sentora-migrate-passwords-*.txt') ?: array() as $f) {
            if (filemtime($f) >= $start) {
                foreach (file($f, FILE_IGNORE_NEW_LINES) as $l) {
                    if ($l !== '' && $l[0] !== '#') { $pw[] = $l; }
                }
            }
        }
        if ($pw) {
            echo "\n  " . c('bold') . c('yellow') . 'New panel logins' . c('reset') . c('dim') . '  (accounts made here; give each client theirs; also in /root/sentora-migrate-passwords-*.txt)' . c('reset') . "\n";
            foreach ($pw as $l) { $p2 = explode("\t", $l, 2); printf("     %-20s %s\n", $p2[0], $p2[1] ?? ''); }
        }
        echo "\n  " . c('bold') . 'Next' . c('reset') . "\n     Point the domains' DNS to this server, then open each site.\n\n";
    } else {
        echo "\n  Nothing was changed. To move them all, run the same command with --yes\n\n";
    }
    exit($bad ? 1 : ($warned ? 3 : 0));
}
if (count($args) < 2) {
    ui_banner('The export of ' . $M['server'] . ', made ' . $M['made']);
    printf("  %-16s %s\n", 'Sentora', $M['sentora']);
    printf("  %-16s %s, IP %s\n", 'Panel there', $M['panel_domain'], $M['server_ip']);
    printf("  %-16s PHP %s, MySQL %s\n\n", 'Software', $M['php'], $M['mysql']);
    echo '  ' . c('bold') . 'Accounts' . c('reset') . "\n";
    foreach ($M['accounts'] as $a) {
        if (preg_match('/^(\S+) domains=(\d+): ?(.*)$/', $a, $m)) {
            printf("  %s%-16s%s %s domain(s)  %s%s%s\n", c('bold'), $m[1], c('reset'), $m[2], c('dim'), $m[3], c('reset'));
        } else {
            echo "  $a\n";
        }
    }
    echo "\n  What moving one would do (nothing changes):\n    " . c('bold') . "sentora-migrate-import $args[0] <account>" . c('reset') . "\n";
    echo "  What moving all of them would do:\n    " . c('bold') . "sentora-migrate-import $args[0] --all" . c('reset') . "\n\n";
    exit(0);
}
$OLDU = $args[1];
$NEWU = $args[2] ?? $args[1];
$APPLY = $opt['yes'];
foreach (array($OLDU, $NEWU) as $u) {
    if (!preg_match('/^[A-Za-z0-9_-]{1,64}$/', $u)) {
        fwrite(STDERR, "'$u' is not an account name.\n");
        exit(2);
    }
}

ui_banner(($APPLY ? 'Moving ' : 'What moving would do (nothing changes until --yes): ') . "$OLDU from " . $M['server'] . ' (Sentora ' . $M['sentora'] . ")"
    . ($NEWU !== $OLDU ? " into $NEWU" : ''));
$UI['total'] = $APPLY ? 14 : 4;
ui_logline('===== ' . ($APPLY ? 'moving ' : 'dry run ') . "$OLDU into $NEWU from $EXP");
// --- this server first: a missing account or PHP version stops at once, not after the checksums ------
ui_step('Checking this server');
global $zdbh;
$q = $zdbh->prepare("SELECT ac_id_pk FROM x_accounts WHERE ac_user_vc = :u AND ac_deleted_ts IS NULL");
$q->execute(array(':u' => $NEWU));
$NEWID = (int) $q->fetchColumn();
if (!$NEWID && $NEWU !== $OLDU) {
    stop("the account $NEWU does not exist on this server: make it first (Admin > Manage Clients), then run this again. (An account moved under its own name, $OLDU, is made here when it is missing.)");
}
if (!$NEWID) {
    ui_info("there is no account $NEWU on this server: it is found (if moved before) or made from the old one, see below");
}
$HOSTED = rtrim((string) ctrl_options::GetSystemOption('hosted_dir'), '/') . '/';
$NEWHOME = $HOSTED . $NEWU;
$OLDHOME = rtrim($M['hostdata'] ?: '/var/sentora/hostdata', '/') . '/' . $OLDU;
$NEWIP = (string) ctrl_options::GetSystemOption('server_ip');
$OLDIP = (string) ($M['server_ip'] ?? '');
$PANELDOMAIN = strtolower((string) ctrl_options::GetSystemOption('sentora_domain'));
$FTPDB = (string) ctrl_options::GetSystemOption('ftp_db') ?: 'sentora_proftpd';
// Old sites ran on PHP 5 or 7: they get PHP 7.1 (made for moving them) unless told otherwise
$PHPV = ($opt['php'] === 'default' || $opt['php'] === sys_phpversions::DefaultVersion()) ? '' : $opt['php'];
if ($PHPV !== '' && !is_dir('/opt/sentora-php/' . $PHPV)) {
    stop("PHP $PHPV is not installed here: add it with   sentora-php-install $PHPV   (or use --php default for this server's own PHP).");
}

// the checksums of the copy
ui_step('Checking the copy against its checksums');
if (getenv('SENTORA_MIGRATE_CHECKED') === $EXP) {
    ui_info('checked once for the whole export (--all)');
} elseif (is_file($EXP . '/SHA256SUMS')) {
    if (!sh('cd ' . q($EXP) . ' && sha256sum --quiet -c SHA256SUMS', $o)) {
        stop("the export does not match its checksums (copied incompletely?): " . substr($o, 0, 300));
    }
} else {
    warn('the export has no checksums (SHA256SUMS): not checked');
}

// MySQL as the panel's root user, from an option file
include 'cnf/db.php';
$MYCNF = tempnam('/root', '.migrate-my');
chmod($MYCNF, 0600);
file_put_contents($MYCNF, "[client]\nuser=$user\npassword=\"$pass\"\nhost=$host\n");
$STAMP = date('Ymd-His');
$TMPDB = 'sentora_migrate_' . preg_replace('/\D/', '', $STAMP);
$STAGE = '/var/sentora/migrate-stage/' . $STAMP;
function cleanup()
{
    global $MYCNF, $TMPDB, $zdbh, $STAGE;
    static $done = false;
    if ($done) {
        return;
    }
    $done = true;
    // (not when it stopped before the old panel's copy was named: DROP DATABASE `` is an SQL error)
    if (is_string($TMPDB) && $TMPDB !== '') {
        foreach (array('', '_mail', '_ftp', '_rc') as $sfx) {
            try { $zdbh->exec("DROP DATABASE IF EXISTS `" . $TMPDB . $sfx . "`"); } catch (Exception $e) { }
        }
    }
    foreach (array($STAGE, $STAGE . '-htaccess', $STAGE . '-sieve') as $d) {
        if ($STAGE && is_dir($d)) {
            sh('rm -rf ' . q($d));
        }
    }
    @unlink($MYCNF);
}
// also after an error: the old panel's copy and the unpacked files never stay behind
register_shutdown_function('cleanup');
function load_dump($file, $db)
{
    global $MYCNF, $zdbh;
    static $init = null;
    if ($init === null) {
        // Old dumps can hold zero dates and other values MySQL 8.4 refuses by default. MySQL 8.4
        // also refuses a foreign key to a column that is not uniquely indexed, which 5.7 took
        // (OrangeHRM has one): restrict_fk_on_non_standard_key=OFF loads them as before. Only where
        // the server knows the setting (MariaDB and older MySQL do not, and would refuse it).
        $init = "SET SESSION sql_mode='', foreign_key_checks=0";
        try {
            if ($zdbh->query("SHOW VARIABLES LIKE 'restrict_fk_on_non_standard_key'")->fetch()) {
                $init .= ', restrict_fk_on_non_standard_key=OFF';
            }
        } catch (Exception $e) { }
    }
    return sh('gunzip -c ' . q($file) . ' | mysql --defaults-extra-file=' . q($MYCNF) . ' --init-command=' . q($init) . ' ' . q($db), $o) ? true : $o;
}


// --- the old panel's databases, loaded beside this one to read from --------------------------------
$panelDump = $EXP . '/db/panel/' . ($M['panel_db'] ?: 'sentora_core') . '.sql.gz';
$mailDump = glob($EXP . '/db/panel/{sentora,zpanel}_postfix.sql.gz', GLOB_BRACE);
$ftpDump = glob($EXP . '/db/panel/{sentora,zpanel}_proftpd.sql.gz', GLOB_BRACE);
ui_step('Reading the old panel\'s databases');
$zdbh->exec("CREATE DATABASE `$TMPDB`");
ui_info('the panel\'s database (' . hsize(filesize($panelDump)) . ' packed)');
if (($r = load_dump($panelDump, $TMPDB)) !== true) {
    stop("the old panel's database did not load: " . substr((string) $r, 0, 300));
}
$HAVE_MAILDB = false;
if ($mailDump) {
    $zdbh->exec("CREATE DATABASE `{$TMPDB}_mail`");
    ui_info('its mail database');
    $HAVE_MAILDB = (load_dump($mailDump[0], $TMPDB . '_mail') === true);
}
$HAVE_RCDB = false;
if (is_file($EXP . '/db/panel/roundcube.sql.gz')) {
    $zdbh->exec("CREATE DATABASE `{$TMPDB}_rc`");
    ui_info('its webmail database (address books, identities, settings)');
    $HAVE_RCDB = (load_dump($EXP . '/db/panel/roundcube.sql.gz', $TMPDB . '_rc') === true);
    $HAVE_RCDB || warn('the old webmail database did not load: address books and identities are not moved');
}
$HAVE_FTPDB = false;
if ($ftpDump) {
    $zdbh->exec("CREATE DATABASE `{$TMPDB}_ftp`");
    ui_info('its FTP database');
    $HAVE_FTPDB = (load_dump($ftpDump[0], $TMPDB . '_ftp') === true);
}
$O = $TMPDB;
// (the current connection each time: MySQL may restart during the move, see the users step)
$old = function ($sql, $params = array()) {
    $s = $GLOBALS['zdbh']->prepare($sql);
    $s->execute($params);
    return $s->fetchAll(PDO::FETCH_ASSOC);
};
$cols = function ($db, $table) {
    $s = $GLOBALS['zdbh']->prepare("SELECT COLUMN_NAME FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = :d AND TABLE_NAME = :t");
    $s->execute(array(':d' => $db, ':t' => $table));
    return $s->fetchAll(PDO::FETCH_COLUMN);
};
$r = $old("SELECT ac_id_pk FROM `$O`.x_accounts WHERE ac_user_vc = :u AND ac_deleted_ts IS NULL", array(':u' => $OLDU));
if (!$r) {
    stop("the export has no account $OLDU (see: sentora-migrate-import " . $args[0] . ")");
}
$OLDID = (int) $r[0]['ac_id_pk'];

// --- accounts, packages and groups that are not here yet: matched by NAME, made from the old ones -----
// (the old panel's IDs mean nothing here: an account's owner (reseller), package and group are looked up by
// name on this server, and made from the old panel's when missing; the owner first, so a reseller's client
// lands under that reseller)
$MADE = array('accounts' => array(), 'packages' => array(), 'groups' => array(), 'warn' => array());
$CREATED_PW = array();   // user name => new panel password (shown at the end)
// x_migrate_map: what each old account, package, group and domain became here (one row per old server,
// kind and old ID), so where something came from can always be looked up, and a later run finds it again
// even after it was renamed here. Only read in a dry run (nothing changes until --yes).
$SRC = substr((string) ($M['server'] ?? ''), 0, 255);
$mapReady = function ($create) {
    static $ready = null;
    if ($ready === true) {
        return true;
    }
    if ($create) {
        $GLOBALS['zdbh']->exec("CREATE TABLE IF NOT EXISTS x_migrate_map (
            mm_id_pk INT NOT NULL AUTO_INCREMENT PRIMARY KEY, mm_server_vc VARCHAR(255) NOT NULL, mm_kind_vc VARCHAR(16) NOT NULL,
            mm_old_id_in INT NOT NULL, mm_old_name_vc VARCHAR(255) NOT NULL DEFAULT '', mm_new_id_in INT NOT NULL,
            mm_made_in TINYINT NOT NULL DEFAULT 0, mm_ts INT NOT NULL, UNIQUE KEY mm_old (mm_server_vc, mm_kind_vc, mm_old_id_in)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
        return $ready = true;
    }
    $ready = (int) $GLOBALS['zdbh']->query("SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'x_migrate_map'")->fetchColumn() > 0 ? true : null;
    return $ready === true;
};
// the new ID an old one became (0: none, or that row is gone/deleted here)
$mapGet = function ($kind, $oldId) use ($mapReady, &$SRC) {
    if (!$mapReady(false)) {
        return 0;
    }
    $q = $GLOBALS['zdbh']->prepare("SELECT mm_new_id_in FROM x_migrate_map WHERE mm_server_vc = :s AND mm_kind_vc = :k AND mm_old_id_in = :o");
    $q->execute(array(':s' => $SRC, ':k' => $kind, ':o' => (int) $oldId));
    $id = (int) $q->fetchColumn();
    if ($id <= 0) {
        return 0;
    }
    $alive = array('account' => "SELECT COUNT(*) FROM x_accounts WHERE ac_id_pk = :i AND ac_deleted_ts IS NULL",
        'package' => "SELECT COUNT(*) FROM x_packages WHERE pk_id_pk = :i AND pk_deleted_ts IS NULL",
        'group' => "SELECT COUNT(*) FROM x_groups WHERE ug_id_pk = :i",
        'domain' => "SELECT COUNT(*) FROM x_vhosts WHERE vh_id_pk = :i AND vh_deleted_ts IS NULL");
    $q = $GLOBALS['zdbh']->prepare($alive[$kind]);
    $q->execute(array(':i' => $id));
    return (int) $q->fetchColumn() > 0 ? $id : 0;
};
// record it (only when moving: --yes)
$mapPut = function ($kind, $oldId, $oldName, $newId, $made) use ($mapReady, &$SRC) {
    if ($newId <= 0 || !$mapReady(true)) {
        return;
    }
    $GLOBALS['zdbh']->prepare("INSERT INTO x_migrate_map (mm_server_vc, mm_kind_vc, mm_old_id_in, mm_old_name_vc, mm_new_id_in, mm_made_in, mm_ts)
        VALUES (:s, :k, :o, :n, :i, :m, :t) ON DUPLICATE KEY UPDATE mm_old_name_vc = VALUES(mm_old_name_vc), mm_new_id_in = VALUES(mm_new_id_in), mm_ts = VALUES(mm_ts)")
        ->execute(array(':s' => $SRC, ':k' => $kind, ':o' => (int) $oldId, ':n' => substr((string) $oldName, 0, 255), ':i' => (int) $newId, ':m' => $made ? 1 : 0, ':t' => time()));
};
$adminId = function () {
    static $id = null;
    if ($id === null) {
        $id = (int) $GLOBALS['zdbh']->query("SELECT ac_id_pk FROM x_accounts WHERE ac_group_fk = 1 AND ac_deleted_ts IS NULL ORDER BY ac_id_pk LIMIT 1")->fetchColumn();
    }
    return $id;
};
$newIdByName = function ($table, $idCol, $where, $params) {
    $q = $GLOBALS['zdbh']->prepare("SELECT $idCol FROM $table WHERE $where LIMIT 1");
    $q->execute($params);
    return (int) $q->fetchColumn();
};
// $mapAccount(old id, $apply): the account's id here (made when $apply; -1 = would be made)
$mapAccount = null;
$mapGroup = function ($oldGid, $ownerNew, $ownerIsAdmin, $apply) use ($old, $O, $newIdByName, &$MADE, $mapGet, $mapPut) {
    $g = $old("SELECT * FROM `$O`.x_groups WHERE ug_id_pk = :g", array(':g' => (int) $oldGid));
    if (!$g) {
        return 3;   // unknown: Users
    }
    $g = $g[0];
    $name = (string) $g['ug_name_vc'];
    if ($id = $mapGet('group', $oldGid)) {
        return $id;
    }
    if ((int) $g['ug_reseller_fk'] === 1 && in_array($name, array('Administrators', 'Resellers', 'Users'), true) || $name === 'Administrators') {
        $id = $newIdByName('x_groups', 'ug_id_pk', "ug_name_vc = :n AND ug_reseller_fk = 1", array(':n' => $name)) ?: 3;
        $apply && $mapPut('group', $oldGid, $name, $id, false);
        return $id;
    }
    if ($ownerNew > 0 && ($id = $newIdByName('x_groups', 'ug_id_pk', "ug_name_vc = :n AND ug_reseller_fk = :r", array(':n' => $name, ':r' => $ownerNew)))) {
        $apply && $mapPut('group', $oldGid, $name, $id, false);
        return $id;
    }
    // its modules, by folder name, that exist here (an administrator's modules only in an administrator's group)
    $mods = $old("SELECT m.mo_folder_vc FROM `$O`.x_permissions p JOIN `$O`.x_modules m ON m.mo_id_pk = p.pe_module_fk WHERE p.pe_group_fk = :g", array(':g' => (int) $oldGid));
    $folders = array_unique(array_column($mods, 'mo_folder_vc'));
    $key = $name . '|' . $ownerNew;
    if (!$apply) {
        $MADE['groups'][$key] = $name . ' (' . count($folders) . ' module(s) asked)';
        return -1;
    }
    $GLOBALS['zdbh']->prepare("INSERT INTO x_groups (ug_name_vc, ug_notes_tx, ug_reseller_fk) VALUES (:n, :d, :r)")
        ->execute(array(':n' => $name, ':d' => (string) ($g['ug_notes_tx'] ?? ''), ':r' => $ownerNew));
    $gid = (int) $GLOBALS['zdbh']->lastInsertId();
    $n = 0;
    foreach ($folders as $f) {
        $q = $GLOBALS['zdbh']->prepare("SELECT mo_id_pk FROM x_modules WHERE mo_folder_vc = :f AND mo_enabled_en = 'true'"
            . ($ownerIsAdmin ? '' : " AND mo_type_en = 'user' AND mo_category_fk <> 2"));
        $q->execute(array(':f' => $f));
        if ($mid = (int) $q->fetchColumn()) {
            ctrl_groups::AddGroupModulePermissions($gid, $mid);
            $n++;
        }
    }
    $MADE['groups'][$key] = "$name ($n module(s))";
    $mapPut('group', $oldGid, $name, $gid, true);
    return $gid;
};
$mapPackage = function ($oldPid, $apply) use ($old, $O, $newIdByName, &$MADE, &$mapAccount, $adminId, $mapGet, $mapPut) {
    $p = $old("SELECT * FROM `$O`.x_packages WHERE pk_id_pk = :p", array(':p' => (int) $oldPid));
    if (!$p) {
        return 0;
    }
    $p = $p[0];
    if ($id = $mapGet('package', $oldPid)) {
        return $id;
    }
    $owner = (int) $p['pk_reseller_fk'] > 0 ? $mapAccount((int) $p['pk_reseller_fk'], $apply) : $adminId();
    $name = (string) $p['pk_name_vc'];
    if ($owner > 0 && ($id = $newIdByName('x_packages', 'pk_id_pk', "pk_name_vc = :n AND pk_reseller_fk = :r AND pk_deleted_ts IS NULL", array(':n' => $name, ':r' => $owner)))) {
        $apply && $mapPut('package', $oldPid, $name, $id, false);
        return $id;
    }
    $qt = $old("SELECT * FROM `$O`.x_quotas WHERE qt_package_fk = :p", array(':p' => (int) $oldPid));
    if (!$apply) {
        $MADE['packages'][$name . '|' . $owner] = $name;
        return -1;
    }
    $GLOBALS['zdbh']->prepare("INSERT INTO x_packages (pk_name_vc, pk_reseller_fk, pk_enablephp_in, pk_created_ts) VALUES (:n, :r, 1, :t)")
        ->execute(array(':n' => $name, ':r' => $owner, ':t' => time()));
    $pid = (int) $GLOBALS['zdbh']->lastInsertId();
    $row = array('qt_package_fk' => $pid);
    if ($qt) {
        foreach (array('qt_domains_in', 'qt_subdomains_in', 'qt_parkeddomains_in', 'qt_mailboxes_in', 'qt_fowarders_in', 'qt_distlists_in', 'qt_ftpaccounts_in', 'qt_mysql_in', 'qt_diskspace_bi', 'qt_bandwidth_bi', 'qt_bwenabled_in', 'qt_dlenabled_in') as $c) {
            if (array_key_exists($c, $qt[0])) {
                $row[$c] = $qt[0][$c];
            }
        }
    }
    $GLOBALS['zdbh']->prepare("INSERT INTO x_quotas (" . implode(', ', array_keys($row)) . ") VALUES (:" . implode(', :', array_keys($row)) . ")")
        ->execute(array_combine(array_map(function ($k) { return ':' . $k; }, array_keys($row)), array_values($row)));
    $MADE['packages'][$name . '|' . $owner] = $name;
    $mapPut('package', $oldPid, $name, $pid, true);
    return $pid;
};
$mapAccount = function ($oldAid, $apply, $depth = 0) use ($old, $O, $newIdByName, &$MADE, &$CREATED_PW, &$mapAccount, $mapPackage, $mapGroup, $adminId, $mapGet, $mapPut) {
    $a = $old("SELECT a.*, p.ud_fullname_vc, p.ud_address_tx, p.ud_postcode_vc, p.ud_phone_vc, p.ud_language_vc FROM `$O`.x_accounts a
        LEFT JOIN `$O`.x_profiles p ON p.ud_user_fk = a.ac_id_pk WHERE a.ac_id_pk = :a", array(':a' => (int) $oldAid));
    if (!$a) {
        return $adminId();
    }
    $a = $a[0];
    $user = strtolower((string) $a['ac_user_vc']);
    if ($id = $mapGet('account', $oldAid)) {
        return $id;
    }
    if ($id = $newIdByName('x_accounts', 'ac_id_pk', "ac_user_vc = :u AND ac_deleted_ts IS NULL", array(':u' => $user))) {
        $apply && $mapPut('account', $oldAid, $user, $id, false);
        return $id;
    }
    if (isset($MADE['accounts'][$user])) {
        return $apply ? $MADE['accounts'][$user]['id'] : -1;
    }
    if ($depth > 10 || !preg_match('/^[a-z0-9_-]{1,64}$/', $user)) {
        return $adminId();
    }
    // its owner first (the old zadmin, or an account that owns itself: this server's administrator)
    $oldRes = (int) $a['ac_reseller_fk'];
    $owner = ($oldRes <= 0 || $oldRes === (int) $oldAid) ? $adminId() : $mapAccount($oldRes, $apply, $depth + 1);
    $ownerIsAdmin = $owner > 0 && (int) $GLOBALS['zdbh']->query("SELECT ac_group_fk FROM x_accounts WHERE ac_id_pk = " . (int) $owner)->fetchColumn() === 1;
    $pkg = $mapPackage((int) $a['ac_package_fk'], $apply);
    $grp = $mapGroup((int) $a['ac_group_fk'], $owner, $ownerIsAdmin, $apply);
    $gname = $old("SELECT ug_name_vc FROM `$O`.x_groups WHERE ug_id_pk = :g", array(':g' => (int) $a['ac_group_fk']));
    $gname = $gname ? (string) $gname[0]['ug_name_vc'] : 'Users';
    $pname = $old("SELECT pk_name_vc FROM `$O`.x_packages WHERE pk_id_pk = :p", array(':p' => (int) $a['ac_package_fk']));
    $pname = $pname ? (string) $pname[0]['pk_name_vc'] : '?';
    $rname = ($oldRes <= 0 || $oldRes === (int) $oldAid) ? 'the administrator' : (string) ($old("SELECT ac_user_vc FROM `$O`.x_accounts WHERE ac_id_pk = :a", array(':a' => $oldRes))[0]['ac_user_vc'] ?? '?');
    $email = trim((string) $a['ac_email_vc']);
    $emailNote = '';
    if ($email !== '' && $newIdByName('x_accounts', 'ac_id_pk', "LOWER(ac_email_vc) = :e AND ac_deleted_ts IS NULL", array(':e' => strtolower($email)))) {
        $emailNote = "its email $email is another account's here: left empty, set one in Manage Clients";
        $email = '';
    }
    $info = array('group' => $gname, 'package' => $pname, 'owner' => $rname, 'note' => $emailNote, 'admin' => $gname === 'Administrators', 'id' => -1);
    if (!$apply) {
        $MADE['accounts'][$user] = $info;
        return -1;
    }
    $pw = substr(strtr(base64_encode(random_bytes(18)), '+/=', 'xyz'), 0, 16);
    $crypto = new runtime_hash;
    $crypto->SetPassword($pw);
    $salt = $crypto->RandomSalt();
    $crypto->SetSalt($salt);
    $hash = $crypto->CryptParts($crypto->Crypt())->Hash;
    $theme = $GLOBALS['zdbh']->query("SELECT ac_usertheme_vc, ac_usercss_vc FROM x_accounts WHERE ac_id_pk = " . (int) $owner)->fetch(PDO::FETCH_ASSOC) ?: array('ac_usertheme_vc' => 'Modern', 'ac_usercss_vc' => 'default');
    $GLOBALS['zdbh']->prepare("INSERT INTO x_accounts (ac_user_vc, ac_pass_vc, ac_passsalt_vc, ac_email_vc, ac_package_fk, ac_group_fk, ac_usertheme_vc, ac_usercss_vc, ac_reseller_fk, ac_enabled_in, ac_created_ts)
        VALUES (:u, :p, :s, :e, :pk, :g, :t, :c, :r, :on, :ts)")->execute(array(':u' => $user, ':p' => $hash, ':s' => $salt, ':e' => $email, ':pk' => $pkg, ':g' => $grp,
        ':t' => $theme['ac_usertheme_vc'] ?: 'Modern', ':c' => $theme['ac_usercss_vc'] ?: 'default', ':r' => $owner, ':on' => (int) $a['ac_enabled_in'] === 1 ? 1 : 0, ':ts' => time()));
    $id = (int) $GLOBALS['zdbh']->lastInsertId();
    $GLOBALS['zdbh']->prepare("INSERT INTO x_profiles (ud_user_fk, ud_fullname_vc, ud_group_fk, ud_package_fk, ud_address_tx, ud_postcode_vc, ud_phone_vc, ud_language_vc, ud_created_ts)
        VALUES (:id, :n, :g, :pk, :a, :pc, :ph, :l, :ts)")->execute(array(':id' => $id, ':n' => (string) $a['ud_fullname_vc'], ':g' => $grp, ':pk' => $pkg,
        ':a' => (string) $a['ud_address_tx'], ':pc' => (string) $a['ud_postcode_vc'], ':ph' => (string) $a['ud_phone_vc'], ':l' => (string) ($a['ud_language_vc'] ?: 'en'), ':ts' => time()));
    $GLOBALS['zdbh']->prepare("INSERT INTO x_bandwidth (bd_acc_fk, bd_month_in, bd_transamount_bi, bd_diskamount_bi) VALUES (:a, :m, 0, 0)")->execute(array(':a' => $id, ':m' => date('Ym')));
    $info['id'] = $id;
    $MADE['accounts'][$user] = $info;
    $CREATED_PW[$user] = $pw;
    $mapPut('account', $oldAid, $user, $id, true);
    return $id;
};
if (!$NEWID && $NEWU === $OLDU && ($mapped = $mapGet('account', $OLDID))) {
    // moved before, and renamed here since: the same account (its folder is under its name here)
    $NEWID = $mapped;
    $NEWU = (string) $zdbh->query("SELECT ac_user_vc FROM x_accounts WHERE ac_id_pk = " . (int) $NEWID)->fetchColumn();
    $NEWHOME = $HOSTED . $NEWU;
    ui_info("$OLDU was moved here before and is now called $NEWU (x_migrate_map): moving into it");
}
if (!$NEWID) {
    $mapAccount($OLDID, false);   // dry: what would be made
}
$PATHFIX = function ($s) use ($OLDHOME, $NEWHOME) { return str_replace($OLDHOME . '/', $NEWHOME . '/', (string) $s); };

// --- what there is, and what is already taken here ------------------------------------------------
$taken = function ($sql, $params) { $s = $GLOBALS['zdbh']->prepare($sql); $s->execute($params); return (int) $s->fetchColumn() > 0; };
$plan = array('domains' => array(), 'skipdomains' => array(), 'dbs' => array(), 'skipdbs' => array(), 'users' => array(), 'skipusers' => array(),
    'ftp' => array(), 'skipftp' => array(), 'mail' => array(), 'skipmail' => array());
$VH = $old("SELECT * FROM `$O`.x_vhosts WHERE vh_acc_fk = :a AND vh_deleted_ts IS NULL ORDER BY vh_type_in, vh_name_vc", array(':a' => $OLDID));
foreach ($VH as $v) {
    $n = strtolower($v['vh_name_vc']);
    if ($n === $PANELDOMAIN || $taken("SELECT COUNT(*) FROM x_vhosts WHERE vh_name_vc = :n AND vh_deleted_ts IS NULL", array(':n' => $n))) {
        $plan['skipdomains'][] = $n;
    } else {
        $plan['domains'][] = $v;
    }
}
$DBS = $old("SELECT * FROM `$O`.x_mysql_databases WHERE my_acc_fk = :a AND my_deleted_ts IS NULL", array(':a' => $OLDID));
foreach ($DBS as $d) {
    $exists = $taken("SELECT COUNT(*) FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = :n", array(':n' => $d['my_name_vc']));
    if ($exists || !is_file($EXP . '/db/sites/' . $d['my_name_vc'] . '.sql.gz')) {
        $plan['skipdbs'][] = $d['my_name_vc'] . ($exists ? ' (already on this server)' : ' (not in the export)');
    } else {
        $plan['dbs'][] = $d;
    }
}
$MU = $old("SELECT * FROM `$O`.x_mysql_users WHERE mu_acc_fk = :a AND mu_deleted_ts IS NULL", array(':a' => $OLDID));
foreach ($MU as $u) {
    if ($taken("SELECT COUNT(*) FROM mysql.user WHERE User = :n", array(':n' => $u['mu_name_vc']))) {
        $plan['skipusers'][] = $u['mu_name_vc'] . ' (already on this server)';
    } else {
        $plan['users'][] = $u;
    }
}
