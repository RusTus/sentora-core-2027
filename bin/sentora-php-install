#!/bin/bash
#
# sentora-php-install: add an extra PHP version to a running Sentora server, set up exactly as the
# installer sets up its versions (php.ini, php-fpm.conf, an idle pool, the sentora-php<v>-fpm service).
# It is installed switched OFF: switch it on in the panel (Admin > Server Admin > PHP Versions).
# A version that is already installed is updated to the release's build instead (it asks first):
# its settings are kept, and its old files come back if it does not start with the new ones.
#
#   sentora-php-install 7.1                 PHP 7.1, only for moving old Sentora 2.0.2 websites
#   sentora-php-install 7.4                 PHP 7.4 or 8.1: steps for old apps upgraded on their way to PHP 8
#   sentora-php-install 8.3                 any other bundle the installers release has
#   sentora-php-install 7.1 <bundle file>   from a file instead of the GitHub release
#   sentora-php-install 7.1 --yes           update without asking
#
# The bundle (sentora-php-<version>-ubuntu26.04-amd64.tar.gz, on Debian 13 sentora-php-<version>-debian13-amd64.tar.gz) comes from the "current" release of
# RusTus/sentora-installers-2027 (TAG=<tag> in the environment for another) and is checked against the
# SHA-256 GitHub lists for it.
set -euo pipefail

MM=""
FILE=""
YES=0
for a in "$@"; do
    case "$a" in
        --yes|-y) YES=1 ;;
        *) if [ -z "$MM" ]; then MM="$a"; else FILE="$a"; fi ;;
    esac
done
REPO="RusTus/sentora-installers-2027"
TAG="${TAG:-current}"
PANEL=/etc/sentora/panel
DATA=/var/sentora
if [[ ! "$MM" =~ ^[78]\.[0-9]+$ ]]; then
    sed -n '2,/^set -euo/p' "$0" | grep '^#' | sed 's/^# \{0,1\}//'
    exit 2
fi
[ "$(id -u)" -eq 0 ] || { echo "Run this as root."; exit 1; }
P="/opt/sentora-php/$MM"
# Bundles are built for one system: Ubuntu 26.04 or Debian 13
OS_TAG=$(. /etc/os-release; [ "${ID:-}" = debian ] && echo "debian${VERSION_ID:-}" || echo "ubuntu${VERSION_ID:-26.04}")
NAME="sentora-php-$MM-$OS_TAG-amd64.tar.gz"
SERVICE="sentora-php$MM-fpm"
UPDATE=0
[ -d "$P/etc" ] && UPDATE=1
[ "$MM" = "$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')" ] && { echo "PHP $MM is this server's own PHP."; exit 1; }

WORK=$(mktemp -d /tmp/sentora-php-install.XXXXXX)
trap 'rm -rf "$WORK"' EXIT
if [ -z "$FILE" ]; then
    FILE="$WORK/$NAME"
    INFO=$(wget -q -T 20 -O - --header="Accept: application/vnd.github+json" "https://api.github.com/repos/$REPO/releases/tags/$TAG" 2> /dev/null | php -r '
        $d = json_decode(stream_get_contents(STDIN), true);
        if (!is_array($d) || empty($d["tag_name"])) { exit(1); }
        foreach ((array) ($d["assets"] ?? array()) as $a) {
            if (($a["name"] ?? "") === $argv[1] && !empty($a["digest"])) { echo preg_replace("/^sha256:/", "", $a["digest"]); exit(0); }
        }
        exit(1);
    ' "$NAME" 2> /dev/null) || INFO=""
    [ -n "$INFO" ] || { echo "Release $TAG of $REPO has no $NAME (or GitHub did not answer). Nothing changed."; exit 1; }
    echo "Downloading $NAME from release $TAG of $REPO"
    wget -q -O "$FILE" "https://github.com/$REPO/releases/download/$TAG/$NAME" || { echo "Could not download $NAME."; exit 1; }
    [ "$(sha256sum "$FILE" | cut -d' ' -f1)" = "$INFO" ] || { echo "$NAME does not match the SHA-256 GitHub lists for it. Nothing changed."; exit 1; }
    echo "SHA-256 matches the release."
fi
tar -tzf "$FILE" "opt/sentora-php/$MM/sbin/php-fpm" > /dev/null 2>&1 || { echo "$FILE is not a PHP $MM bundle. Nothing changed."; exit 1; }

# the libraries the bundles link against (all part of the system; newer bundles need more, such as LDAP's)
if [ "$OS_TAG" = debian13 ]; then
    apt-get -qq -y install libpng16-16t64 libjpeg62-turbo libfreetype6 libwebp7 libgmp10 zlib1g libldap2 libgnutls30t64 \
        libonig5 libzip5 libsodium23 libargon2-1 libsqlite3-0 libxml2 libcurl4t64 libicu76 libxslt1.1 libssl3t64 > /dev/null 2>&1 || true
else
    apt-get -qq -y install libpng16-16t64 libjpeg-turbo8 libfreetype6 libwebp7 libgmp10 zlib1g libldap2 libgnutls30t64 \
        libonig5 libzip5 libsodium23 libargon2-1 libsqlite3-0 libxml2-16 libcurl4t64 libicu78 libxslt1.1 libssl3t64 > /dev/null 2>&1 || true
fi

# --- already installed: replace its program files with the bundle's, keep its settings (etc/) --------
if [ "$UPDATE" = 1 ]; then
    OLD=$("$P/sbin/php-fpm" -v 2> /dev/null | head -1) || OLD="(does not run)"
    # unpack beside the live copy and check it runs with the current settings before touching anything
    tar -xzmf "$FILE" -C "$WORK"
    NEW="$WORK/opt/sentora-php/$MM"
    if cmp -s "$NEW/sbin/php-fpm" "$P/sbin/php-fpm" && cmp -s "$NEW/BUILD-INFO" "$P/BUILD-INFO" 2> /dev/null; then
        echo "PHP $MM is already this build ($OLD). Nothing changed."
        exit 0
    fi
    "$NEW/sbin/php-fpm" -v > /dev/null 2>&1 || { echo "The new PHP $MM does not run on this server:"; "$NEW/sbin/php-fpm" -v 2>&1 | head -3; echo "Nothing changed."; exit 1; }
    "$NEW/sbin/php-fpm" --test --fpm-config "$P/etc/php-fpm.conf" -c "$P/etc/php.ini" > /dev/null 2>&1 \
        || { echo "The new PHP $MM rejects this server's settings for it ($P/etc). Nothing changed."; exit 1; }
    echo "PHP $MM is installed:  $OLD"
    echo "The release's build:   $("$NEW/sbin/php-fpm" -v | head -1)"
    sed -n 's/^Compiled in: /  compiled in: /p' "$NEW/BUILD-INFO" 2> /dev/null || true
    if [ "$YES" != 1 ]; then
        if [ ! -t 0 ]; then echo "Run it again with --yes to update (nothing changed)."; exit 1; fi
        printf 'Update PHP %s now? Its settings are kept; the sites on it pause for a few seconds. (y/n) > ' "$MM"
        read -r ans
        case "$ans" in y|Y|yes|YES) ;; *) echo "Nothing changed."; exit 0 ;; esac
    fi
    # a version that is switched off (PHP 7.1 until a move needs it) stays stopped
    WAS_ON=1; systemctl is-enabled --quiet "$SERVICE" 2> /dev/null || WAS_ON=0
    systemctl stop "$SERVICE" 2> /dev/null || true
    for d in bin sbin lib include php; do
        [ -d "$NEW/$d" ] || continue
        rm -rf "${P:?}/${d:?}.old"; [ -d "$P/$d" ] && mv "$P/$d" "$P/$d.old"
        mv "$NEW/$d" "$P/$d"
    done
    cp "$P/BUILD-INFO" "$WORK/BUILD-INFO.old" 2> /dev/null || true
    cp "$NEW/BUILD-INFO" "$P/BUILD-INFO" 2> /dev/null || true
    # add-on extensions the bundle brings (PHP 7.1, 7.4, 8.1): only those that load are switched on
    if [ -x "$P/bin/sentora-php-addons" ]; then echo "Add-ons:"; "$P/bin/sentora-php-addons"; fi
    if [ "$WAS_ON" = 0 ] || systemctl start "$SERVICE"; then
        for d in bin sbin lib include php; do rm -rf "${P:?}/${d:?}.old"; done
        echo "Updated: $OLD  ->  $("$P/sbin/php-fpm" -v | head -1)"
        [ "$WAS_ON" = 0 ] && echo "(It is switched off, as before: PHP Versions switches it on.)"
        exit 0
    fi
    echo "PHP $MM did not start with the new files: the old ones are back."
    for d in bin sbin lib include php; do
        [ -d "$P/$d.old" ] && { rm -rf "${P:?}/${d:?}"; mv "$P/$d.old" "$P/$d"; }
    done
    cp "$WORK/BUILD-INFO.old" "$P/BUILD-INFO" 2> /dev/null || true
    # (add-ons the old files do not have are switched off again)
    for f in "$P"/etc/conf.d/30-*.ini; do
        [ -f "$f" ] || continue
        so=$(sed -n 's/^extension=//p' "$f"); [ -f "$("$P/bin/php-config" --extension-dir)/$so" ] || rm -f "$f"
    done
    systemctl start "$SERVICE" || true
    exit 1
fi

tar -xzmf "$FILE" -C /
if ! "$P/sbin/php-fpm" -v > /dev/null 2>&1; then
    echo "PHP $MM does not run on this server:"; "$P/sbin/php-fpm" -v 2>&1 | head -3
    rm -rf "${P:?}"; exit 1
fi

# php.ini: PHP's production defaults with the installer's changes
TZ_NAME=$(timedatectl show -p Timezone --value 2> /dev/null || cat /etc/timezone 2> /dev/null || echo UTC)
mkdir -p "$P/etc/conf.d" "$P/etc/php-fpm.d"
cp "$P/lib/php.ini-production" "$P/etc/php.ini"
sed -i "s|^memory_limit = .*|memory_limit = 256M|" "$P/etc/php.ini"
sed -i "s|^expose_php = .*|expose_php = Off|" "$P/etc/php.ini"
sed -i "s|^;date.timezone =.*|date.timezone = $TZ_NAME|" "$P/etc/php.ini"
sed -i "s|^;upload_tmp_dir =.*|upload_tmp_dir = $DATA/temp/|" "$P/etc/php.ini"
sed -i "s|^mysqli.default_socket =.*|mysqli.default_socket = /var/run/mysqld/mysqld.sock|" "$P/etc/php.ini"
sed -i "s|^pdo_mysql.default_socket *=.*|pdo_mysql.default_socket = /var/run/mysqld/mysqld.sock|" "$P/etc/php.ini"
# (from PHP 8.5 opcache is part of PHP itself, with no opcache.so to load)
if [ -f "$("$P/bin/php-config" --extension-dir)/opcache.so" ]; then echo "zend_extension=opcache.so" > "$P/etc/conf.d/10-opcache.ini"; else rm -f "$P/etc/conf.d/10-opcache.ini"; fi
if [ -x "$P/bin/sentora-php-addons" ]; then echo "Add-ons:"; "$P/bin/sentora-php-addons"; fi
cat > "$P/etc/php-fpm.conf" <<EOF_FPM
[global]
pid = /run/sentora-php/php$MM-fpm.pid
error_log = $DATA/logs/php$MM-fpm.log
include = $P/etc/php-fpm.d/*.conf
EOF_FPM
# PHP-FPM needs one pool to start: an idle one nobody can connect to (accounts get their own)
cat > "$P/etc/php-fpm.d/00-idle.conf" <<EOF_POOL
[sentora-idle]
user = nobody
group = nogroup
listen = /run/sentora-php/php$MM-idle.sock
listen.owner = root
listen.group = root
listen.mode = 0600
pm = ondemand
pm.max_children = 1
EOF_POOL
cat > "/etc/systemd/system/$SERVICE.service" <<EOF_UNIT
[Unit]
Description=PHP $MM FastCGI Process Manager for Sentora hosted domains
After=network.target

[Service]
Type=simple
RuntimeDirectory=sentora-php
RuntimeDirectoryPreserve=yes
ExecStartPre=$P/sbin/php-fpm --test --fpm-config $P/etc/php-fpm.conf
ExecStart=$P/sbin/php-fpm --nodaemonize --fpm-config $P/etc/php-fpm.conf
ExecReload=/bin/kill -USR2 \$MAINPID
Restart=on-failure
PrivateTmp=true
UMask=0002

[Install]
WantedBy=multi-user.target
EOF_UNIT
touch "$DATA/logs/php$MM-fpm.log"
systemctl daemon-reload
"$P/sbin/php-fpm" --test --fpm-config "$P/etc/php-fpm.conf" > /dev/null 2>&1 \
    || { echo "WARNING: PHP $MM's PHP-FPM rejects its settings:"; "$P/sbin/php-fpm" --test --fpm-config "$P/etc/php-fpm.conf" 2>&1 | tail -3; }

echo "Installed: $("$P/sbin/php-fpm" -v | head -1)"
echo "It is switched off. Switch it on in the panel: Admin > Server Admin > PHP Versions (the daemon starts it within 5 minutes)."
[ "$MM" = "7.1" ] && echo "PHP 7.1 gets no security fixes: use it only to move old sites, and move them to PHP 8 as soon as they run."
case "$MM" in 7.4|8.1) echo "PHP $MM gets no security fixes: use it as a step while a site's app is upgraded, then move the site on." ;; esac
exit 0
