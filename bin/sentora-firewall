#!/bin/bash
# sentora-firewall: the server's firewall, open only for what Sentora serves (run as root).
#
#   sentora-firewall status            what is open, and Sentora's ports that are not
#   sentora-firewall on [--yes]        switch it on: Sentora's ports open, every other port closed
#   sentora-firewall off [--yes]       switch it off (fail2ban's bans stay)
#   sentora-firewall allow <port>[/tcp|/udp]    open another port (e.g. a range: 8000-8010/tcp)
#   sentora-firewall deny <port>[/tcp|/udp]     close a port opened with allow
#
# Sentora's ports: SSH (every port sshd listens on, and the port of the session running this,
# so it never locks you out), web (80, 443, and the panel's own ports when they were moved:
# settings apache_port and sentora_port), mail (25, 465, 587, 110, 995, 143, 993, 4190), DNS
# (53 TCP and UDP), FTP (21 and its passive ports from ProFTPD's PassivePorts). Ports that only
# this server uses (MySQL, memcached, BIND's control port, SOGo) are never opened.
# Which firewall: the settings firewall_kind (ufw or firewalld), firewall_cmd, firewall_service
# and firewall_package, set by each system's installer (setso --get firewall_kind).
# In a container the host's firewall decides: on refuses there (--container to do it anyway).
set -uo pipefail
PANEL=${SENTORA_PANEL:-/etc/sentora/panel}
sp() { php -q "$PANEL/bin/setso" --get "$1" 2> /dev/null; }
die() { echo "sentora-firewall: $*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "run it as root"

KIND=$(sp firewall_kind); CMD=$(sp firewall_cmd); SVC=$(sp firewall_service); PKG=$(sp firewall_package)
case "$KIND" in ufw|firewalld) ;; *) die "no firewall is set for this system (setting firewall_kind: ufw or firewalld)" ;; esac
ACTION=${1:-status}; shift || true
YES=0; CONTAINER_OK=0; ARG=""
for a in "$@"; do
    case "$a" in --yes|-y) YES=1 ;; --container) CONTAINER_OK=1 ;; *) ARG=$a ;; esac
done

# the firewall's program, installed when it is missing (the system's package)
need_cmd() {
    if [ -z "$CMD" ] || [ ! -x "$CMD" ]; then
        [ -n "$PKG" ] || die "the firewall's program ($CMD) is not installed"
        echo "Installing $PKG..."
        # shellcheck disable=SC2086
        DEBIAN_FRONTEND=noninteractive $(sp package_install) $PKG > /dev/null 2>&1 || die "could not install $PKG"
        [ -x "$CMD" ] || die "$PKG is installed but $CMD is not there (setting firewall_cmd)"
    fi
}

# Sentora's ports, one per line as port/proto (a range as from-to/proto)
sentora_ports() {
    local p
    {
        # SSH: every port sshd listens on, and the one this session came in on
        if command -v sshd > /dev/null 2>&1; then sshd -T 2> /dev/null | awk '$1 == "port" {print $2 "/tcp"}'; fi
        if [ -n "${SSH_CONNECTION:-}" ]; then echo "$(echo "$SSH_CONNECTION" | awk '{print $4}')/tcp"; fi
        echo 22/tcp
        for p in 80 443 25 465 587 110 995 143 993 4190 21 53; do echo "$p/tcp"; done
        # the panel's own ports, when they were moved (settings apache_port and sentora_port; a
        # client's own site port is the client's business, not the firewall's)
        for p in "$(sp apache_port)" "$(sp sentora_port)"; do [[ "$p" =~ ^[0-9]{1,5}$ ]] && echo "$p/tcp"; done
        echo 53/udp
        # FTP's passive data ports
        local ftpconf; ftpconf=$(sp ftp_config_file)
        if [ -n "$ftpconf" ] && [ -r "$ftpconf" ]; then
            awk 'tolower($1) == "passiveports" && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {print $2 "-" $3 "/tcp"}' "$ftpconf" | head -1
        fi
    } | grep -E '^[0-9]+(-[0-9]+)?/(tcp|udp)$' | awk '!seen[$0]++'
}

valid_port() { # port[/proto] -> port/proto, or nothing
    local p=${1%/*} proto=tcp
    [[ "$1" == */* ]] && proto=${1##*/}
    [[ "$p" =~ ^[0-9]{1,5}(-[0-9]{1,5})?$ ]] && [[ "$proto" =~ ^(tcp|udp)$ ]] || return 1
    local a=${p%-*} b=${p#*-}
    [ "$a" -ge 1 ] && [ "$a" -le 65535 ] && [ "$b" -ge 1 ] && [ "$b" -le 65535 ] && [ "$a" -le "$b" ] || return 1
    echo "$p/$proto"
}

is_on() {
    case "$KIND" in
        ufw) [ -x "$CMD" ] && "$CMD" status 2> /dev/null | grep -q '^Status: active' ;;
        firewalld) [ -x "$CMD" ] && "$CMD" --state 2> /dev/null | grep -qx running ;;
    esac
}

fw_allow() { # port/proto
    local p=${1%/*} proto=${1##*/}
    case "$KIND" in
        ufw) "$CMD" allow "${p/-/:}/$proto" comment 'Sentora' > /dev/null ;;
        firewalld) "$CMD" --permanent --zone="$ZONE" --add-port="$p/$proto" > /dev/null ;;
    esac
}
fw_deny() {
    local p=${1%/*} proto=${1##*/}
    case "$KIND" in
        ufw) "$CMD" delete allow "${p/-/:}/$proto" > /dev/null 2>&1 ;;
        firewalld) "$CMD" --permanent --zone="$ZONE" --remove-port="$p/$proto" > /dev/null 2>&1 ;;
    esac
}

# the ports open to the world now, that are not Sentora's (they are closed by "on")
others_listening() {
    command -v ss > /dev/null 2>&1 || return 0
    local want; want=" $(sentora_ports | tr '\n' ' ') "
    ss -Hltnu 2> /dev/null | awk '{print tolower($1), $5}' | grep -vE ' (127\.|\[::1\]|::1)' \
        | sed -E 's/^(tcp|udp) .*:([0-9]+)$/\2\/\1/' | grep -E '^[0-9]+/(tcp|udp)$' | sort -u | while read -r pp; do
            local n=${pp%/*} pr=${pp##*/} hit=0
            for w in $want; do
                local wp=${w%/*} wpr=${w##*/}
                [ "$wpr" = "$pr" ] || continue
                if [[ "$wp" == *-* ]]; then [ "$n" -ge "${wp%-*}" ] && [ "$n" -le "${wp#*-}" ] && hit=1
                elif [ "$wp" = "$n" ]; then hit=1; fi
            done
            # (DHCP's client and the like answer only what they asked for)
            [ $hit -eq 1 ] || [ "$pp" = 68/udp ] || [ "$pp" = 546/udp ] || echo "$pp"
        done
}

in_container() { command -v systemd-detect-virt > /dev/null 2>&1 && systemd-detect-virt --quiet --container; }

ask() { [ $YES -eq 1 ] && return 0; printf '%s (y/n) > ' "$1"; read -r r; [ "$r" = y ] || [ "$r" = Y ]; }

case "$ACTION" in
status)
    if is_on; then echo "The firewall ($KIND) is on."; else echo "The firewall ($KIND) is off."; fi
    [ -x "$CMD" ] || exit 0
    case "$KIND" in
        ufw) "$CMD" status numbered 2> /dev/null | sed 's/^/  /' ;;
        firewalld) is_on && { Z=$("$CMD" --get-default-zone); echo "  zone $Z: services: $("$CMD" --zone="$Z" --list-services) | ports: $("$CMD" --zone="$Z" --list-ports)"; } ;;
    esac
    ;;
on)
    if in_container && [ $CONTAINER_OK -eq 0 ]; then
        die "this is a container: the host's firewall decides what reaches it (--container to switch one on here anyway)"
    fi
    need_cmd
    PORTS=$(sentora_ports)
    echo "Sentora's ports stay open: $(echo "$PORTS" | tr '\n' ' ')"
    OTHERS=$(others_listening | tr '\n' ' ')
    [ -n "$OTHERS" ] && echo "These listen to the world now and will be CLOSED: $OTHERS(keep one open: sentora-firewall allow <port>)"
    ask "Switch the firewall on?" || { echo "Nothing changed."; exit 0; }
    case "$KIND" in
        ufw)
            "$CMD" default deny incoming > /dev/null && "$CMD" default allow outgoing > /dev/null || die "ufw did not take its defaults"
            for p in $PORTS; do fw_allow "$p" || die "ufw did not open $p: nothing switched on"; done
            "$CMD" --force enable > /dev/null || die "ufw did not switch on"
            systemctl enable "${SVC:-ufw}" > /dev/null 2>&1
            ;;
        firewalld)
            systemctl enable --now "${SVC:-firewalld}" > /dev/null 2>&1 || die "firewalld did not start"
            ZONE=$("$CMD" --get-default-zone) || die "firewalld has no default zone"
            for p in $PORTS; do fw_allow "$p" || die "firewalld did not open $p"; done
            "$CMD" --reload > /dev/null || die "firewalld did not reload"
            ;;
    esac
    is_on || die "the firewall is not on"
    echo "The firewall is on: only Sentora's ports are open."
    ;;
off)
    is_on || { echo "The firewall is already off."; exit 0; }
    ask "Switch the firewall off (every listening port open to the world)?" || { echo "Nothing changed."; exit 0; }
    case "$KIND" in
        ufw) "$CMD" disable > /dev/null ;;
        firewalld) systemctl disable --now "${SVC:-firewalld}" > /dev/null 2>&1 ;;
    esac
    echo "The firewall is off."
    ;;
allow|deny)
    PP=$(valid_port "$ARG") || die "give a port, a range or port/udp: e.g. 8080, 8000-8010/tcp, 1194/udp"
    is_on || die "the firewall is off (sentora-firewall on)"
    [ "$KIND" = firewalld ] && ZONE=$("$CMD" --get-default-zone)
    if [ "$ACTION" = allow ]; then fw_allow "$PP" || die "could not open $PP"
    else
        # (Sentora's own ports, web and the panel's included, can not be closed: the panel must stay reachable)
        sentora_ports | grep -qx "$PP" && die "$PP is one of Sentora's own ports: it stays open"
        fw_deny "$PP" || die "could not close $PP"
    fi
    [ "$KIND" = firewalld ] && "$CMD" --reload > /dev/null
    echo "$PP: $( [ "$ACTION" = allow ] && echo open || echo closed )."
    ;;
*)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
