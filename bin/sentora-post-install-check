#!/bin/bash
# sentora-post-install-check: after installing (or updating) Sentora, check the
# things that are easy to miss by eye. Read-only: it changes nothing.
#
# Run as root:   sentora-post-install-check
# Exit code 0 when nothing FAILed. The report is also saved in
# /var/sentora/logs/post-install-check.log (System Log Viewer).

PANEL=${SENTORA_PANEL:-/etc/sentora/panel}
# this Linux system's commands, paths, services and users (Sentora's settings: setso --get <name>)
sp() { php -q "$PANEL/bin/setso" --get "$1" 2> /dev/null; }
CONF=/etc/sentora/configs
LOG=${SENTORA_CHECK_LOG:-/var/sentora/logs/post-install-check.log}

# --json <file>: also write the report for the panel (Server Monitor's Hardening card): every line
# with its section, and the hardening score (OK 1 point, WARN half, FAIL none, out of 100)
JSON=""
if [ "${1:-}" = "--json" ] && [ -n "${2:-}" ]; then JSON=$2; fi
REC=$(mktemp); chmod 600 "$REC"; trap 'rm -f "$REC"' EXIT
CUR="General"
OKS=0; WARNS=0; FAILS=0
rec() { printf '%s\t%s\t%s\n' "$1" "$CUR" "$2" | tr -d '\r' >> "$REC"; }
ok()   { echo "  OK    $*"; OKS=$((OKS + 1)); rec ok "$*"; }
warn() { echo "  WARN  $*"; WARNS=$((WARNS + 1)); rec warn "$*"; }
fail() { echo "  FAIL  $*"; FAILS=$((FAILS + 1)); rec fail "$*"; }
section() { echo; echo "== $*"; CUR=$*; }

main() {
echo "Sentora post-install check, $(date '+%Y-%m-%d %H:%M %Z') on $(hostname -f 2> /dev/null || hostname)"
[ "$(id -u)" -eq 0 ] || { echo "Run this as root."; return 2; }

PHPVER=$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2> /dev/null)
SYSTEMD=0
[ "$(ps -o comm= -p 1 2> /dev/null)" = "systemd" ] && SYSTEMD=1

# --- database access (the panel's own login) ----------------------------------
DBPHP=$PANEL/cnf/db.php
val() { grep -o "\$$1 = '[^']*'" "$DBPHP" 2> /dev/null | head -1 | cut -d"'" -f2; }
DBHOST=$(val host); DBUSER=$(val user); DBPASS=$(val pass)
MYCNF=$(mktemp); chmod 600 "$MYCNF"
{
    echo "[client]"; echo "user=$DBUSER"; echo "password=$DBPASS"
    case "$DBHOST" in
        *:*) echo "host=${DBHOST%%:*}"; echo "port=${DBHOST##*:}" ;;
        localhost|"") ;;
        *) echo "host=$DBHOST" ;;
    esac
} > "$MYCNF"
q() { mysql --defaults-extra-file="$MYCNF" -N -B -e "$1" 2> /dev/null; }
DB=0
[ "$(q 'SELECT 1')" = "1" ] && DB=1

# --- 1. services ------------------------------------------------------------------
section "Services (running and started at boot)"
svc() { # label  systemd-unit  process-name
    local running=0 enabled=1
    if [ $SYSTEMD -eq 1 ]; then
        systemctl is-active --quiet "$2" && running=1
        systemctl is-enabled --quiet "$2" 2> /dev/null || enabled=0
    else
        pgrep -x "$3" > /dev/null && running=1
    fi
    if [ $running -eq 1 ] && [ $enabled -eq 1 ]; then ok "$1"
    elif [ $running -eq 1 ]; then warn "$1 runs but is not started at boot (systemctl enable $2)"
    else fail "$1 is not running (systemctl status $2)"; fi
}
APACHE_SN=$(sp apache_sn); APACHE_SN=${APACHE_SN:-apache2}
PHP_FPM_DIR=$(sp php_fpm_pool_dir); PHP_FPM_DIR=${PHP_FPM_DIR//\{v\}/$PHPVER}
PHP_SOCK_DIR=$(sp php_fpm_socket_dir); PHP_SOCK_DIR=${PHP_SOCK_DIR%/}
PKG=$(sp package_install)
svc "Apache" "$APACHE_SN" "$APACHE_SN"
svc "PHP $PHPVER (panel and accounts)" "$(sp php_fpm_service | sed "s/{v}/$PHPVER/g")" "$(sp php_fpm_process | sed "s/{v}/$PHPVER/g")"
svc "MySQL" "$(sp db_service)" mysqld
svc "Postfix" postfix master
svc "Dovecot" "$(sp dovecot_service)" dovecot
svc "ProFTPD" proftpd proftpd
BIND_SN=$(sp bind_service); svc "BIND" "${BIND_SN:-named}" named
svc "fail2ban" fail2ban fail2ban-server
CRON_SN=$(sp cron_service); svc "cron (the Sentora daemon)" "$CRON_SN" "$CRON_SN"
svc "Server Monitor process list (sentora-procstat)" sentora-procstat php
if [ -x "$(sp sogo_bin)" ]; then svc "SOGo" "$(sp sogo_service)" sogod; svc "memcached (SOGo)" memcached memcached; fi
# the backup, restore and update tools copy files with rsync
command -v rsync > /dev/null 2>&1 && ok "rsync (backups, restore, updates)" || fail "rsync is not installed ($PKG rsync): restore, updates and off-server backup need it"
if [ -x "$(sp spamd_bin)" ] || [ -x "$(sp clamd_bin)" ]; then
    # SpamAV: only what is switched on in Admin > SpamAV Admin
    SA_ON=$(q "SELECT so_value_tx FROM sentora_core.x_settings WHERE so_name_vc = 'sa_enabled'")
    CL_ON=$(q "SELECT so_value_tx FROM sentora_core.x_settings WHERE so_name_vc = 'clam_enabled'")
    if [ -x "$(sp spamd_bin)" ] && [ "$SA_ON" != "false" ]; then svc "SpamAssassin" "$(sp spamd_service)" spamd; svc "SpamAssassin mail connection (spamass-milter)" "$(sp spamass_milter_service)" spamass-milter; fi
    if [ -x "$(sp clamd_bin)" ] && [ "$CL_ON" = "true" ]; then
        if CLDB=$(sp clamav_db_dir); ls "${CLDB:-/var/lib/clamav}"/daily.c?d "${CLDB:-/var/lib/clamav}"/main.c?d > /dev/null 2>&1; then
            svc "ClamAV" "$(sp clamd_service)" clamd; svc "ClamAV mail connection (clamav-milter)" "$(sp clamav_milter_service)" clamav-milter
        else
            warn "ClamAV is waiting for its first virus signatures (systemctl status $(sp freshclam_service))"
        fi
    fi
    MILTERS=$(postconf -h smtpd_milters 2> /dev/null)
    SCANS=""
    echo "$MILTERS" | grep -q spamass && SCANS="SpamAssassin"
    echo "$MILTERS" | grep -q clamav && SCANS="${SCANS:+$SCANS and }ClamAV"
    if [ -n "$MILTERS" ]; then ok "Postfix scans incoming mail with $SCANS"
    elif [ "$SA_ON" != "false" ] || [ "$CL_ON" = "true" ]; then warn "Postfix does not scan mail yet (the daemon sets it within 5 minutes)"; fi
fi
for d in /opt/sentora-php/*/; do
    [ -d "$d" ] || continue
    v=$(basename "$d")
    if [ -S "/run/sentora-php/php$v-idle.sock" ]; then ok "extra PHP $v"; else warn "extra PHP $v is installed but not running (enable it in PHP Versions if a domain needs it)"; fi
done

# --- 2. fail2ban -----------------------------------------------------------------
section "fail2ban jails"
if command -v fail2ban-client > /dev/null && fail2ban-client ping > /dev/null 2>&1; then
    jails=$(fail2ban-client status 2> /dev/null | sed -n 's/.*Jail list:[[:space:]]*//p' | tr -d ' ' | tr ',' ' ')
    want="sshd postfix-sasl sentora-dovecot roundcube-auth sentora-proftpd sentora-panel sentora-phpmyadmin"
    [ -f /var/log/sogo/sogo.log ] && want="$want sogo-auth"
    for j in $want; do
        if echo " $jails " | grep -q " $j "; then ok "jail $j"; else fail "jail $j is not active (fail2ban-client -t, then systemctl restart fail2ban)"; fi
    done
else
    fail "fail2ban is not answering"
fi

# --- 3. network -----------------------------------------------------------------
# The panel's IP (Sentora Config, server_ip): the websites' and the panel's Apache settings are written for
# it. After the server's own address changes it must be changed too, or the panel and the sites stop
# answering on the new one ("Not Found"). A public address the server is reached on through a router (NAT)
# is not one of its own, and is fine.
section "The panel's address"
if [ $DB -eq 1 ]; then
    SIP=$(q "SELECT so_value_tx FROM sentora_core.x_settings WHERE so_name_vc = 'server_ip'")
    OWN=$(ip -o -4 addr show 2> /dev/null | awk '{print $4}' | cut -d/ -f1 | grep -v '^127\.' | tr '\n' ' ' | sed 's/ $//')
    is_private() { echo "$1" | grep -qE '^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|169\.254\.)'; }
    if [ -z "$SIP" ]; then
        fail "the panel has no IP address set: setso --set server_ip <this server's address>"
    elif echo " $OWN " | grep -q " $SIP "; then
        ok "the panel's IP ($SIP) is this server's"
    elif is_private "$SIP"; then
        NEWIP=$(echo $OWN | awk '{print $1}')
        fail "the panel's IP is $SIP, which this server no longer has (it has: ${OWN:-none}): the panel and the websites do not answer on the new address. Fix: setso --set server_ip ${NEWIP:-<new address>} && setso --set apache_changed true && php /etc/sentora/panel/bin/daemon.php > /dev/null"
    else
        ok "the panel's IP ($SIP) is a public address this server is reached on through a router (its own: ${OWN:-none})"
    fi
fi

section "Listening ports"
if command -v ss > /dev/null; then
    LIST=$(ss -Hltn 2> /dev/null | awk '{print $4}')
    local_only() { # label port
        local addrs; addrs=$(echo "$LIST" | grep -E "[:.]$2\$" | sed -E "s/:$2\$//")
        if [ -z "$addrs" ]; then ok "$1 (port $2): not listening"; return; fi
        if echo "$addrs" | grep -qvE '^(127\.0\.0\.1|\[::1\]|::1)$'; then fail "$1 (port $2) listens beyond this server: $(echo "$addrs" | tr '\n' ' ')"
        else ok "$1 (port $2): this server only"; fi
    }
    local_only "MySQL" 3306
    local_only "MySQL X protocol" 33060
    local_only "memcached" 11211
    local_only "SOGo" 20000
    allowed=" 21 22 25 53 80 110 143 443 465 587 953 993 995 4190 "
    others=$(echo "$LIST" | grep -vE '^(127\.|\[::1\]|::1)' | sed -E 's/.*:([0-9]+)$/\1/' | sort -un | while read -r p; do echo "$allowed" | grep -q " $p " || echo "$p"; done | tr '\n' ' ')
    if [ -z "$others" ]; then ok "no unexpected public ports"; else warn "other public ports open: $others(check they are meant to be)"; fi
else
    warn "ss not found, ports not checked"
fi

section "ModSecurity (switched on by the Web Hardening add-on)"
MS_MOD=$(sp modsec_module); MS_CONF=$(sp modsec_conf_dir)
MS_INC="$(dirname "$(sp apache_vhost)")/httpd.conf"
CRS_V=$PANEL/etc/modsecurity/coreruleset/VERSION
if [ -f "$MS_MOD" ]; then ok "ModSecurity installed ($MS_MOD)"
else warn "ModSecurity not installed ($MS_MOD missing; sentora-update installs it)"; fi
if [ -f "$CRS_V" ] && [ -f "$PANEL/etc/modsecurity/coreruleset/rules/REQUEST-901-INITIALIZATION.conf" ]; then ok "its rules: $(head -1 "$CRS_V" | cut -d' ' -f1-3)"
else fail "the OWASP rules are missing from $PANEL/etc/modsecurity/coreruleset (sentora-update puts them back)"; fi
if grep -qF "IncludeOptional $MS_CONF/*.conf" "$MS_INC" 2> /dev/null; then ok "Apache includes $MS_CONF"
else warn "Sentora's httpd.conf does not include $MS_CONF (sentora-update adds it)"; fi
MS_LOADED=$($(sp apache_modules_cmd) 2> /dev/null | grep -c security2_module)
if ls "$MS_CONF"/*.conf > /dev/null 2>&1; then
    if [ "${MS_LOADED:-0}" -gt 0 ]; then ok "ModSecurity switched on (Web Hardening)"
    else fail "Web Hardening's ModSecurity settings are in $MS_CONF but Apache has not loaded them (reload Apache; the add-on's page says why)"; fi
elif [ "${MS_LOADED:-0}" -gt 0 ]; then warn "ModSecurity is loaded by the system's own settings, not Sentora's (switch that off: $(sp modsec_off_cmd); then reload Apache)"
else ok "ModSecurity switched off until the Web Hardening add-on switches it on"; fi

section "SELinux / AppArmor (the system's limits on what each program may touch)"
if [ -r /sys/fs/selinux/enforce ]; then
    if [ "$(cat /sys/fs/selinux/enforce)" = "1" ]; then ok "SELinux is on (enforcing)"
    else warn "SELinux only watches (permissive), it blocks nothing: setenforce 1, and SELINUX=enforcing in /etc/selinux/config"; fi
elif [ "$(cat /sys/module/apparmor/parameters/enabled 2> /dev/null)" = "Y" ]; then
    AA_ENF=$(grep -c '(enforce)' /sys/kernel/security/apparmor/profiles 2> /dev/null)
    if [ "${AA_ENF:-0}" -eq 0 ]; then
        warn "AppArmor is switched off (no profiles loaded; older Sentora installers switched it off): systemctl enable --now apparmor"
    else
        ok "AppArmor is on ($AA_ENF profiles in enforce mode)"
        # every running service a profile confines, once (the panel's own processes are not confined)
        AA_RUN=$(for d in /proc/[0-9]*; do
            c=$(cat "$d/attr/current" 2> /dev/null | tr -d '\0'); [ -n "$c" ] && [ "$c" != unconfined ] || continue
            echo "$(cat "$d/comm" 2> /dev/null)|$c"
        done | sort -u)
        AA_PROFS=""
        while IFS='|' read -r prog prof; do
            [ -n "$prog" ] || continue
            AA_PROFS="$AA_PROFS ${prof% (*}"
            case "$prof" in
                *"(enforce)") ok "$prog runs confined by its profile ($prof)" ;;
                *"(complain)") warn "$prog is only watched by its profile ($prof), not confined: aa-enforce ${prof% (complain)}" ;;
            esac
        done <<< "$AA_RUN"
        # what AppArmor refused those programs since the start (other programs' refusals are the system's own)
        AA_DEN=0
        for p in $(printf '%s\n' $AA_PROFS | sort -u); do
            n=$(journalctl -k -b --no-pager 2> /dev/null | grep 'apparmor="DENIED"' | grep -cF "profile=\"$p\"")
            AA_DEN=$((AA_DEN + ${n:-0}))
        done
        if [ "$AA_DEN" -gt 0 ]; then warn "AppArmor refused these services something $AA_DEN time(s) since the start (journalctl -k -b | grep 'apparmor=\"DENIED\"')"
        else ok "AppArmor refused these services nothing since the start"; fi
    fi
else
    warn "neither SELinux nor AppArmor runs on this system (inside WSL there is none), so programs are limited only by their users"
fi

section "Hosted sites may use only their own PHP"
VH=/etc/sentora/configs/apache/httpd-vhosts.conf
if $(sp apache_modules_cmd) 2> /dev/null | grep -q lua_module && grep -q "LuaHookFixups" "$VH" 2> /dev/null && grep -q "SENTORA_STATUS_BLOCK" "$VH" 2> /dev/null; then ok "Apache request guard in place (sentora-guard.lua)"
else fail "Apache request guard missing: a site's .htaccess could hand requests to the panel's PHP (the daemon adds it within 5 minutes)"; fi
PANELPOOL=${PHP_FPM_DIR%/}/sentora.conf
if [ -n "$PANELPOOL" ] && grep -q "auto_prepend_file.*fpm_guard.php" "$PANELPOOL"; then ok "the panel's PHP pool runs only the panel's own scripts"
else fail "the panel's PHP pool has no guard (the daemon adds it within 5 minutes)"; fi

# --- 4. sensitive files -----------------------------------------------------------
section "File permissions"
perm() { # path mode owner group
    [ -e "$1" ] || { warn "$1 not found"; return; }
    local got; got=$(stat -c '%a %U %G' "$1")
    if [ "$got" = "$2 $3 $4" ]; then ok "$1 ($2 $3:$4)"; else fail "$1 is $got, expected $2 $3:$4"; fi
}
perm "$PANEL/cnf/db.php" 640 root sentora
perm "$PANEL/cnf/security.php" 640 root sentora
perm /root/passwords.txt 600 root root
perm "$CONF/proftpd/proftpd-mysql.conf" 600 root root
perm "$CONF/dovecot2/dovecot-mysql.conf" 640 root mail
perm "$CONF/phpmyadmin/config.inc.php" 640 root sentora
for f in "$CONF"/postfix/mysql-*.cf; do [ -e "$f" ] && perm "$f" 640 root postfix; done
for f in "$CONF"/roundcube/*.inc.php; do [ -e "$f" ] && perm "$f" 640 root sentora; done
SOGO_CONF=$(sp sogo_conf); [ -e "$SOGO_CONF" ] && perm "$SOGO_CONF" 640 root "$(sp sogo_user)"
MCFG=$PANEL/etc/apps/matomo/config/config.ini.php
if [ -e "$MCFG" ]; then
    # Matomo may rewrite its own config: what matters is that only the panel can reach it
    if [ $(( 8#$(stat -c '%a' "$MCFG") & 7 )) -eq 0 ] || [ $(( 8#$(stat -c '%a' "$(dirname "$MCFG")") & 1 )) -eq 0 ]; then ok "$MCFG (only the panel can read it)"
    else fail "$MCFG can be read by every user"; fi
fi
# zsudo: the panel's fixed list of root actions; not set-uid, root runs what it queues (sentora-zsudo-setup)
if [ -u "$PANEL/bin/zsudo" ]; then
    warn "zsudo is still the older set-uid kind (handing jobs to at, which SELinux refuses to the panel): run sentora-update"
else
    perm "$PANEL/bin/zsudo" 750 root sentora
    if systemctl is-active --quiet sentora-zsudo.path 2> /dev/null; then ok "the queue of root actions is watched (sentora-zsudo.path)"
    else fail "sentora-zsudo.path does not run: the panel's root actions (Panel Update, Apache and BIND reloads) wait (bash $PANEL/bin/sentora-zsudo-setup)"; fi
    q=$(stat -c '%a %U' /var/lib/sentora/zsudo/queue 2> /dev/null)
    if [ "$q" = "700 sentora" ]; then ok "the queue is the panel's alone (700 sentora)"
    else fail "/var/lib/sentora/zsudo/queue is ${q:-missing}, expected 700 sentora (bash $PANEL/bin/sentora-zsudo-setup)"; fi
fi
NAMED_CONF="$(sp bind_dir)"; NAMED_CONF="${NAMED_CONF%/}/named.conf"; BIND_GROUP=$(sp bind_group)
if [ -e "$NAMED_CONF" ]; then
    got=$(stat -c '%a %U %G' "$NAMED_CONF")
    if [ "$got" = "640 root $BIND_GROUP" ]; then ok "$NAMED_CONF (640 root:$BIND_GROUP, it holds BIND's control key)"
    else fail "$NAMED_CONF is $got, expected 640 root:$BIND_GROUP (the daemon closes it within 5 minutes)"; fi
fi
for b in sentora-notice sentora-update sentora-post-install-check; do
    if [ -x "$PANEL/bin/$b" ]; then ok "$b can be run"; else fail "$PANEL/bin/$b is not executable (chmod 755 it)"; fi
done
perm /var/lib/sentora/phpmyadmin-auth.log 640 sentora sentora
# root jobs write their state there: the folder must be root's, or the panel's user could plant links
perm /var/lib/sentora 755 root root
for d in "$PANEL/etc/tmp" "$PANEL/etc/apps/matomo/tmp" "$PANEL/etc/apps/matomo/config"; do
    [ -d "$d" ] || continue
    m=$(stat -c '%a' "$d")
    if [ $((8#$m & 7)) -eq 0 ]; then ok "$d closed to the sites ($m)"; else fail "$d is open to other users ($m); the daemon closes it within 5 minutes"; fi
done
# the web service API key: this server's own (the template's is public: with it the API
# resets passwords and creates clients)
APIKEY=$(q "SELECT so_value_tx FROM sentora_core.x_settings WHERE so_name_vc='apikey'")
if [ "${#APIKEY}" -ge 32 ] && [ "$APIKEY" != "ee8795c8c53bfdb3b2cc595186b68912" ]; then ok "the web service API key is this server's own"
else fail "the web service API key is the public default (or too short): the daemon replaces it within 5 minutes"; fi
# FollowSymLinks switched on for moving an old site (Apache Admin): fine for the move, not to keep
SYML=$(q "SELECT GROUP_CONCAT(vh_name_vc SEPARATOR ', ') FROM sentora_core.x_vhosts WHERE vh_deleted_ts IS NULL AND vh_symlinks_in = 1" 2> /dev/null)
if [ -n "$SYML" ] && [ "$SYML" != "NULL" ]; then warn "FollowSymLinks is switched on for: $SYML (Apache Admin; switch it off once the site is moved)"
else ok "FollowSymLinks is off for every website"; fi
# all of /etc/sentora (configuration, DNS zones, Apache's site settings) and /var/sentora,
# except the hosting folders, the mail store and the two shared scratch folders
ww=$(find /etc/sentora /var/sentora -xdev \( -path /var/sentora/hostdata -o -path /var/sentora/vmail -o -path /var/sentora/temp -o -path /var/sentora/sessions \) -prune \
    -o -perm -o+w ! -type l -print 2> /dev/null | head -5)
if [ -z "$ww" ]; then ok "nothing in /etc/sentora or /var/sentora is writable by everyone"
else fail "writable by everyone (any hosted site could change it): $(echo "$ww" | tr '\n' ' ') (the daemon closes these within 5 minutes)"; fi

# --- 5. hosting accounts -----------------------------------------------------------
section "Hosting accounts (own Linux user, PHP pool and closed folder)"
if [ $DB -eq 1 ]; then
    HOSTED=$(q "SELECT so_value_tx FROM sentora_core.x_settings WHERE so_name_vc='hosted_dir'")
    accounts=$(q "SELECT ac_id_pk, ac_user_vc FROM sentora_core.x_accounts WHERE ac_deleted_ts IS NULL")
    first=""; second=""
    while read -r id name; do
        [ -n "$id" ] || continue
        u="web$id"; home="${HOSTED%/}/$name"
        [ -d "$home" ] || { warn "$name: no hosting folder yet"; continue; }
        problems=""
        id "$u" > /dev/null 2>&1 || problems="$problems, no Linux user $u"
        [ -f "${PHP_FPM_DIR%/}/$u.conf" ] || problems="$problems, no PHP pool"
        [ -S "$PHP_SOCK_DIR/$u.sock" ] || problems="$problems, no PHP socket"
        [ "$(stat -c '%U' "$home")" = "$u" ] || problems="$problems, folder not owned by $u"
        [ $(( 8#$(stat -c '%a' "$home") & 7 )) -eq 0 ] || problems="$problems, folder open to others"
        if command -v getfacl > /dev/null && ! getfacl -p "$home" 2> /dev/null | grep -q '^other::---'; then problems="$problems, access list lets others in"; fi
        if [ -z "$problems" ]; then ok "$name ($u)"; else fail "$name:${problems#,}"; fi
        if [ -z "$first" ]; then first="$u $home"; elif [ -z "$second" ]; then second="$u $home"; fi
    done <<< "$accounts"
    # as each account's own user (setpriv: no login session needed): its own folder
    # must open (otherwise the test proves nothing) and the other account's must not
    as_user() { setpriv --reuid="$1" --regid="$(id -g "$1")" --init-groups ls "$2" > /dev/null 2>&1; }
    if ! command -v setpriv > /dev/null; then
        warn "isolation not tested: setpriv not found"
    elif [ -z "$second" ]; then
        warn "isolation not tested: it needs two accounts with hosting folders"
    else
        read -r ua ha <<< "$first"; read -r ub hb <<< "$second"
        if ! as_user "$ua" "$ha" || ! as_user "$ub" "$hb"; then
            warn "isolation not tested: an account user could not open its own folder"
        else
            if as_user "$ua" "$hb"; then fail "isolation: $ua can read $hb"; else ok "isolation: $ua can open its own folder and not $hb"; fi
            if as_user "$ub" "$ha"; then fail "isolation: $ub can read $ha"; else ok "isolation: $ub can open its own folder and not $ha"; fi
        fi
    fi
else
    fail "could not log in to MySQL with the panel's settings ($DBPHP): accounts and passwords not checked"
fi

# --- 6. stored passwords ------------------------------------------------------------
section "Stored passwords"
if [ $DB -eq 1 ]; then
    FTPDB=$(q "SELECT so_value_tx FROM sentora_core.x_settings WHERE so_name_vc='ftp_db'"); FTPDB=${FTPDB:-sentora_proftpd}
    n=$(q "SELECT COUNT(*) FROM sentora_core.x_ftpaccounts WHERE ft_deleted_ts IS NULL AND IFNULL(ft_password_vc,'') <> '' AND ft_password_vc NOT LIKE '\$6\$%'")
    m=$(q "SELECT COUNT(*) FROM \`$FTPDB\`.ftpuser WHERE passwd <> '' AND passwd NOT LIKE '\$6\$%'")
    if [ "${n:-0}" = 0 ] && [ "${m:-0}" = 0 ]; then ok "FTP: hashes only"; else fail "FTP: $((${n:-0} + ${m:-0})) password(s) stored as plain text (the daemon hashes them within 5 minutes)"; fi
    n=$(q "SELECT COUNT(*) FROM sentora_core.x_mysql_users WHERE IFNULL(mu_pass_vc,'') <> '' AND mu_pass_vc NOT LIKE 'enc1:%'")
    if [ "${n:-0}" = 0 ]; then ok "MySQL users: passwords kept encrypted only"; else fail "MySQL users: $n password(s) stored as plain text (the daemon encrypts them within 5 minutes)"; fi
    n=$(q "SELECT COUNT(*) FROM sentora_core.x_ftpaccounts WHERE IFNULL(ft_passenc_tx,'') <> '' AND ft_passenc_tx NOT LIKE 'enc1:%'")
    if [ "${n:-0}" = 0 ]; then ok "FTP: the copies owners can see are encrypted"; else fail "FTP: $n viewable password(s) not encrypted"; fi
    if q "SHOW COLUMNS FROM sentora_core.x_mailboxes LIKE 'mb_passenc_tx'" | grep -q .; then
        n=$(q "SELECT COUNT(*) FROM sentora_core.x_mailboxes WHERE mb_passenc_tx IS NOT NULL")
        if [ "${n:-0}" = 0 ]; then ok "mailboxes: no copies of mailbox passwords kept"; else fail "mailboxes: $n copies of mailbox passwords kept (the daemon removes them within 5 minutes)"; fi
    else
        ok "mailboxes: no copies of mailbox passwords kept"
    fi
    md5=$(q "SELECT COUNT(*) FROM sentora_postfix.mailbox WHERE password LIKE '{PLAIN-MD5}%'")
    sha=$(q "SELECT COUNT(*) FROM sentora_postfix.mailbox WHERE password LIKE '{SHA512-CRYPT}%'")
    other=$(q "SELECT COUNT(*) FROM sentora_postfix.mailbox WHERE password NOT LIKE '{PLAIN-MD5}%' AND password NOT LIKE '{SHA512-CRYPT}%'")
    if [ "${other:-0}" != 0 ]; then fail "mailboxes: $other password(s) in an unknown format"; fi
    if [ "${md5:-0}" = 0 ]; then ok "mailboxes: ${sha:-0} on SHA-512 crypt, none on MD5"
    else warn "mailboxes: $md5 still on MD5 (they move to SHA-512 crypt when their password next changes; listed in PHP Versions > Older logins), ${sha:-0} on SHA-512 crypt"; fi
    # MySQL's older login method (mysql_native_password, SHA-1): kept for moved sites on PHP 7.1 only
    if ! q "SELECT VERSION()" | grep -qi mariadb; then
        nat=$(q "SELECT PLUGIN_STATUS FROM information_schema.PLUGINS WHERE PLUGIN_NAME = 'mysql_native_password'")
        natn=$(q "SELECT COUNT(*) FROM mysql.user WHERE plugin = 'mysql_native_password' AND User NOT LIKE 'mysql.%'")
        if [ "$nat" != "ACTIVE" ]; then ok "MySQL: the older login method (mysql_native_password) is off"
        elif [ "${natn:-0}" = 0 ]; then warn "MySQL: the older login method is on, and no user needs it: switch it off (PHP Versions > Older logins)"
        else warn "MySQL: the older login method is on for $natn user(s) of sites on PHP 7.1 (PHP Versions > Older logins: retire it once they run on PHP 8)"; fi
    fi
    if q "SHOW CREATE VIEW sentora_postfix.sogo_users" | grep -qi "case"; then ok "SOGo mailbox view reads SHA-512 crypt"
    elif [ -x "$(sp sogo_bin)" ]; then fail "SOGo mailbox view is the old one (the daemon updates it within 5 minutes)"; fi
fi
grep -qE '^SQLAuthTypes[[:space:]]+Crypt[[:space:]]*$' "$CONF/proftpd/proftpd-mysql.conf" 2> /dev/null && ok "ProFTPD accepts hashes only" || fail "ProFTPD still accepts plain-text passwords (SQLAuthTypes)"
grep -q "password_algorithm'\] = 'sha512-crypt'" "$CONF/roundcube/password_config.inc.php" 2> /dev/null && ok "Roundcube password change uses SHA-512 crypt" || fail "Roundcube password change does not use SHA-512 crypt"

# --- 7. TLS -----------------------------------------------------------------------
section "TLS"
tls() { # label port extra-options expect(ok|refused)
    local out; out=$(echo | timeout 10 openssl s_client -connect "127.0.0.1:$2" $3 2>&1)
    if echo "$out" | grep -q "Cipher is [A-Z0-9]" && ! echo "$out" | grep -q "Cipher is (NONE)"; then
        [ "$4" = ok ] && ok "$1" || fail "$1: accepted"
    else
        [ "$4" = refused ] && ok "$1" || fail "$1: refused"
    fi
}
tls "HTTPS: modern connection" 443 "" ok
tls "HTTPS: TLS 1.1 refused" 443 "-tls1_1" refused
tls "HTTPS: old CBC cipher refused" 443 "-tls1_2 -cipher AES128-SHA" refused
tls "SMTPS (465): anonymous cipher refused" 465 "-tls1_2 -cipher ADH-AES128-SHA:AECDH-AES128-SHA:@SECLEVEL=0" refused
tls "IMAPS (993): old CBC cipher refused" 993 "-tls1_2 -cipher ECDHE-RSA-AES128-SHA" refused
tls "IMAPS (993): TLS 1.1 refused" 993 "-tls1_1" refused
tls "POP3S (995): TLS 1.1 refused" 995 "-tls1_1" refused
tls "SMTP submission (587): TLS 1.1 refused" 587 "-starttls smtp -tls1_1" refused
tls "FTP (21, explicit TLS): TLS 1.1 refused" 21 "-starttls ftp -tls1_1" refused
CERT=$CONF/ssl/sentora.crt
if [ -f "$CERT" ]; then
    end=$(openssl x509 -in "$CERT" -noout -enddate 2> /dev/null | cut -d= -f2)
    left=$(( ( $(date -d "$end" +%s 2> /dev/null || echo 0) - $(date +%s) ) / 86400 ))
    if [ "$left" -lt 0 ]; then fail "the panel's certificate has expired ($end)"
    elif [ "$left" -lt 14 ]; then fail "the panel's certificate expires in $left day(s) ($end)"
    elif [ "$left" -lt 30 ]; then warn "the panel's certificate expires in $left days ($end)"
    else ok "the panel's certificate is valid for $left more days"; fi
    issuer=$(openssl x509 -in "$CERT" -noout -issuer 2> /dev/null); subject=$(openssl x509 -in "$CERT" -noout -subject 2> /dev/null)
    if [ "${issuer#issuer=}" = "${subject#subject=}" ]; then warn "the certificate is self-signed: issue a Let's Encrypt one with Sencrypt once the name is in public DNS"
    else ok "certificate issued by ${issuer#issuer=}"; fi
fi

# --- 7b. system hardening (ideas from Lynis, only what a hosting server needs) -------
section "System hardening (SSH, kernel, accounts, firewall, time)"
if command -v sshd > /dev/null 2>&1 && SSHT=$(sshd -T 2> /dev/null) && [ -n "$SSHT" ]; then
    sv() { echo "$SSHT" | awk -v k="$1" '$1 == k {print $2; exit}'; }
    [ "$(sv permitemptypasswords)" = no ] && ok "SSH: no logins with an empty password" || fail "SSH allows empty passwords (PermitEmptyPasswords no in /etc/ssh/sshd_config)"
    case "$(sv permitrootlogin)" in
        no) ok "SSH: root may not log in" ;;
        prohibit-password|without-password|forced-commands-only) ok "SSH: root only with a key" ;;
        *) warn "SSH: root may log in with a password (keys are safer: PermitRootLogin prohibit-password, after adding your key)" ;;
    esac
    [ "$(sv passwordauthentication)" = no ] && ok "SSH: keys only, no passwords" \
        || warn "SSH: logins with passwords are allowed (fail2ban limits guessing; keys are safer: PasswordAuthentication no)"
    [ "$(sv x11forwarding)" = yes ] && warn "SSH: X11 forwarding is on (a server does not need it: X11Forwarding no)" || ok "SSH: X11 forwarding off"
    t=$(sv maxauthtries); [ -n "$t" ] && [ "$t" -le 6 ] && ok "SSH: at most $t password tries per connection" || warn "SSH: ${t:-?} password tries per connection (MaxAuthTries 4)"
else
    warn "SSH's settings could not be read (sshd -T)"
fi
# the kernel's own safety switches (sysctl); in a container some come from the host
KMISS=""
kchk() { # name wanted(=N or >=N)
    local v; v=$(cat "/proc/sys/${1//.//}" 2> /dev/null | awk '{print $1}')
    [ -n "$v" ] || return 0
    case "$2" in
        '>='*) [ "$v" -ge "${2#>=}" ] || KMISS="$KMISS $1=$v" ;;
        *) [ "$v" = "$2" ] || KMISS="$KMISS $1=$v" ;;
    esac
}
kchk kernel.randomize_va_space 2; kchk kernel.kptr_restrict '>=1'; kchk kernel.dmesg_restrict 1
kchk fs.protected_hardlinks 1; kchk fs.protected_symlinks 1; kchk fs.protected_fifos '>=1'; kchk fs.protected_regular '>=1'; kchk fs.suid_dumpable 0
kchk net.ipv4.tcp_syncookies 1; kchk net.ipv4.conf.all.accept_redirects 0; kchk net.ipv4.conf.all.send_redirects 0
kchk net.ipv4.conf.all.accept_source_route 0; kchk net.ipv6.conf.all.accept_redirects 0
if [ -z "$KMISS" ]; then ok "the kernel's safety switches are set (address randomisation, protected links, SYN cookies, no redirects)"
else warn "kernel safety switches not set:$KMISS (put the wanted values in /etc/sysctl.d/90-hardening.conf, then: sysctl --system)"; fi
# accounts
x=$(awk -F: '$3 == 0 && $1 != "root" {print $1}' /etc/passwd | tr '\n' ' ')
[ -z "$x" ] && ok "only root has user id 0" || fail "other accounts with root's user id 0: $x"
x=$(awk -F: '($2 == "") {print $1}' /etc/shadow 2> /dev/null | tr '\n' ' ')
[ -z "$x" ] && ok "no account without a password" || fail "accounts with an empty password (anyone can log in as them): $x"
# a firewall (fail2ban bans addresses; a firewall closes everything nothing should reach)
if { command -v firewall-cmd > /dev/null 2>&1 && firewall-cmd --state 2> /dev/null | grep -qx running; } \
        || { command -v ufw > /dev/null 2>&1 && ufw status 2> /dev/null | grep -q '^Status: active'; } \
        || { command -v nft > /dev/null 2>&1 && nft list ruleset 2> /dev/null | grep -qE 'hook input.*policy drop'; }; then
    ok "a firewall is active"
else
    warn "no firewall is active: fail2ban bans addresses that keep failing, but every other open port stays open (allow only Sentora's ports in firewalld, ufw or nftables)"
fi
# the clock (certificates, logs and two-factor codes need it right)
if command -v timedatectl > /dev/null 2>&1; then
    [ "$(timedatectl show -p NTPSynchronized --value 2> /dev/null)" = yes ] && ok "the clock is synchronised" || warn "the clock is not synchronised (timedatectl: check chrony or systemd-timesyncd)"
fi
# a newer kernel installed than the one running: its fixes start with a restart
newest=$(ls -1 /lib/modules 2> /dev/null | sort -V | tail -1)
if [ -n "$newest" ] && [ "$newest" != "$(uname -r)" ] && [ -d "/lib/modules/$(uname -r)" ]; then
    warn "a newer kernel is installed ($newest, running $(uname -r)): restart the server when you can"
else
    ok "the running kernel is the newest installed"
fi

section "Service hardening (web, mail, DNS, database)"
hdr=$(curl -s -m 10 -I http://127.0.0.1/ 2> /dev/null | tr -d '\r')
srv=$(echo "$hdr" | awk -F': ' 'tolower($1) == "server" {print $2; exit}')
if [ -z "$hdr" ]; then warn "Apache did not answer on http://127.0.0.1/"
elif echo "$srv" | grep -q '[0-9]'; then warn "Apache tells its version to everyone ($srv): ServerTokens Prod"
else ok "Apache does not tell its version"; fi
# TRACE is a risk only when Apache echoes the request back (a refusal or a redirect echoes nothing)
TR=$(curl -s -m 10 -X TRACE -H 'X-Sentora-Trace: echo-test' -w '\n%{http_code}' http://127.0.0.1/ 2> /dev/null)
code=$(printf '%s' "$TR" | tail -1)
if [ "$code" = 000 ] || [ -z "$code" ]; then :
elif [ "$code" = 200 ] && printf '%s' "$TR" | grep -qi 'X-Sentora-Trace: echo-test'; then warn "TRACE requests are echoed back: TraceEnable Off in Apache's settings"
else ok "TRACE requests are not echoed ($code)"; fi
phdr=$(curl -sk -m 10 -I https://127.0.0.1/ 2> /dev/null)
if [ -z "$phdr" ]; then :
elif echo "$phdr" | grep -qi '^x-powered-by:.*php'; then warn "the panel tells its PHP version (X-Powered-By): expose_php = Off"
else ok "no PHP version in the panel's answers"; fi
if command -v postconf > /dev/null 2>&1; then
    rr="$(postconf -h smtpd_relay_restrictions 2> /dev/null) $(postconf -h smtpd_recipient_restrictions 2> /dev/null)"
    echo "$rr" | grep -q reject_unauth_destination && ok "mail: not an open relay (reject_unauth_destination)" || fail "mail: no reject_unauth_destination: this server may relay mail for anyone"
    mn=$(postconf -h mynetworks 2> /dev/null)
    if echo "$mn" | grep -qE '(^|[ ,])0\.0\.0\.0/0|/[0-7]([ ,]|$)|/1[0-5]([ ,]|$)'; then fail "mail: mynetworks trusts a wide network ($mn): only this server should be in it"
    else ok "mail: only this server may send without logging in"; fi
    [ "$(postconf -h disable_vrfy_command 2> /dev/null)" = yes ] && ok "mail: VRFY off (addresses can not be probed)" || warn "mail: VRFY is on (disable_vrfy_command = yes)"
    postconf -h smtpd_banner 2> /dev/null | grep -qE 'mail_version|Postfix [0-9]' && warn "mail: the banner tells Postfix's version" || ok "mail: the banner does not tell the version"
    # every table type main.cf names must be one this Postfix can read (AlmaLinux 10 and Fedora have no hash or btree)
    PF_TYPES=" $(postconf -m 2> /dev/null | tr '\n' ' ')"
    PF_BAD=$(postconf -n 2> /dev/null | grep -oE '(^|[ ,=])(hash|btree|dbm|sdbm|lmdb|cdb):' | grep -oE '[a-z]+' | sort -u | while read -r t; do case "$PF_TYPES" in *" $t "*) ;; *) printf ' %s' "$t" ;; esac; done)
    if [ -n "$PF_BAD" ]; then fail "mail: main.cf names table types this Postfix can not read:$PF_BAD (the daemon moves them to $(postconf -h default_database_type 2> /dev/null); run it: php -q $PANEL/bin/daemon.php)"
    else ok "mail: Postfix can read every table type main.cf names"; fi
fi
NC=$(sp bind_dir); NC="${NC%/}/named.conf"
if [ -f "$NC" ]; then
    if command -v named-checkconf > /dev/null 2>&1 && named-checkconf -p "$NC" 2> /dev/null | grep -qE 'allow-recursion[^;]*\{[^}]*\bany\b'; then fail "DNS: BIND answers recursive questions for anyone (an open resolver, used for attacks)"
    else ok "DNS: not an open resolver"; fi
fi
if [ $DB -eq 1 ]; then
    a=$(q "SELECT COUNT(*) FROM mysql.user WHERE user = ''")
    [ -n "$a" ] && { [ "$a" = 0 ] && ok "database: no anonymous users" || fail "database: $a anonymous user(s) (DROP USER ''@'host')"; }
    r=$(q "SELECT GROUP_CONCAT(host) FROM mysql.user WHERE user = 'root' AND host NOT IN ('localhost', '127.0.0.1', '::1')")
    [ -n "$a" ] && { [ -z "$r" ] || [ "$r" = NULL ] && ok "database: root only from this server" || fail "database: root may log in from $r"; }
fi

# --- 8. automatic security updates --------------------------------------------------
section "Automatic security updates"
if command -v dpkg > /dev/null 2>&1 && dpkg -l unattended-upgrades 2> /dev/null | grep -q '^ii'; then
    if [ "$(apt-config shell X APT::Periodic::Unattended-Upgrade | cut -d"'" -f2)" = "1" ]; then ok "unattended-upgrades is on"
    else fail "unattended-upgrades is installed but switched off (/etc/apt/apt.conf.d/20auto-upgrades)"; fi
    if [ $SYSTEMD -eq 1 ]; then
        systemctl is-active --quiet apt-daily-upgrade.timer && ok "the daily upgrade timer is active" || fail "apt-daily-upgrade.timer is not active (systemctl enable --now apt-daily-upgrade.timer)"
    fi
    UL=/var/log/unattended-upgrades/unattended-upgrades.log
    if [ -f "$UL" ]; then
        days=$(( ($(date +%s) - $(stat -c %Y "$UL")) / 86400 ))
        [ $days -le 3 ] && ok "last automatic update run $days day(s) ago" || warn "no automatic update run for $days days (see $UL)"
    else
        warn "unattended-upgrades has not run yet (it runs once a day)"
    fi
    [ -f /var/run/reboot-required ] && warn "a restart is needed to finish updates ($(tr '\n' ' ' < /var/run/reboot-required.pkgs 2> /dev/null | cut -c1-80))"
elif DA_PKG=$(sp dnf_automatic_package); DA_TIMER=$(sp dnf_automatic_timer); DA_PKG=${DA_PKG:-dnf-automatic}; DA_TIMER=${DA_TIMER:-dnf-automatic.timer}
        command -v dnf > /dev/null 2>&1 && rpm -q "$DA_PKG" > /dev/null 2>&1; then
    # dnf's automatic updates (the Red Hat-family systems; package and timer from the settings)
    if grep -Eq '^\s*apply_updates\s*=\s*(yes|true|1)' /etc/dnf/automatic.conf 2> /dev/null; then ok "dnf automatic updates install updates ($DA_PKG)"
    else fail "$DA_PKG is installed but does not install updates (apply_updates in /etc/dnf/automatic.conf)"; fi
    if [ $SYSTEMD -eq 1 ]; then
        systemctl is-active --quiet "$DA_TIMER" && ok "the daily update timer is active" || fail "$DA_TIMER is not active (systemctl enable --now $DA_TIMER)"
    fi
    [ -n "$(systemctl show -p LastTriggerUSec --value "$DA_TIMER" 2> /dev/null | grep -v '^n/a$')" ] || warn "the automatic updates have not run yet (they run once a day)"
else
    fail "no automatic security updates are installed (unattended-upgrades or dnf-automatic): security updates are not installed automatically"
fi

# --- 9. alerts -----------------------------------------------------------------------
section "Server alerts"
if [ $DB -eq 1 ]; then
    to=$(q "SELECT so_value_tx FROM sentora_core.x_settings WHERE so_name_vc='alert_email'")
    [ -z "$to" ] && to=$(q "SELECT ac_email_vc FROM sentora_core.x_accounts WHERE ac_id_pk=1")
    if echo "$to" | grep -qE '^[^@ ]+@[^@ ]+\.[^@ ]+$'; then ok "alerts go to $to"
    else warn "alerts have nowhere to go: set Alert email address in Admin > Sentora Config"; fi
    [ -f /var/sentora/logs/alerts.log ] && [ -s /var/lib/sentora/alerts.json ] && grep -q '"msg"' /var/lib/sentora/alerts.json && warn "open alerts: $(grep -o '"msg":"[^"]*"' /var/lib/sentora/alerts.json | cut -d'"' -f4 | head -3 | tr '\n' ' ')"
fi

section "Off-server backup"
if [ $DB -eq 1 ] && [ "$(q "SELECT so_value_tx FROM sentora_core.x_settings WHERE so_name_vc='offsite_enabled'")" = "true" ]; then
    lastok=$(grep -o '"last_ok":[0-9]*' /var/lib/sentora/offsite-backup.json 2> /dev/null | cut -d: -f2)
    if [ "${lastok:-0}" -gt 0 ]; then
        hours=$(( ($(date +%s) - lastok) / 3600 ))
        [ $hours -le 26 ] && ok "last good copy $hours hour(s) ago" || fail "no good copy for $hours hours (Admin > Backup Config: Test connection)"
    else
        warn "switched on, but no good copy yet (Admin > Backup Config: Test connection, then Back up now)"
    fi
    [ -f /etc/cron.d/sentora-offsite-backup ] && ok "nightly job in place" || fail "the nightly job is missing (the daemon adds it within 5 minutes)"
else
    warn "switched off: backups stay on this server's disk (Admin > Backup Config > Off-server backup)"
fi

# --- 10. the Sentora daemon -----------------------------------------------------------
section "Sentora daemon"
DL=/var/sentora/logs/daemon-last-run.log
# a run that is busy right now is still writing its report: wait for it (up to 2 minutes) before reading it
if [ -f /var/lib/sentora/daemon.lock ] && command -v flock > /dev/null 2>&1 \
        && ! flock -n /var/lib/sentora/daemon.lock true 2> /dev/null; then
    echo "  (a daemon run is busy: waiting for it to finish)"
    flock -w 120 /var/lib/sentora/daemon.lock true 2> /dev/null
fi
if [ -f "$DL" ]; then
    age=$(( ($(date +%s) - $(stat -c %Y "$DL")) / 60 ))
    if [ $age -le 15 ]; then ok "last run $age minute(s) ago"; else fail "last run $age minutes ago (it runs every 5 minutes: check cron)"; fi
    grep -q "Daemon run complete" "$DL" && ok "the last run completed" || fail "the last run did not complete (see $DL)"
    w=$(grep -cE "PHP (Warning|Fatal|Deprecated|Notice)" "$DL")
    if [ "$w" = 0 ]; then ok "no PHP warnings in the last run"; else fail "$w PHP warning(s) in the last run: $(grep -m1 -E 'PHP (Warning|Fatal|Deprecated|Notice)' "$DL" | cut -c1-150)"; fi
    f=$(grep -cE "(^| )FAILED[:. ]" "$DL")
    if [ "$f" = 0 ]; then ok "no task failed in the last run"; else fail "$f task(s) failed in the last run: $(grep -m1 -E '(^| )FAILED[:. ]' "$DL" | cut -c1-150)"; fi
else
    fail "$DL not found: the daemon has not run yet (wait 5 minutes)"
fi
PL=/var/sentora/logs/sentora-php.log
if [ -s "$PL" ]; then
    n=$(grep -cE "PHP (Warning|Fatal|Deprecated|Notice)" "$PL")
    [ "$n" = 0 ] && ok "panel PHP log: no warnings" || warn "panel PHP log: $n warning(s), latest: $(grep -E 'PHP (Warning|Fatal|Deprecated|Notice)' "$PL" | tail -1 | sed -E 's/^\[[^]]*\] //' | cut -c1-150)"
else
    ok "panel PHP log: empty"
fi

rm -f "$MYCNF"
echo
echo "Result: $OKS OK, $WARNS WARN, $FAILS FAIL"
T=$((OKS + WARNS + FAILS))
[ $T -gt 0 ] && echo "Sentora hardening score: $(( (OKS * 200 + WARNS * 100 + T) / (T * 2) )) / 100 (OK 1 point, WARN half, FAIL none)"
[ $FAILS -eq 0 ] && echo "No failures." || echo "Fix the FAIL lines above; send this report for help."
[ $FAILS -eq 0 ]
}

main 2>&1 | tee "$LOG"
RC=${PIPESTATUS[0]}
# the report for the panel: written whole, then put in place (root:<panel user> 640)
if [ -n "$JSON" ] && [ "$RC" != 2 ]; then
    php -r '
        $rows = array(); $n = array("ok" => 0, "warn" => 0, "fail" => 0);
        foreach (file($argv[1], FILE_IGNORE_NEW_LINES) as $l) {
            $p = explode("\t", $l, 3);
            if (count($p) === 3 && isset($n[$p[0]])) { $n[$p[0]]++; $rows[] = array("status" => $p[0], "section" => $p[1], "text" => $p[2]); }
        }
        $t = array_sum($n);
        echo json_encode(array("time" => time(), "score" => $t ? (int) round(100 * ($n["ok"] + $n["warn"] / 2) / $t) : 0,
            "ok" => $n["ok"], "warn" => $n["warn"], "fail" => $n["fail"], "checks" => $rows), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
    ' "$REC" > "$JSON.new" 2> /dev/null && chown root:sentora "$JSON.new" && chmod 640 "$JSON.new" && mv -f "$JSON.new" "$JSON"
    rm -f "$JSON.new"
    # its history for the score-over-time graph: the last 90 results (time, score, counts)
    HIST="${JSON%.json}-history.json"
    php -r '
        $h = @json_decode((string) @file_get_contents($argv[1]), true); $h = is_array($h) ? $h : array();
        $r = @json_decode((string) @file_get_contents($argv[2]), true);
        if (is_array($r) && isset($r["score"])) { $h[] = array("time" => $r["time"], "score" => $r["score"], "ok" => $r["ok"], "warn" => $r["warn"], "fail" => $r["fail"]); }
        echo json_encode(array_slice($h, -90));
    ' "$HIST" "$JSON" > "$HIST.new" 2> /dev/null && chown root:sentora "$HIST.new" && chmod 640 "$HIST.new" && mv -f "$HIST.new" "$HIST"
    rm -f "$HIST.new"
fi
exit "$RC"
