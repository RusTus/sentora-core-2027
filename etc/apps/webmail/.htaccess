# Roundcube 1.7 is served only from public_html. Every request for the webmail
# folder is mapped into it, so config, logs, vendor and the other folders here
# can never be fetched directly.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_URI} !/public_html/
RewriteRule ^(.*)$ public_html/$1 [L]
</IfModule>
<IfModule !mod_rewrite.c>
Require all denied
</IfModule>
