<?php
/*
 * Modern: the login page (also the forgotten-password and reset-password forms), in the panel's look
 * (dryden/ui/loginpage.class.php gives every page before login the same frame). Included by
 * ctrl_auth::RequireUser(). The field names are the ones inc/init.inc.php reads.
 */
$mlH = function ($s) { return htmlspecialchars((string) $s, ENT_QUOTES, 'UTF-8'); };
$mlReset = isset($_GET['resetkey']) && ctype_alnum((string) $_GET['resetkey']);
ui_loginpage::Open($mlReset ? 'Set a new password' : 'Log in');
?>
<div class="ml-body">
<?php
if (isset($_GET['invalidlogin'])) {
    echo ui_loginpage::Message('error', 'The username or password is not right.');
}
if (isset($_GET['loggedout'])) {
    echo ui_loginpage::Message('ok', 'You are logged out.');
}
if (isset($_GET['sessionIssue'])) {
    echo ui_loginpage::Message('error', 'Your session ended: please log in again.');
}
if (isset($_GET['passwordreset'])) {
    echo ui_loginpage::Message('ok', 'Your password has been reset: log in with the new one.');
}
if (isset($_GET['resetfailed'])) {
    echo ui_loginpage::Message('error', 'The password was not reset: the link works once and for one hour, the email address must be the account\'s, and the password needs at least 8 characters. Ask for a new link with "Forgot your password?".');
}
if (!empty($GLOBALS['sentoraForgotSent'])) {
    echo ui_loginpage::Message('info', 'If that email address belongs to an account, a link to reset its password is on its way. It works once, for one hour.');
}
?>
<?php if ($mlReset) { ?>
    <!-- Reset password (from the link in the email) -->
    <form action="?resetkey=<?php echo $mlH($_GET['resetkey']); ?>" method="post" id="frmZConfirm" autocomplete="off">
        <h1>Set a new password</h1>
        <p class="ml-sub">At least 8 characters.</p>
        <div id="msgMatchErr" hidden><?php echo ui_loginpage::Message('error', 'The two passwords are not the same.'); ?></div>
        <label class="ml-field"><span>New password</span><input type="password" id="inputNewPass1" name="inNewPass" minlength="8" autocomplete="new-password" required autofocus></label>
        <label class="ml-field"><span>New password again</span><input type="password" id="inputNewPass2" name="inputNewPass2" minlength="8" autocomplete="new-password" required></label>
        <label class="ml-field"><span>Your account's email address</span><input type="email" name="inConfEmail" autocomplete="email" required></label>
        <?php echo runtime_csfr::Token(); ?>
        <div class="ml-foot"><a href="./">Back to login</a><button type="submit" class="btn btn-primary" name="sublogin2" value="Reset">Set new password</button></div>
    </form>
<?php } else { ?>
    <!-- Login -->
    <form method="post" id="frmZLogin">
        <label class="ml-field"><span>Username</span><input type="text" id="inputUsername" name="inUsername" autocomplete="username" autocapitalize="off" spellcheck="false" required autofocus></label>
        <label class="ml-field"><span>Password</span><input type="password" id="inPassword" name="inPassword" autocomplete="current-password" required></label>
        <label class="ml-check"><input type="checkbox" name="inRemember" value="1"><span><b>Remember me</b><small>Stay logged in on this computer for 30 days.</small></span></label>
        <label class="ml-check"><input type="checkbox" name="inSessionSecurity" checked><span><b>Session security</b><small>Log out if my address or browser changes. Turn off if your connection changes address often.</small></span></label>
        <?php echo runtime_csfr::Token(); ?>
        <div class="ml-foot"><a href="#forgot" id="forgotpw">Forgot your password?</a><button type="submit" class="btn btn-primary" name="sublogin2" value="LogIn">Log in</button></div>
    </form>
    <!-- Forgotten password -->
    <form method="post" id="frmZForgot" hidden>
        <h1>Forgot your password?</h1>
        <p class="ml-sub">Enter your account's email address: a link to set a new password is sent to it.</p>
        <label class="ml-field"><span>Email address</span><input type="email" id="inputEmail" name="inForgotPassword" autocomplete="email" required></label>
        <?php echo runtime_csfr::Token(); ?>
        <div class="ml-foot"><a href="#" id="backtologin">Back to login</a><button type="submit" class="btn btn-primary" name="sublogin2" value="LogIn">Send the link</button></div>
    </form>
<?php } ?>
</div>
<script>
(function () {
    'use strict';
    var login = document.getElementById('frmZLogin'), forgot = document.getElementById('frmZForgot');
    var show = function (f) { if (!login || !forgot) { return; } login.hidden = f; forgot.hidden = !f; (f ? forgot : login).querySelector('input').focus(); };
    var a = document.getElementById('forgotpw'), b = document.getElementById('backtologin');
    if (a) { a.addEventListener('click', function (e) { e.preventDefault(); show(true); }); }
    if (b) { b.addEventListener('click', function (e) { e.preventDefault(); show(false); }); }
    if (location.hash === '#forgot') { show(true); }
    var reset = document.getElementById('frmZConfirm');
    if (reset) {
        // the browser checks it with the other fields (and shows the message under the second one)
        var n1 = document.getElementById('inputNewPass1'), n2 = document.getElementById('inputNewPass2');
        var check = function () {
            var bad = n1.value !== n2.value && n2.value !== '';
            n2.setCustomValidity(bad ? 'The two passwords are not the same.' : '');
            document.getElementById('msgMatchErr').hidden = !bad;
        };
        n1.addEventListener('input', check);
        n2.addEventListener('input', check);
        reset.addEventListener('submit', function (e) { check(); if (!reset.checkValidity()) { e.preventDefault(); } });
    }
})();
</script>
<?php ui_loginpage::Close(); ?>
