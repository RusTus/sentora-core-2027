# Auto detect text files and perform LF normalization
* text=auto

# Not part of the release zips (git archive): GitHub-only files (the workflow, the README and the
# change log, which the release pages show; the panel links to the change log on GitHub), so
# changing them does not change the zip and its SHA-256 (servers would see an update that is none)
/.github export-ignore
/.gitattributes export-ignore
/README.md export-ignore
/CHANGELOG.md export-ignore
/CLAUDE.md export-ignore
